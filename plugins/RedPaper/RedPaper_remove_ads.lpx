#!name=小红书去广告 v1.5.0
#!version=1.5.0
#!desc=过滤信息流推广（直播/赞助/带货/商品五类特征）、移除图片视频实况照片水印、屏蔽点点 AI 与通知引导弹窗（可开关）、搜索域全净（猜你想搜/占位词/热榜）、品牌广告资源拦截、站内推送弹窗与增长行为流清洗。
#!openUrl=https://apps.apple.com/app/id741292507
#!author=@Savues <https://github.com/Savues>
#!tag=去广告
#!system=
#!system_version=
#!loon_version=3.5.1(998)
#!homepage=https://github.com/Savues/loon-plugin-patches/tree/main/plugins/RedPaper
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/RedPaper.png
#!date=2026-10-27 01:35:00

[Argument]
removeDianDian = switch, true, false, tag=🤖屏蔽点点AI, desc=屏蔽点点AI助手: askdiandian域名+agentspark/inspiration API+diandian前端+入口开关清洗

[Rule]
AND, ((PROTOCOL, QUIC), (DOMAIN-SUFFIX, xiaohongshu.com)), REJECT

[Rewrite]
# 版本探针 v2 (version-probe.sh 用, 勿删)
request if ${url} ~= /^https?:\/\/ci\.xiaohongshu\.com\/gw\/loon-sim\.probe\.redpaper_remove_ads/i then reject(200, "1.5.0")
request if ${url} ~= /^https:\/\/ci\.xiaohongshu\.com\/system_config\/watermark/i then reject_img(200)

# === 点点 AI / agentspark 全屏蔽 (开关 removeDianDian; v2 条件式 Rewrite) ===
request if ${url} ~= /\/api\/sns\/agentspark\//i && ${removeDianDian} == true then reject_dict(200)
request if ${url} ~= /\/api\/sns\/inspiration\//i && ${removeDianDian} == true then reject_dict(200)
request if ${url} ~= /diandian\.xiaohongshu\.com/i && ${removeDianDian} == true then reject_dict(200)
request if ${url} ~= /^https?:\/\/(?:www\.)?askdiandian\.com\//i && ${removeDianDian} == true then reject_dict(200)

request if ${url} ~= /^https:\/\/edith\.xiaohongshu\.com\/api\/sns\/v1\/surprisebox\/(?:get_style|open|submit_action)/i then reject_dict(200)
request if ${url} ~= /^https:\/\/www\.xiaohongshu\.com\/api\/marketing\/box\/trigger\?/i then reject_dict(200)

request if ${url} ~= /^https:\/\/edith\.xiaohongshu\.com\/api\/sns\/(?:v2\/guide\/user_banner|v3\/note\/guide)/i then reject_dict(200)
request if ${url} ~= /^https:\/\/(?:www|edith)\.xiaohongshu\.com\/api\/sns\/(?:v1\/ads\/resource|v2\/hey\/\w+\/hey_gallery)/i then reject_dict(200)

response if ${url} ~= /^https:\/\/edith\.xiaohongshu\.com\/api\/sns\/v1\/search\/banner_list$/i then response.json.delete("data")
response if ${url} ~= /^https:\/\/edith\.xiaohongshu\.com\/api\/sns\/v1\/search\/hot_list$/i then response.json.delete("data.items")
response if ${url} ~= /^https:\/\/edith\.xiaohongshu\.com\/api\/sns\/v4\/search\/hint/i then response.json.delete("data.hint_words")
response if ${url} ~= /^https:\/\/search\.xiaohongshu\.com\/api\/search\/fls\/placeholder/i then response.json.delete("data.placeholder")
response if ${url} ~= /^https:\/\/edith\.xiaohongshu\.com\/api\/sns\/v4\/search\/trending\?/i then response.json.delete("data")
# 站内推送弹窗权限 (in_app_push.permit_num 控制每日可弹次数)
response if ${url} ~= /^https:\/\/edith\.xiaohongshu\.com\/api\/sns\/v2\/message\/config/i then response.json.delete("data.in_app_push")
# 增长行为流 (behaviorFlowList = "完成X得奖励" 类引导)
response if ${url} ~= /^https:\/\/edith\.xiaohongshu\.com\/api\/usergrowth\/behavior\/getflowlist/i then response.json.delete("data.behaviorFlowList")

[Script]
response if ${url} ~= /^https:\/\/edith\.xiaohongshu\.com\/api\/sns\/v3\/system_service\/flag_exp/i then script("https://raw.githubusercontent.com/Savues/loon-plugin-patches/main/plugins/RedPaper/src/RedPaper_flag_exp.js", {${removeDianDian}}) with requires_body=true, tag="点点入口旗标清洗"

response if ${url} ~= /^https:\/\/edith\.xiaohongshu\.com\/api\/sns\/v1\/system\/switch_config/i then script("https://raw.githubusercontent.com/Savues/loon-plugin-patches/main/plugins/RedPaper/src/RedPaper_switch_config.js") with tag="通知引导弹窗清洗", requires_body=true

response if ${url} ~= /^https:\/\/edith\.xiaohongshu\.com\/api\/sns\/v1\/note\/(?:imagefeed|live_photo\/save)/i then script("https://raw.githubusercontent.com/Savues/loon-plugin-patches/main/plugins/RedPaper/src/RedPaper_remove_ads.js") with tag="移除图片和实况照片水印", requires_body=true

response if ${url} ~= /^https:\/\/edith\.xiaohongshu\.com\/api\/sns\/v1\/system\/service\/ui\/config\?/i then script("https://raw.githubusercontent.com/Savues/loon-plugin-patches/main/plugins/RedPaper/src/RedPaper_remove_ads.js") with tag="移除整体配置 ui", requires_body=true

response if ${url} ~= /^https:\/\/edith\.xiaohongshu\.com\/api\/sns\/v1\/system_service\/config\?/i then script("https://raw.githubusercontent.com/Savues/loon-plugin-patches/main/plugins/RedPaper/src/RedPaper_remove_ads.js") with tag="移除开屏广告 config", requires_body=true

response if ${url} ~= /^https:\/\/edith\.xiaohongshu\.com\/api\/sns\/v2\/system_service\/splash_config/i then script("https://raw.githubusercontent.com/Savues/loon-plugin-patches/main/plugins/RedPaper/src/RedPaper_remove_ads.js") with tag="移除开屏广告 splash_config", requires_body=true

response if ${url} ~= /^https:\/\/edith\.xiaohongshu\.com\/api\/sns\/v2\/(?:note\/widgets|user\/followings\/followfeed)/i then script("https://raw.githubusercontent.com/Savues/loon-plugin-patches/main/plugins/RedPaper/src/RedPaper_remove_ads.js") with tag="移除详情页小部件、关注页感兴趣的人", requires_body=true

response if ${url} ~= /^https:\/\/edith\.xiaohongshu\.com\/api\/sns\/v4\/followfeed\?/i then script("https://raw.githubusercontent.com/Savues/loon-plugin-patches/main/plugins/RedPaper/src/RedPaper_remove_ads.js") with tag="移除信息流广告", requires_body=true

response if ${url} ~= /^https:\/\/edith\.xiaohongshu\.com\/api\/sns\/v5\/recommend\/user\/follow_recommend\?/i then script("https://raw.githubusercontent.com/Savues/loon-plugin-patches/main/plugins/RedPaper/src/RedPaper_remove_ads.js") with tag="移除详情页感兴趣的人", requires_body=true

response if ${url} ~= /^https:\/\/edith\.xiaohongshu\.com\/api\/sns\/(?:v1\/interaction\/comment\/video\/download|v5\/note\/comment\/list)/i then script("https://raw.githubusercontent.com/Savues/loon-plugin-patches/main/plugins/RedPaper/src/RedPaper_remove_ads.js") with tag="移除评论区实况照片水印", requires_body=true

response if ${url} ~= /^https:\/\/edith\.xiaohongshu\.com\/api\/sns\/(?:v2\/note\/feed|v3\/note\/videofeed)/i then script("https://raw.githubusercontent.com/Savues/loon-plugin-patches/main/plugins/RedPaper/src/RedPaper_remove_ads.js") with tag="移除图片和视频水印", requires_body=true

response if ${url} ~= /^https:\/\/(?:edith|rec)\.xiaohongshu\.com\/api\/sns\/v6\/homefeed\?/i then script("https://raw.githubusercontent.com/Savues/loon-plugin-patches/main/plugins/RedPaper/src/RedPaper_remove_ads.js") with tag="移除信息流广告", requires_body=true

response if ${url} ~= /^https:\/\/(?:edith|so)\.xiaohongshu\.com\/api\/sns\/v10\/search\/notes\?/i then script("https://raw.githubusercontent.com/Savues/loon-plugin-patches/main/plugins/RedPaper/src/RedPaper_remove_ads.js") with tag="移除搜索页广告", requires_body=true

response if ${url} ~= /^https:\/\/(?:edith|rec|www)\.xiaohongshu\.com\/api\/sns\/(?:v4\/note\/videofeed|v10\/note\/video\/save)/i then script("https://raw.githubusercontent.com/Savues/loon-plugin-patches/main/plugins/RedPaper/src/RedPaper_remove_ads.js") with tag="移除视频水印", requires_body=true

[MitM]
hostname=ci.xiaohongshu.com, edith.xiaohongshu.com, rec.xiaohongshu.com, so.xiaohongshu.com, www.xiaohongshu.com, search.xiaohongshu.com, fe.xiaohongshu.com, as.xiaohongshu.com, *.askdiandian.com