#!name=Apple 证书吊销检查屏蔽 v1.2
#!desc=屏蔽 OCSP/CRL/证书吊销查询域名，让已过期或已被吊销的证书仍能完成 TLS 握手（侧载/企业证书场景）。不影响加密强度与证书链验证，仅跳过吊销状态检查。
#!author=@Savues <https://github.com/Savues>
#!homepage=https://github.com/Savues/loon-plugin-patches
#!icon=https://raw.githubusercontent.com/Savues/loon-plugin-patches/main/plugins/AntiRevoke/icon.jpg
#!tag=证书,MITM,调试
#!system=iOS, iPadOS, macOS
#!loon_version=3.2.0
#!date=2026-10-24 04:30:00
# ==== PLUGIN_VERSION: 1.2.0 | 上游 Apache-2.0 · 17 条域名与上游完全一致 · 无条件生效 ====
# v1.2.0 变更: 移除 7 个死开关 ([Rule] 段无 enable 字段, 实测开关无效 — loon-sim check + 真机 DNS 实证)
# 风险提示: ppq 屏蔽可能致侧载 App "Unable to Verify App" — 需要停用时请在 Loon 插件页禁用本插件

[Rule]
# ===== Apple OCSP =====
DOMAIN, ocsp.apple.com, REJECT
DOMAIN, ocsp2.apple.com, REJECT
# ===== Apple 证书验证服务器 =====
DOMAIN, valid.apple.com, REJECT
# ===== Apple CRL =====
DOMAIN, crl.apple.com, REJECT
DOMAIN, certs.apple.com, REJECT
# ===== App 验证服务（PPQ）— 高风险: 侧载 App 验证, 见文件头提示 =====
DOMAIN, ppq.apple.com, REJECT
DOMAIN, ppq-ext.v.aaplimg.com, REJECT
# ===== DigiCert =====
DOMAIN, ocsp.digicert.com, REJECT
DOMAIN, ocsp.digicert.cn, REJECT
DOMAIN, crl3.digicert.com, REJECT
DOMAIN, crl4.digicert.com, REJECT
# ===== Entrust =====
DOMAIN, ocsp.entrust.net, REJECT
DOMAIN, crl.entrust.net, REJECT
# ===== Sectigo / USERTrust =====
DOMAIN, ocsp.sectigo.com, REJECT
DOMAIN, crl.sectigo.com, REJECT
DOMAIN, ocsp.usertrust.com, REJECT
DOMAIN, crl.usertrust.com, REJECT
