#!name=GeoFix 网络定位重定向 v1.2 [钉版]
#!desc=[构建 2026-09-28] 重写 Apple 网络定位接口返回的 WiFi/基站定位记录，使 iOS 把设备定位到你指定的坐标。脚本由本仓库托管，上游消失后仍可正常拉取。内置本地解析器与控制页，**不依赖任何外部服务**：浏览器打开 https://map.com 即可。坐标需通过 Bridge 端点写入（见插件 README），插件配置页没有经纬度输入框。只影响网络定位，不修改 GPS 硬件，也不全局改写 CoreLocation。 本仓库: https://github.com/Savues/loon-plugin-patches。
#!author=原作者: 见 UPSTREAM.md | 修改整合: Savues <https://github.com/Savues/loon-plugin-patches>
#!tag=定位,QA
#!system=iOS, iPadOS
#!system_version=16
#!loon_version=3.4.0(962)
#!homepage=https://github.com/Savues/loon-plugin-patches
#!date=2026-09-28 14:10:00
# ==== PLUGIN_VERSION: v1.2 | 钉在 tag geofix-v1.2 | 脚本自托管 + 死参数清理 + 本地解析器与控制页 | BUILD_BY: Savues ====
#
# 【为什么没有 [Argument] 段】
# 上游清单里有一段 [Argument]（longitude / latitude / accuracy），但：
#   1) 三条 [Script] 规则都没有 argument= 参数，所以脚本里的 $argument 拿到的是
#      被拦截的 URL 本身，不是插件参数。脚本把它当 query 解析，永远取不到 lat/lon。
#   2) 那两个坐标的默认值本身就是空的。
# 两条路都断，所以这段是死参数，本版直接移除，避免让人以为配置页能填。
# 写入坐标请用 Bridge 端点：https://gs-loc.apple.com/geo-settings/save?lat=..&lon=..&acc=..

[Script]
http-request ^https?:\/\/gs-loc(-cn)?\.apple\.com\/geo-settings\/(ping|status|save|clear|export|diag) script-path=https://raw.githubusercontent.com/Savues/loon-plugin-patches/geofix-v1.2/plugins/GeoFix/src/geo-bridge.js, timeout=10, tag=GeoFix Bridge
http-request ^https?:\/\/gs-loc(-cn)?\.apple\.com\/geo-parse\? script-path=https://raw.githubusercontent.com/Savues/loon-plugin-patches/geofix-v1.2/plugins/GeoFix/src/geo-parse.js, timeout=15, tag=GeoFix Parse
http-request ^https?:\/\/gs-loc(-cn)?\.apple\.com\/geo-ui\/?$ script-path=https://raw.githubusercontent.com/Savues/loon-plugin-patches/geofix-v1.2/plugins/GeoFix/src/geo-ui.js, timeout=10, tag=GeoFix UI
http-request ^https?:\/\/map\.com\/(?:geo-ui\/?)?(?:\?(.*))?$ script-path=https://raw.githubusercontent.com/Savues/loon-plugin-patches/geofix-v1.2/plugins/GeoFix/src/geo-ui.js, timeout=10, tag=GeoFix UI short
http-request ^https?:\/\/gs-loc(-cn)?\.apple\.com\/geo-route\/(ping|save|start|pause|resume|stop|clear|status) script-path=https://raw.githubusercontent.com/Savues/loon-plugin-patches/geofix-v1.2/plugins/GeoFix/src/geo-route.js, timeout=10, tag=GeoFix Route
http-response ^https?:\/\/gs-loc(-cn)?\.apple\.com\/clls\/wloc script-path=https://raw.githubusercontent.com/Savues/loon-plugin-patches/geofix-v1.2/plugins/GeoFix/src/geo-response.js, requires-body=true, binary-body-mode=true, timeout=30, tag=GeoFix Response

[MitM]
hostname=gs-loc.apple.com, gs-loc-cn.apple.com, map.com

# 钉版说明：script-path 指向 tag geofix-v1.2
# 不会随仓库更新。切版本 = 换一个 GeoFix-vX.Y.lpx 重新导入。
# 切回最新版：plugins/GeoFix/GeoFix.lpx（跟随 main）
