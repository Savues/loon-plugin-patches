[General]
name = Block Ads - spfcas/sppthgb/czssdgz
description = Blocks ad images and config from tp.spfcas.com, apidd.spthgb.com, apidd.czssdgz.com; removes startup announcement and splash ads
version = 1.4.0

[Rule]
# Block ad image CDN - /ads/ path only (preserves covers/avatars/samples)
URL-REGEX,^https://tp\.spfcas\.com/.*/ads/,REJECT

# Block ad config API /api/v1/ads on both domains (keep legitimate movie/magnet APIs)
URL-REGEX,^https://apidd\.(spthgb|czssdgz)\.com/api/v1/ads,REJECT

# Block liquidlink config (returns empty responses)
DOMAIN-SUFFIX,api.liquidlink.cn,REJECT

# Optional: block ad click-through tracking domains
DOMAIN-SUFFIX,afengy.com,REJECT
DOMAIN-SUFFIX,win1823.com,REJECT
DOMAIN-SUFFIX,jopeki.com,REJECT
DOMAIN-SUFFIX,zenaruk.com,REJECT
DOMAIN-SUFFIX,tkock.com,REJECT

[Rewrite]
# Remove splash_ad from startup API (keep other config fields)
# Matches both domains, handles spaces/newlines in JSON
^https://apidd\.(czssdgz|spthgb)\.com/api/v1/startup.*$ body "splash_ad" ""

# Remove startup announcement message from plans API
^https://apidd\.(czssdgz|spthgb)\.com/api/v4/plans.*$ body "plan_message" ""

[MITM]
hostname = tp.spfcas.com, apidd.spthgb.com, apidd.czssdgz.com, api.liquidlink.cn
