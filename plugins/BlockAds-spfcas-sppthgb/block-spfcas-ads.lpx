[General]
name = Block Ads - spfcas/sppthgb
description = Blocks ad images and config from tp.spfcas.com and apidd.spthgb.com
version = 1.0.0

[Rule]
# Block ad image CDN - /ads/ path only (preserves covers/avatars)
URL-REGEX,^https://tp\.spfcas\.com/.*/ads/,REJECT

# Block ad config APIs only (keep legitimate movie/magnet APIs)
URL-REGEX,^https://apidd\.spthgb\.com/api/v1/(ads|startup),REJECT

# Block liquidlink config (returns empty responses)
DOMAIN-SUFFIX,api.liquidlink.cn,REJECT

# Optional: block ad click-through tracking domains
DOMAIN-SUFFIX,afengy.com,REJECT
DOMAIN-SUFFIX,win1823.com,REJECT
DOMAIN-SUFFIX,jopeki.com,REJECT
DOMAIN-SUFFIX,zenaruk.com,REJECT
DOMAIN-SUFFIX,tkock.com,REJECT

[MITM]
hostname = tp.spfcas.com, apidd.spthgb.com, api.liquidlink.cn
