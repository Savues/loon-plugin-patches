#!name=JavDB 去广告与公告 v1.9.4
#!desc=屏蔽 JavDB 启动广告图片、开屏广告配置、启动公告与首页横幅（spfcas/sppthgb 域投放）。
#!author=@Savues <https://github.com/Savues>
#!icon=https://raw.githubusercontent.com/Savues/loon-plugin-patches/main/plugins/BlockAds-spfcas-sppthgb/icon.png
#!tag=去广告,JavDB,启动公告
#!system=iOS, iPadOS
#!system_version=15
#!loon_version=3.4.0(962)
#!homepage=https://github.com/Savues/loon-plugin-patches
#!date=2026-10-12

[General]
description = Blocks ad images from all known JavDB API domains; removes splash_ad, startup announcement (settings.NOTICE), and homepage carousel ads (index_top)
author = Savues
homepage = https://github.com/Savues/loon-plugin-patches
license = MIT

[Rule]
# Block ad image CDN - /ads/ path only (preserves covers/avatars/samples)
URL-REGEX,^https://tp\.spfcas\.com/.*/ads/,REJECT

# Block liquidlink config (returns empty responses)
DOMAIN-SUFFIX,api.liquidlink.cn,REJECT

# Optional: block ad click-through tracking domains
DOMAIN-SUFFIX,afengy.com,REJECT
DOMAIN-SUFFIX,jdforrepam.com,REJECT
DOMAIN-SUFFIX,win1823.com,REJECT
DOMAIN-SUFFIX,jopeki.com,REJECT
DOMAIN-SUFFIX,zenaruk.com,REJECT
DOMAIN-SUFFIX,tkock.com,REJECT
DOMAIN-SUFFIX,kac.2vtt7a4.xyz,REJECT

[Rewrite]
# 版本探针 v2 (version-probe.sh 用, 勿删)
request if ${url} ~= /^https?:\/\/tp\.spfcas\.com\/gw\/loon-sim\.probe\.block_spfcas_ads/i then reject(200, "1.9.4")
# Remove splash_ad: set enabled=false (keep structure to avoid bottom bar issue)
^https://apidd\.(czssdgz|spthgb|btyjscl)\.com/api/v1/startup.*$ response-body-json-jq '.data.splash_ad.enabled = false'
^https://api\.(aliycloud|ffaoa)\.com/api/v1/startup.*$ response-body-json-jq '.data.splash_ad.enabled = false'

# Remove startup announcement (settings.NOTICE) from startup API
^https://apidd\.(czssdgz|spthgb|btyjscl)\.com/api/v1/startup.*$ response-body-json-jq '.data.settings.NOTICE = ""'
^https://api\.(aliycloud|ffaoa)\.com/api/v1/startup.*$ response-body-json-jq '.data.settings.NOTICE = ""'

# Remove homepage carousel ads: disable at both data and data.ads levels
# Set enabled=false so App hides the ad container completely
^https://apidd\.(czssdgz|spthgb|btyjscl)\.com/api/v1/ads.*$ response-body-json-jq '.data.enabled = false | .data.ads.enabled = false | .data.ads.index_top = [] | .data.ads.web_magnets_top = [] | .data.ads.magnets_top = []'
^https://api\.(aliycloud|ffaoa)\.com/api/v1/ads.*$ response-body-json-jq '.data.enabled = false | .data.ads.enabled = false | .data.ads.index_top = [] | .data.ads.web_magnets_top = [] | .data.ads.magnets_top = []'

# Remove startup announcement message from plans API (legacy endpoint)
^https://apidd\.(czssdgz|spthgb|btyjscl)\.com/api/v4/plans.*$ response-body-json-jq '.data.plan_message = ""'
^https://api\.(aliycloud|ffaoa)\.com/api/v4/plans.*$ response-body-json-jq '.data.plan_message = ""'

[MITM]
hostname = tp.spfcas.com, apidd.spthgb.com, apidd.czssdgz.com, apidd.btyjscl.com, api.aliycloud.com, api.ffaoa.com, api.liquidlink.cn

[Script]
# No additional scripts needed
