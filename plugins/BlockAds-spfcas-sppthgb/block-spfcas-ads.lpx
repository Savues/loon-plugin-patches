[General]
name = Block Ads - spfcas/sppthgb/czssdgz
description = Blocks ad images and config from tp.spfcas.com, apidd.spthgb.com, apidd.czssdgz.com; removes startup announcement
version = 1.2.0

[Rule]
# Block ad image CDN - /ads/ path only (preserves covers/avatars/samples)
URL-REGEX,^https://tp\.spfcas\.com/.*/ads/,REJECT

# Block ad config APIs on primary domain (keep legitimate movie/magnet APIs)
URL-REGEX,^https://apidd\.spthgb\.com/api/v1/(ads|startup),REJECT

# Block ad config APIs on backup domain (keep legitimate movie/magnet APIs)
URL-REGEX,^https://apidd\.czssdgz\.com/api/v1/(ads|startup),REJECT

# Block liquidlink config (returns empty responses)
DOMAIN-SUFFIX,api.liquidlink.cn,REJECT

# Optional: block ad click-through tracking domains
DOMAIN-SUFFIX,afengy.com,REJECT
DOMAIN-SUFFIX,win1823.com,REJECT
DOMAIN-SUFFIX,jopeki.com,REJECT
DOMAIN-SUFFIX,zenaruk.com,REJECT
DOMAIN-SUFFIX,tkock.com,REJECT

[Rewrite]
# Remove startup announcement message from plans API
# Matches: https://apidd.czssdgz.com/api/v4/plans (and apidd.spthgb.com if used)
# Replaces plan_message with empty string
^https://apidd\.(czssdgz|spthgb)\.com/api/v4/plans.*$ body "plan_message\":\"[^\"]*\"" "plan_message\":\"\""

[MITM]
hostname = tp.spfcas.com, apidd.spthgb.com, apidd.czssdgz.com, api.liquidlink.cn
