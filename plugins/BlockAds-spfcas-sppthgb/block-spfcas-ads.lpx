[General]
name = Block Ads - spfcas/sppthgb/czssdgz/btyjscl/aliycloud/ffaoa
description = Blocks ad images and config from all known JavDB API domains; removes splash_ad and startup announcement (settings.NOTICE)
version = 1.5.0
author = Savues
homepage = https://github.com/Savues/loon-plugin-patches
license = MIT
updated = 2026-10-12

[Rule]
# Block ad image CDN - /ads/ path only (preserves covers/avatars/samples)
URL-REGEX,^https://tp\.spfcas\.com/.*/ads/,REJECT

# Block ad config API /api/v1/ads on all known domains (keep legitimate movie/magnet APIs)
URL-REGEX,^https://apidd\.(spthgb|czssdgz|btyjscl)\.com/api/v1/ads,REJECT
URL-REGEX,^https://api\.(aliycloud|ffaoa)\.com/api/v1/ads,REJECT

# Block liquidlink config (returns empty responses)
DOMAIN-SUFFIX,api.liquidlink.cn,REJECT

# Optional: block ad click-through tracking domains
DOMAIN-SUFFIX,afengy.com,REJECT
DOMAIN-SUFFIX,win1823.com,REJECT
DOMAIN-SUFFIX,jopeki.com,REJECT
DOMAIN-SUFFIX,zenaruk.com,REJECT
DOMAIN-SUFFIX,tkock.com,REJECT
DOMAIN-SUFFIX,kac.2vtt7a4.xyz,REJECT

[Rewrite]
# Remove splash_ad from startup API (all known domains)
^https://apidd\.(czssdgz|spthgb|btyjscl)\.com/api/v1/startup.*$ body "splash_ad" ""
^https://api\.(aliycloud|ffaoa)\.com/api/v1/startup.*$ body "splash_ad" ""

# Remove startup announcement (settings.NOTICE) from startup API
^https://apidd\.(czssdgz|spthgb|btyjscl)\.com/api/v1/startup.*$ body "NOTICE" ""
^https://api\.(aliycloud|ffaoa)\.com/api/v1/startup.*$ body "NOTICE" ""

# Remove startup announcement message from plans API (legacy endpoint)
^https://apidd\.(czssdgz|spthgb|btyjscl)\.com/api/v4/plans.*$ body "plan_message" ""
^https://api\.(aliycloud|ffaoa)\.com/api/v4/plans.*$ body "plan_message" ""

[MITM]
hostname = tp.spfcas.com, apidd.spthgb.com, apidd.czssdgz.com, apidd.btyjscl.com, api.aliycloud.com, api.ffaoa.com, api.liquidlink.cn

[Script]
# No additional scripts needed - all handled by Rewrite rules
