#!name=Zepp-AdBlock v1.3.0
#!desc=拦截开屏（startpage_ad）、首页弹窗、公告板运营卡、设备页推广、运动周月报推广卡与训练视频广告。
#!version=1.3.0
#!author=Savues
#!homepage=https://github.com/Savues/loon-plugin-patches
#!icon=https://raw.githubusercontent.com/Savues/loon-plugin-patches/main/plugins/Zepp-AdBlock/icon.png

[Argument]
[Rule]
# 高德广告/追踪 SDK (Zepp 内嵌 AMap)
DOMAIN, adiu.amap.com, REJECT
DOMAIN-SUFFIX, logs.amap.com, REJECT

[MITM]
hostname = api-mifit-cn.zepp.com, api-mifit-cn2.zepp.com, api-mifit-cn3.zepp.com, api-mifit.zepp.com, api-mifit-us.zepp.com

[Rewrite]
# === 开屏广告: LaunchAd 体系数据源 (LaunchAdNetwork.fetchLaunchAdDatas, 响应为广告数组: bg_img_url/ad_type/showCount) ===
# HAR 实证: GET /discovery/watch/cards/startpage_ad → 当前无投放返回 [], 有投放时数组含开屏素材
# 空响应容忍性: App 日志 "datas is not array / is empty" → 按无广告处理, 安全
request if ${url} ~= /^https?:\/\/api-mifit(-cn\d?)?\.zepp\.com\/discovery\/watch\/cards\/startpage_ad/ then reject_dict(200)

# === 同族广告接口 (二进制常量区实证: startpage_ad/homepage_ad/homepage_popup/sport_summary_ad 同组) ===
request if ${url} ~= /^https?:\/\/api-mifit(-cn\d?)?\.zepp\.com\/discovery\/watch\/cards\/(homepage_ad|homepage_popup|home_bulletin_board|home_page_promotion|device_page_promotion|sport_page_entrance)/ then reject_dict(200)
request if ${url} ~= /^https?:\/\/api-mifit(-cn\d?)?\.zepp\.com\/discovery\/watch\/discovery\/(sport_ad|sport_summary_ad|training_video_ad)/ then reject_dict(200)

# === 探针 (版本观测, 详见仓库 workflow) ===
request if ${url} ~= /^https?:\/\/api-mifit-cn\.zepp\.com\/gw\/loon-sim\.probe\.zepp_remove_ads/i then reject(200, "1.3.0")
