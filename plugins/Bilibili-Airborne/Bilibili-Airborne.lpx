#!name=B站空降助手 v1.8
#!desc=v1.8 提醒档改成「顶部大字号 + 延后到第 8 秒」出现——25px 滚动弹幕混在上千条真实弹幕里根本看不见。同时优先借用视频里一条「顶部」样式的真实弹幕。提醒时机可用「提醒延后秒数」调整。本修改版仓库: https://github.com/Savues/loon-plugin-patches
#!author=原作者: kokoryh (Sparkle) | 可配置化与独立插件: Savues <https://github.com/Savues/loon-plugin-patches>
#!tag=空降助手,SponsorBlock,Bilibili
#!system=iOS, iPadOS
#!system_version=15
#!loon_version=3.4.0(962)
#!homepage=https://github.com/Savues/loon-plugin-patches
#!date=2026-10-09 21:00:00

[Argument]
Airborne = switch,true,tag=空降助手,desc=总开关。关闭后不再向弹幕响应注入空降弹幕
airCategories = input,"sponsor,selfpromo,interaction,intro,outro,padding",tag=自动跳的类型,desc=英文逗号分隔。这些类别的片段会带空降动作（自动执行，点一下也能跳）。可选：sponsor(恰饭) selfpromo(自我推广) exclusive_access interaction poi_highlight intro(片头) outro(片尾) preview filler padding(前黑后黑) music_offtopic。填 off = 全关
airActions = input,"skip",tag=允许哪些动作,desc=App 端只能"跳转"，所以只有 skip / full / poi 有实际效果。full=整段即此类，会直接空降到片尾；poi=精彩时刻，空降��那个时间点；mute 填了无效
airMinDuration = input,"8",tag=片段最小时长(秒),desc=比这个短的片段不跳。填 0 = 不限（一键三连提示只有 2-3 秒，想跳它就调到 3）
airMode = select,"jump","mark",tag=空降方式,desc=jump：自动跳的类型带空降动作（需 chronos 重签）；mark：全部降级为只显示文字，一律不跳
airNoticeCategories = input,"off",tag=只提醒的类型,desc=默认空。把某类从这里挪进来（并从上面移除），它就只在弹幕栏显示一行文字提醒、**不会跳转**，跳不跳你自己拖进度条
airFullMode = select,"notice","jump","off",tag=整篇软广的处理,desc=社区把整个视频标记为某一类时（片段是零长度的整篇标记，官方有 8306 条独家/整篇恰饭）。notice：在片头约 2 秒出一行文字提醒（如「⚠️ 恰饭 全长16:56」），不跳转；jump：直接空降到片尾；off：完全不处理。默认 notice 最安全——独家首发类（如电影）常常有真内容
airNotice = input,"空指部已就位",tag=自动跳的文案,desc=支持占位符 {cat}=类别中文名 {catid}=类别原始id {start}=起点 {end}=终点 {dur}=时长(秒)。例：跳过{cat} {start}→{end}
airInfoDelay = input,"8",tag=提醒延后秒数,desc=「只提醒」的弹幕比片段起点晚几秒出现。默认 8 秒：第 2 秒太早，用户根本来不及看。只影响提醒档，自动跳的时机不变（自动跳必须在片段开始时就位）。填 0 = 不延后
airInfo = input,"⚠️ {cat} {start}→{end}",tag=只提醒的文案,desc=占位符同上，{cat} 会渲染成中文（如「一键三连」「自我推广」）。例：这里有 {dur}s {cat}，想看就自己拖
chronos = switch,true,tag=chronos 重签,desc=让 App 能加载到校验文件，空降弹幕才会自动跳。关掉后弹幕仍会显示、点了也能跳，只是不会自动跳
logLevel = select,"off","error","warn","info","debug",tag=脚本日志等级,desc=排查时选 debug，Loon 日志里会出现 [SponsorBlock]

[Script]
http-request ^https:\/\/(grpc\.biliapi\.net|app\.bili(bili\.com|api\.net))\/bilibili\.community\.service\.dm\.v1\.DM\/DmSegMobile$ script-path=https://raw.githubusercontent.com/Savues/loon-plugin-patches/main/plugins/Bilibili-Airborne/bilibili.airborne.js, argument=[{airFullMode},{airInfoDelay},{airCategories},{airNoticeCategories},{airActions},{airMinDuration},{airMode},{airNotice},{airInfo},{logLevel}], requires-body=true, binary-body-mode=true, timeout=10, enable={Airborne}, tag=空降助手

http-response ^https:\/\/(grpc\.biliapi\.net|app\.bili(bili\.com|api\.net))\/bilibili\.app\.view\.v1\.View\/ViewProgress$ script-path=https://raw.githubusercontent.com/Savues/loon-plugin-patches/main/plugins/Bilibili-Airborne/chronos.js, requires-body=1, binary-body-mode=1, timeout=5, enable={chronos}, tag=chronos重签

[Mitm]
hostname = grpc.biliapi.net, app.bilibili.com, app.biliapi.net
h2 = true