#!name=B站空降助手 v1.54
#!desc=v1.54 新增参数「UP主点赞标记」(airUpLike)：注入的弹幕是否带 attr 的「UP主点赞」位（部分客户端会画 👍）。默认 off=与普通弹幕一致（此前硬编码 0x140004，等于冒充被点赞的弹幕）。v1.53 恰饭类长名「恰饭内容」→「恰饭广告」：与置顶警告句「本片为恰饭广告」用词统一，也避免和「内容预告」在明细里连着出现两个「内容」。v1.52 删掉分页过滤，恢复「每个响应都注入全部弹幕」——v1.51 实测证明 App 会渲染跨页弹幕（汇总在第 1 页响应里、进度 3500ms 也正常显示），而分页过滤会让自动跳过与提醒在「App 没请求那一页」时彻底丢失（表现为跳过失效 + 没有提醒）。v1.51 汇总不按页过滤（每页响应都带、保持原进度 3500ms），验证 App 是否能渲染跨页弹幕——若能，开头即可见汇总（实测 7 份 HAR 显示 iPad 端从未请求过 segmentIndex=0）。v1.50 修复「插件完全失效」：① v1.47 起 __airInject 里引用了不存在的 s（应为传入的 state）→ 每次注入都 ReferenceError，Loon 回退原样放行；② segmentIndex 是 protobuf int64，解析出来是字符串，`segIdx === 0` 恒假 → 首页被当成非首页、汇总被丢。两处都补了回归测试（含字符串页码）。v1.49 开头片段（起点=0）不再单独显示提醒，汇总已覆盖；避免开头出现两条弹幕（汇总+提醒）。v1.48 汇总延后 500ms（auto 模式）避免与第 1 段提醒同进度重叠导致只显示一条；start 模式保持 3s 旧行为。v1.47 分页注入恢复：segIdx=0 注入汇总+本页提醒，segIdx>0 只注本页空降；兜底：连续 3 页未见首页则把汇总补注到首个响应（解决首页请求未捕获导致开头全无汇总）。v1.46 回退 v1.45 的分页过滤（导致第 0 页请求未捕获时汇总全丢），恢复全量注入；bsbsb 瞬断重试保留。v1.45 修复片头汇总不显示：注入弹幕改按 DmSegMobile 分页（360s/页）过滤——此前把钉在开头的汇总塞进别的页的响应里，App 只渲染本页窗口内的弹幕，塞错页=全部白注（实测 BV1sxp36eEMU 汇总进了第 1 页永不显示）。另加 bsbsb 瞬断重试一次：实测同一页 76ms 瞬断放行、下一次就成功，错过开头那页汇总正好全丢。v1.44 单类别时去掉类别头行（统计首行已点名「恰饭×2 ｜ 2 处 共计13s」，头行纯属复读）；自定义 {list} 模板不受影响（它没有统计首行，剥名字会丢信息）。v1.43 全量文案校对：preview「往期回顾」→「内容预告/预告」（官方定义是预告集锦，原译名语义相反）、padding「前黑后黑」→「黑屏填充」、intro 短名「片头」→「开场」（与长名配套）、music_offtopic「非音乐片段」→「非音乐部分」；起止相同的片段（如三连提醒）只显示一个时间点。v1.42 警告句在场时统计行不再带 ⚠️，避免开头出现两个警示符（普通场景仍保留）。v1.41 汇总内文改为「警告置顶 → 统计 → 明细」的顺序（整篇警告句放最上面更直观）；警告行从明细的行数预算里扣除，整条弹幕总行数不变。v1.40 统计首行不再计入整篇标记（恰饭/软广整篇由两句警告句表达，计进×N/处/秒都是重复计数）——混合场景如「恰饭×2 ｜ 2 处」改为「恰饭×1 ｜ 1 处」。v1.39 整篇软广句改为「⚠️警告：本片为品牌方合作内容」。v1.38 整篇软广句微调：「本片内」→「本片中」。v1.37 两个整篇标记统一为警告句式：恰饭「⚠️警告：本片为恰饭广告」（原「全片恰饭软广」）、软广「⚠️警告：本片为品牌方合作内容」（原「厂商送测」太窄，盖不住免费资格/场地等官方定义的全部情形）（原「本节目由品牌方赞助播出」）。v1.36 全片只有一个整篇标记（恰饭/软广）时，那句话本身就是整条汇总，不再附「⚠️ 恰饭×1 ｜ 1 处」的统计首行。v1.35 整篇软广那行改用更顺口的电视腔：「本节目由品牌方赞助播出」（此前为「软广 · 产品/服务为品牌方无偿提供」）。v1.34 只有整篇标记时合计为 0 秒，首行不再显示「共计0s」：「⚠️ 软广×1 ｜ 1 处」。v1.33 首行合计秒数不再计入整篇标记（整篇的"时长"=片长，计进去只会变成一个没意义的大数），只计数不计秒。v1.32 片头汇总首行改为计数式：「⚠️ 恰饭×1 自推×1 ｜ 3 处 共计272s」（每类短名×次数 + 总段数 + 总时长）。exclusive_access 译名「独家体验」改为「软广」，整篇那行利用空余宽度补注：软广 · 产品/服务为品牌方无偿提供（官方定义：UP主免费或获品牌方补贴后使用的产品/服务）。本修改版仓库: https://github.com/Savues/loon-plugin-patches
#!author=原作者: kokoryh (Sparkle) | 可配置化与独立插件: Savues <https://github.com/Savues/loon-plugin-patches>
#!tag=空降助手,SponsorBlock,Bilibili
#!system=iOS, iPadOS
#!system_version=15
#!loon_version=3.4.0(962)
#!homepage=https://github.com/Savues/loon-plugin-patches
#!date=2026-10-10 08:20:00

[Argument]
Airborne = switch,true,tag=空降助手,desc=总开关。关闭后不再向弹幕响应注入空降弹幕
airCategories = input,"sponsor,selfpromo,interaction,intro,outro,padding",tag=自动跳的类型,desc=英文逗号分隔。这些类别的片段会带空降动作（自动执行，点一下也能跳）。可选：sponsor(恰饭) selfpromo(自我推广) exclusive_access interaction poi_highlight intro(开场) outro(片尾) preview(预告) filler padding(黑屏填充) music_offtopic。填 off = 全关
airActions = input,"skip",tag=允许哪些动作,desc=App 端只能"跳转"，所以只有 skip / full / poi 有实际效果。full=整段即此类，会直接空降到片尾；poi=精彩时刻，空降到那个时间点；mute 填了无效。
airMinDuration = input,"0",tag=片段最小时长(秒),desc=比这个短的片段不跳。默认 0 = 不限，所有片段都处理。想只跳掉足够长的（如 ≥8 秒）就填 8
airMode = select,"jump","mark",tag=空降方式,desc=jump：自动跳的类型带空降动作（需 chronos 重签）；mark：全部降级为只显示文字，一律不跳
airNoticeCategories = input,"exclusive_access,poi_highlight,preview,filler,music_offtopic",tag=只提醒的类型,desc=这些类别的片段只在弹幕栏显示一行文字提醒，**不会跳转**，跳不跳你自己拖进度条。默认填的是所有**不在自动跳列表里**的类别，两档并集正好是 bsbsb 全部 11 类。把某类从这里删掉（并加进上面那档）就改成自动跳；反过来就变成只提醒
airFullMode = select,"notice","jump","off",tag=整篇软广的处理,desc=社区把整个视频标记为某一类时（片段是零长度的整篇标记，官方有 8306 条独家/整篇恰饭）。notice：不再单独出提醒，整篇信息由「片头汇总」里那一行「XX 整篇」表达；关掉汇总时才会单独提醒；jump：直接空降到片尾；off：完全不处理。默认 notice 最安全——独家首发类（如电影）常常有真内容
airNotice = input,"空指部已就位",tag=自动跳的文案,desc=支持占位符 {cat}=类别中文名 {catid}=类别原始id {start}=起点 {end}=终点 {dur}=时长(秒)。例：跳过{cat} {start}→{end}
airInfoDelay = input,"3",tag=提醒延后秒数,desc=「只提醒」的弹幕比它所标注片段的起点晚几秒出现。默认 3 秒。整篇软广的片段起点是 0 秒，不延后的话弹幕落在第 2 秒，实测来不及看；只影响提醒档，自动跳固定在片段起点 +2 秒（它必须一开始就位才能跳）。填 0 = 回到 +2 秒
airInfoMode = select,"5","1","4",tag=提醒弹幕样式,desc=5=顶部：最显眼，但停留时间最短（固定时长，约几秒）；1=滚动：停留最久，暂停视频也保留，但容易混进一堆弹幕里；4=底部。默认 5。自动跳的那条不受此项影响，始终是顶部空降弹幕。
airUpLike = select,"off","on",tag=UP主点赞标记,desc=注入的弹幕是否带「UP主点赞」属性位。on=带（部分客户端会显示 👍 图标，弹幕更显眼）；off=与普通弹幕一致（默认，不冒充被 UP 主点赞的弹幕）
airInfo = input,"⚠️ {cat} {start}→{end}",tag=只提醒的文案,desc=占位符同上，{cat} 会渲染成中文（如「一键三连」「自我推广」）。例：这里有 {dur}s {cat}，想看就自己拖
airSummary = select,"single","off",tag=片头汇总,desc=视频开头列出本视频里会被处理的片段。同类片段会折叠成一行（如「恰饭广告 ×2 · 34:55–35:11 | 52:31–52:40」），最多列 5 类，超出会标注「等 N 类」。single：列成一条汇总弹幕；off：不列。文案复用「只提醒的文案」——模板里写了 {list} 就用你的，否则用内置文案
airSummaryAnchor = select,"auto","start",tag=汇总钉在哪,desc=auto：顺着开头的自动跳往后爬，把汇总钉在用户真正开始看内容的那一刻。视频开头就有片头/恰饭时 App 会在第 2 秒直接跳走，汇总若还钉在第 3 秒就永远看不到（实测 BV1PyHi6vEpA 开场动画 00:00–00:32，2 秒跳到 32 秒）。start：永远钉在开头，保留旧行为
airSummaryColor = select,"白色","红色","橙色","黄色","绿色","青色","紫色","灰色",tag=汇总颜色,desc=片头汇总那条弹幕的颜色。一条弹幕只能有一个颜色，所以折叠后的多行汇总所有行共用这个颜色。默认白色（顶部弹幕背景偏深，白色最不刺眼）
airSummaryLines = select,"6","5","4","3","off",tag=汇总最多几行,desc=单条弹幕能占几行。实测手机端**最多 6 行**，超出的整条弹幕会被忽略、什么也看不见（用户 BV1EDHC6CEDJ 7 行时汇总完全不显示）。默认 6 刚好用满预算；切 off = 不限（行数再多也可能整条不显示）
chronos = switch,true,tag=chronos 重签,desc=让 App 能加载到校验文件，空降弹幕才会自动跳。关掉后弹幕仍会显示、点了也能跳，只是不会自动跳
logLevel = select,"off","error","warn","info","debug",tag=脚本日志等级,desc=排查时选 debug，Loon 日志里会出现 [SponsorBlock]

[Script]
http-request ^https:\/\/(grpc\.biliapi\.net|app\.bili(bili\.com|api\.net))\/bilibili\.community\.service\.dm\.v1\.DM\/DmSegMobile$ script-path=https://raw.githubusercontent.com/Savues/loon-plugin-patches/main/plugins/Bilibili-Airborne/bilibili.airborne.js, argument=[{airFullMode},{airInfoDelay},{airInfoMode},{airSummary},{airSummaryAnchor},{airSummaryColor},{airSummaryLines},{airCategories},{airNoticeCategories},{airActions},{airMinDuration},{airMode},{airNotice},{airInfo},{airUpLike},{logLevel}], requires-body=true, binary-body-mode=true, timeout=10, enable={Airborne}, tag=空降助手

http-response ^https:\/\/(grpc\.biliapi\.net|app\.bili(bili\.com|api\.net))\/bilibili\.app\.view\.v1\.View\/ViewProgress$ script-path=https://raw.githubusercontent.com/Savues/loon-plugin-patches/main/plugins/Bilibili-Airborne/chronos.js, argument=[{logLevel}], requires-body=1, binary-body-mode=1, timeout=5, enable={chronos}, tag=chronos重签

[Mitm]
hostname = grpc.biliapi.net, app.bilibili.com, app.biliapi.net
h2 = true
