#!name=B站空降助手【测试·9月版脚本】v1.1t
#!desc=【临时测试版】唯一区别：脚本基线是 kokoryh/Sparkle **2026/9/7 的快照**（就是 Bilibili-Dedup 内置的那同一个文件），而不是当前上游 10/7 版。用来判定「自动跳转的差异到底是不是上游版本造成的」。⚠️ 测试时请把另一个「B站空降助手 v1.1」关掉或删除，否则两个脚本会重复注入。参数与正式版完全一致。 
#!author=原作者: kokoryh (Sparkle) | 可配置化与独立插件: Savues <https://github.com/Savues/loon-plugin-patches>
#!tag=空降助手,SponsorBlock,Bilibili
#!system=iOS, iPadOS
#!system_version=15
#!loon_version=3.4.0(962)
#!homepage=https://github.com/Savues/loon-plugin-patches
#!date=2026-10-09 14:05:00

[Argument]
Airborne = switch,true,tag=空降助手,desc=总开关。关闭后不再向弹幕响应注入空降弹幕
airCategories = input,"sponsor",tag=跳过哪些类型,desc=英文逗号分隔。可选：sponsor(恰饭) selfpromo(自我推广) exclusive_access(独家体验) interaction(一键三连) poi_highlight(精彩时刻) intro(片头) outro(片尾) preview(回顾) filler(填充) padding(前黑后黑) music_offtopic(离题闲聊)。填 off 或留空 = 全关
airActions = input,"skip",tag=允许哪些动作,desc=App 端只能"跳转"，所以只有 skip / full / poi 有实际效果。full=整段即此类，会直接空降��片尾；poi=精彩时刻，空降��那个时间点；mute 填了无效
airMinDuration = input,"8",tag=片段最小时长(秒),desc=比这个短的片段不跳。填 0 = 不限（一键三连提示只有 2-3 秒，想跳它就调到 3）
airMode = select,"jump","mark",tag=空降方式,desc=jump：到点自动跳到片段末尾；mark：只在弹幕栏显示提示，不跳转
airNotice = input,"空指部已就位",tag=提示文案,desc=支持占位符 {cat}=类别 {start}=起点 {end}=终点 {dur}=时长(秒)。例：跳过{cat} {start}→{end}
logLevel = select,"off","error","warn","info","debug",tag=脚本日志等级,desc=排查时选 debug，Loon 日志里会出现 [SponsorBlock]

[Script]
http-request ^https:\/\/(grpc\.biliapi\.net|app\.bili(bili\.com|api\.net))\/bilibili\.community\.service\.dm\.v1\.DM\/DmSegMobile$ script-path=https://raw.githubusercontent.com/Savues/loon-plugin-patches/main/plugins/Bilibili-Airborne/bilibili.airborne-0907.js, argument=[{airCategories},{airActions},{airMinDuration},{airMode},{airNotice},{logLevel}], requires-body=true, binary-body-mode=true, timeout=10, enable={Airborne}, tag=空降助手

[Mitm]
hostname = grpc.biliapi.net, app.bilibili.com, app.biliapi.net
h2 = true