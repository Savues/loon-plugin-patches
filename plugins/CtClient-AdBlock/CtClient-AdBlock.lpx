#!name=中国电信去广告+精简 v2.1.0
#!version=2.1.0
#!desc=中国电信 CtClient 13.5.0 去广告+精简：清首页营销位(hotSelection)/套餐销售banner/信息流推荐/营销消息/出行酒店推广；置空弹窗与营销装饰接口（可关）。严格保留功能入口——首页九宫格 adList、金刚位 compoundADSpace、我的页 topAdList(设置/签到/关爱)、AI卡 adList(开发票/买流量包)、签到领流量卡片 adList 全部不动。
#!openUrl=https://apps.apple.com/app/id513836029
#!author=@Savues <https://github.com/Savues>
#!tag=去广告
#!system=
#!system_version=
#!loon_version=3.5.1(998)
#!homepage=https://github.com/Savues/loon-plugin-patches/tree/main/plugins/CtClient-AdBlock
#!icon=https://raw.githubusercontent.com/Savues/loon-plugin-patches/main/plugins/CtClient-AdBlock/icon.png
#!date=2026-11-05 21:00:00

[Argument]
stubPopups = switch, true, false, tag=🚫弹窗类, desc=整接口置空 getPopUpWindows（弹窗）/ queryAdRotation（广告轮播）。可能连实名认证、欠费提醒一起挡掉，需要时关掉
stubMarketing = switch, true, false, tag=🧹营销/装饰接口, desc=整接口置空：我的页广告位(queryMyChannelAdvSpace)、充值营销/提示/消息(queryRechargeMarketing/Tips/Msg/RechargerMsg)、活动(userActivity/*)、节气(getSolarTerms)、靓号(queryBeautifulScr)、优惠推荐(queryOffersAndBroadband)、热门导航(queryHotNav)
homepageFloor = switch, true, false, tag=🏠首页-营销位, desc=清洗 queryHomepageMarketingFloor 的 hotSelection.advertisingListLeft/Right（实测 5+3 条：11.11限定/低价订酒店/合约机/出境漫游）；adList 九宫格与 sortList 不动
homepageHotSelection = switch, true, false, tag=🏠首页-右侧精选, desc=上一条的细分开关：hotSelection 两侧推荐位
homepageTariffBanner = switch, true, false, tag=🏠首页-套餐销售banner, desc=清空 packageAndNumberCard.tabList[].bottomBannerList（实测 3+1 条：5G-A套餐/5G畅享云套餐/卫星功能卡/精选好号）
feedRecommendAd = switch, true, false, tag=📰信息流-推荐广告, desc=清空 getFeedList 卡片内 recommendAdBean.recommendAdList（实测 3/3/2 条：宽带新装/宽带专区/天翼出行）；feedList 本体与 topArea 保留
marketingMessage = switch, true, false, tag=💬消息-营销消息流, desc=清空 queryMessageChannel 的 marketingMessageList(11条) 与 dynamicMessage.marketingMessageList(9条)；服务消息/实时事件不动


travelHotelAd = switch, true, false, tag=✈️出行-酒店推广, desc=只清 myTravelCardNew 里 hotelBean.topAdList（低价订酒店）；出行卡片本体不动

[Rule]

[MitM]
hostname = appgoadsz.189.cn, appgoadhd.189.cn, appgosz.189.cn

[Rewrite]
# 版本探针 v2 (version-probe.sh 用, 勿删)
request if ${url} ~= /^https?:\/\/appgoadsz\.189\.cn\/gw\/loon-sim\.probe\.ctclient_adblock/i then reject(200, "2.1.0")
# ── 悬浮窗 / 登录悬浮 / 推送引导（实测均返回 data=null 或 []，App 有空响应容忍）──
request if ${url} ~= /^https?:\/\/(?:appgoadsz|appgoadhd)\.189\.cn(?::\d+)?\/query\/(?:suspend\/suspendWindow|suspendWindowForQuery|suspendWindowForWap|suspendWindowV2|loginSuspendWindow)/i then reject_dict(200)
request if ${url} ~= /^https?:\/\/(?:appgoadsz|appgoadhd)\.189\.cn(?::\d+)?\/query\/queryNotificationGuideDialog/i then reject_dict(200)

# ── 纯广告接口（CTPocket 二进制常量区实证，本次未抓到响应样本）──
# 名称即语义：compositeAd / mallPackageAd / serviceChannelAd / queryAdvertisingSpace /
# queryCustomerAdvertising / qryNearConfigAdvertising / qryTraAdvertisingSpace
# ⚠️ 未取证接口：若某页面（查询办理/商城/附近营业厅）出现白屏或空白区块，先注释本段再复测
request if ${url} ~= /^https?:\/\/(?:appgoadsz|appgoadhd)\.189\.cn(?::\d+)?\/query\/(?:advertising\/(?:compositeAd|mallPackageAd|serviceChannelAd)|queryAdvertisingSpace|queryCustomerAdvertising|qryNearConfigAdvertising|qryTraAdvertisingSpace)/i then reject_dict(200)

[Script]
response if ${url} ~= /^https?:\/\/(?:appgoadsz|appgoadhd|appgosz)\.189\.cn(?::\d+)?\/query\/myTravelCardNew/i then script("https://raw.githubusercontent.com/Savues/loon-plugin-patches/main/plugins/CtClient-AdBlock/src/bundle.js?v=3", {${travelHotelAd}}) with requires_body=true, timeout=8, tag="出行卡片酒店推广清洗"

response if ${url} ~= /^https?:\/\/(?:appgoadsz|appgoadhd|appgosz)\.189\.cn(?::\d+)?\/query\/(?:getPopUpWindows|queryAdRotation|queryMyChannelAdvSpace|queryRechargeMarketing|queryRechargeTips|queryRechargeMsg|queryRechargerMsg|userActivity\/(?:queryActivityInfo|queryRechagerMessage)|getSolarTerms|queryBeautifulScr)/i then script("https://raw.githubusercontent.com/Savues/loon-plugin-patches/main/plugins/CtClient-AdBlock/src/bundle.js?v=3", {${stubPopups}, ${stubMarketing}}) with requires_body=true, timeout=5, tag="无用功能接口置空"

response if ${url} ~= /^https?:\/\/(?:appgoadsz|appgoadhd)\.189\.cn(?::\d+)?\/query\/queryHomepageMarketingFloor/i then script("https://raw.githubusercontent.com/Savues/loon-plugin-patches/main/plugins/CtClient-AdBlock/src/bundle.js?v=3", {${homepageFloor}, ${homepageHotSelection}, ${homepageTariffBanner}}) with requires_body=true, timeout=5, tag="首页营销位清洗"

response if ${url} ~= /^https?:\/\/(?:appgoadsz|appgoadhd)\.189\.cn(?::\d+)?\/query\/getFeedList/i then script("https://raw.githubusercontent.com/Savues/loon-plugin-patches/main/plugins/CtClient-AdBlock/src/bundle.js?v=3", {${feedRecommendAd}}) with requires_body=true, timeout=10, tag="信息流推荐广告清洗"

response if ${url} ~= /^https?:\/\/(?:appgoadsz|appgoadhd)\.189\.cn(?::\d+)?\/query\/queryMessageChannel/i then script("https://raw.githubusercontent.com/Savues/loon-plugin-patches/main/plugins/CtClient-AdBlock/src/bundle.js?v=3", {${marketingMessage}}) with requires_body=true, timeout=8, tag="营销消息流清洗"



