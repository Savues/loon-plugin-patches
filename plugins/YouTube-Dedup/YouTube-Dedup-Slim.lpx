#!name=YouTube去广告(精简版) v5.7.0
#!desc=针对「广告拦截合集内置重复脚本」的精简版 v5.7.0。去广告、画中画、后台播放、隐藏Shorts/上传按钮、清除「游戏大本营」与信息流广告。仅解密 youtubei.googleapis.com，最大限度降低App加载延迟。v5.7 起因合集的 YouTube 规则退场导致信息流广告反弹，自研脚本补上广告判据（pagead / inline_injection），与游戏大本营共用同一遍扫描。字幕翻译已强制关闭，字幕请交由「YouTube双语翻译」插件处理。需启用 MitM over HTTP/2 与 QUIC 回退保护。 本修改版仓库: https://github.com/Savues/loon-plugin-patches。
#!author=原作者: Maasea, VirgilClyne, Choler, DivineEngine, app2smile | 修改整合: Savues <https://github.com/Savues/loon-plugin-patches>
#!tag=去广告
#!system=iOS, iPadOS, macOS
#!system_version=15
#!loon_version=3.4.0(962)
#!homepage=https://github.com/Savues/loon-plugin-patches
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/YouTube.png
#!date=2026-09-29 07:55:00

[Argument]
blockUpload=switch, false, true, tag=隐藏上传按钮, desc=用于隐藏YouTube底栏的上传按钮
blockShorts=switch, false, true, tag=隐藏Shorts按钮, desc=用于隐藏YouTube底栏的Shorts按钮
blockImmersive=switch, false, true, tag=隐藏选段按钮, desc=用于隐藏YouTube Music底栏的选段按钮
blockGaming=switch, true, true, tag=清除游戏大本营, desc=移除首页/信息流里的「YouTube 游戏大本营」模块（YouTube Playables 小程序面板）
blockAds=switch, true, true, tag=过滤信息流广告, desc=删除首页信息流里的赞助内容（pagead 判据），与「清除游戏大本营」互不影响
captionLang=select, "zh-Hans", "zh-Hant", "ja", "ko", "en", "off", tag=字幕翻译语言, desc=精简版不支持字幕翻译，请改用完整版
debug=switch, false, true, tag=启用调试模式, desc=此插件的调试模式

[Script]
http-response ^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/(browse|next)(\?(.*))?$ script-path=https://raw.githubusercontent.com/Savues/loon-plugin-patches/main/plugins/YouTube-Dedup/src/feed-gaming.js?v=57, requires-body=true, binary-body-mode=true, argument=[{blockGaming},{blockAds},{debug}], tag=清除游戏大本营
http-response ^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/(player|search|reel\/reel_watch_sequence|guide|account\/get_setting|get_watch)(\?(.*))?$ script-path=https://kelee.one/Resource/JavaScript/YouTube/YouTube_remove_ads/YouTube_remove_ads_response.js, requires-body=true, binary-body-mode=true, argument=[{blockUpload},{blockShorts},{blockImmersive},{captionLang},{debug},{blockGaming}], tag=YouTube去广告

http-response ^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/config(\?(.*))?$ script-path=https://raw.githubusercontent.com/Savues/loon-plugin-patches/main/plugins/YouTube-Dedup/src/config-onesie.js, requires-body=true, binary-body-mode=true, tag=采集onesie密钥

http-request ^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/log_event script-path=https://kelee.one/Resource/JavaScript/YouTube/YouTube_remove_ads/YouTube_remove_ads_request.js, requires-body=true, binary-body-mode=true, argument=[{blockUpload},{blockShorts},{blockImmersive},{captionLang},{debug},{blockGaming}], tag=请求日志事件

[MitM]
hostname=youtubei.googleapis.com
#
#
#
#
# ==== PLUGIN_VERSION: 5.7.0 | BUILD_BY: Savues | 仓库: https://github.com/Savues/loon-plugin-patches ====
#
# 【v5.7.0：合集退场后信息流广告反弹，补上广告判据】
#   2026-09-29 07:31 的抓包证实：合集的 YouTube 规则退场后，首页广告暴涨。
#   那些广告是**整段的 feed section**（140~180 KB，含 pagead 与「赞助」标签，
#   每段 3 条广告素材），而 browse/next 当时只由「清游戏大本营」的脚本处理，
#   它不删广告 —— 于是全部漏网。
#
#   现在自研脚本同时清两样：
#     · 游戏大本营：mini_app_panel / FEmini_apps_saved
#     · 信息流广告：pagead（YouTube 内部广告标识，与上游 ni() 同一个）
#                   或 EML 名 inline_injection_entrypoint_layout
#   两类判据共用开头那一遍扫描（hitPanel / hitAd 两个有序数组），
#   所以加广告判据几乎不花时间。blockGaming 与 blockAds 可分别关闭。
#
#   判据精度（实测）：广告段 赞助x3、/vi/ 0~1 个（那是广告素材自己的 ID）；
#   正常段 赞助x0、/vi/ 15 个。pagead 在前六份抓包里一次都没出现过。
#   误伤防护：已删掉一版「按 EML 名删 Shorts」的规则 —— 从 EML 名往回反查 64 字节
#   太松，实测把正常视频卡也删了。宁可少删，不可误伤。
#
#   七份抓包共 68 条 browse/next 全部重跑：改写后 pagead+赞助 出现次数 73 -> 25，
#   上游脚本能解析全部 68 条输出。回归测试 31 例。
#
# 【还没覆盖的：next（信息流续页）里的广告】
#   那里的广告不是「重复列表项」，而是**单例**顶层字段（每条 next 响应里 2 个，
#   字段号 14/15，里面各塞 3~5 条广告素材）。现有判据只删重复元素，够不着。
#   实测这 5 条 next 响应里 39 处判据未被清除。要做需要单独处理单例容器，
#   风险是误删同容器里的正常内容，不在本次范围。
#
# 【规则顺序（v5.4 起，未变）】
#   Loon 的 [Script] 是 first-match-wins，同一 URL 只执行第一条完整命中的规则。
#   「清除游戏大本营」排在去广告规则之前，上游规则里移除 browse|next。
#   合集侧已由 BlockAds-Patched 把 YouTube 部分整体退场，两边不会抢。
#
# 【怎么确认脚本在跑】
#   首次成功清理后弹一次「游戏大本营 · 已生效 脚本 v5.7」；之后不再重复弹。
#   打开「启用调试模式」则每次都报：done / clean / nomatch / off。
