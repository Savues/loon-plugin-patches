#!name=AgentRouter签到 v1.13
#!desc=每日自动签到，查看奖励与余额。修改版：【自动签到默认关闭】多设备只需一台打开，关着时仍可在插件页手动触发；通知按 iOS 三层重排（顶栏身份 / 标题奖励 / 正文余额+公告）；修三处上游缺陷：奖励金额识别不出来、日志未落库误报「待确认」、排版被时间戳挤掉。不解密任何域名，不用装根证书。
#!author=原作者: 773075692, MaYIHEI | 修改版: Savues <https://github.com/Savues/loon-plugin-patches>
#!homepage=https://github.com/Savues/loon-plugin-patches/tree/main/plugins/AgentRouter
#!icon=https://raw.githubusercontent.com/MaYIHEI/paperclip/refs/heads/main/app/agentrouter/icon.png
#!date=2026-10-01 10:05:00
#!tag=签到

[Argument]
username = input,"",tag=账号,desc=网站账号或邮箱
password = input,"",tag=密码,desc=网站登录密码
accounts = input,"",tag=多账号（JSON）,desc=选填；填写后优先使用列表；格式见插件主页
debug = switch,false,tag=调试模式,desc=仅记录请求状态和签到判定
auto = switch,false,tag=每日自动签到,desc=默认关闭；多设备只需一台打开。关着时仍可在插件页手动触发这条 cron

[Script]
cron "0 9 * * *" script-path=https://raw.githubusercontent.com/Savues/loon-plugin-patches/main/plugins/AgentRouter/src/agentrouter.js, argument=[{username},{password},{accounts},{debug}], tag=AgentRouter签到, timeout=300, img-url=https://raw.githubusercontent.com/MaYIHEI/paperclip/refs/heads/main/app/agentrouter/icon.png, enable={auto}
