#!name=美团去广告 v1.6.1
#!desc=拦截广告与营销内容：我的页会员营销（每日领券/营销横幅）、弹窗族（会员活动/运营活动/问卷/直播券/酒店）、消息横幅、DSP抽奖红包、信息流广告物料与营销素材；并清洗horn远程配置134个开关（开屏/弹窗/悬浮窗/券弹层/小说广告/灵犀广告/快手SDK/信息流广告位/酒店营销/首页营销卡片/引导动画），以及隐私采集与遥测上报全关（截图上传/设备指纹/Beacon+WiFi/请求异常上报/Logan+Raptor/midas监控）。
#!author=@Savues <https://github.com/Savues>
#!homepage=https://github.com/Savues/loon-plugin-patches/tree/main/plugins/Meituan-AdBlock
#!version=1.6.1
#!icon=https://raw.githubusercontent.com/Savues/loon-plugin-patches/main/plugins/Meituan-AdBlock/icon/icon.png
#!tag=去广告
#!loon_version=3.5.1(998)
#!date=2026-10-29 02:10:00

[Argument]
memberLevel = select,"不修改","1","2","3","4","5","6",tag=会员等级显示,desc=自定义客户端显示的会员等级：1普通/2白银/3黄金/4白金/5黑金/6黑钻。⚠️仅改客户端显示，服务端仍为真实等级——领券/权益/下单校验以服务端为准，可能出现"等级不足"提示。选"不修改"则不生效
growthValue = input,"",tag=成长值自定义,desc=留空则自动用所选等级的起点值（如 V6=30000）。填数字则使用该值。建议填大于等级起点的数（如 V6 填 35000），避免前端用成长值反算等级时回落。⚠️仅客户端显示

[Rewrite]
# 版本探针 v2 (version-probe.sh 用, 勿删)
request if ${url} ~= /^https?:\/\/market\.waimai\.meituan\.com\/gw\/loon-sim\.probe\.meituan_remove_ads/i then reject(200, "1.6.1")
# === 我的页会员营销 (market.waimai 实证明文 JSON, 2026-10-25 HAR) ===
# ⚠️ 2026-10-29 修正：以下 3 条原为 reject_dict(200)，导致会员页「活动太火爆」——
#   dailyMagicalCoupon / featuredActivity / SLevelBanner 的正常响应都带
#   {"code":0,"message":"成功","data":{...}}，返回 {} 后前端判定接口异常。
#   其中 SLevelBanner 还含 ifMember/memberLevel（会员身份），必须放行。
#   现改为响应侧清洗（见 [Script] member_marketing_clean.js），SLevelBanner 直接放行。

# === 营销素材 CDN (picasso-ad 路径族) ===
request if ${url} ~= /\/picasso-ad-pegasus\//i then reject

# === 弹窗/运营位 (2026-10-25 HAR 实证) ===
# ⚠️ 2026-10-29 修正：member/activity/api/expose 原为 reject_dict(200) —— 接口名像"曝光上报"，
#   实际返回 userMemberLevel（会员等级）+ userSurpriseScoreInfo（惊喜值）
#   + productList（惊喜多选一奖品）+ consumptionPlanProductList，是会员页核心数据源。已放行。
# topcube 活动详情 (运营活动弹层)
request if ${url} ~= /^https?:\/\/i\.meituan\.com\/topcube\/api\/toc\/base\/activity\//i then reject_dict(200)
# 问卷弹窗
request if ${url} ~= /^https?:\/\/cem\.meituan\.com\/survey\/detail/i then reject_dict(200)

# === 开屏素材断供 (2026-10-25 沙盒+HAR 实证) ===
# 开屏数据走 mobile.launch.* 长连接 (不可达), 素材走 flowplus 专属域 — 断素材则新开屏图无图可显
# (p0/linglong 普通运营图路径不拦, 防误伤; flowplus 仅启动图场景出现)
request if ${url} ~= /^https?:\/\/flowplus\.meituan\.net\//i then reject

# === 逆向深挖弹窗族 (2026-10-25 二进制, 语义明确即拦) ===
# 直播优惠券活动弹窗
request if ${url} ~= /^https?:\/\/mlive\.dianping\.com\/api\/mlive\/promotion\/mlivecouponactivitypopup/i then reject_dict(200)
# 消息页横幅 ×3
request if ${url} ~= /^https?:\/\/mtmessage\.meituan\.com\/api\/banner\//i then reject_dict(200)
# DSP 抽奖/新人红包
request if ${url} ~= /^https?:\/\/apimobile\.meituan\.com\/dsp\//i then reject_dict(200)
# deal 信息流广告物料 (.bin)
request if ${url} ~= /^https?:\/\/mapi\.meituan\.com\/baymax\/mtbizer\/mtdealad/i then reject_dict(200)
# 券横幅 (.bin)
request if ${url} ~= /^https?:\/\/mapi\.meituan\.com\/general\/platform\/mtlist\/couponbanner/i then reject_dict(200)
# 酒店弹窗
request if ${url} ~= /^https?:\/\/apihotel\.meituan\.com\/api\/popup\//i then reject_dict(200)
# 用户弹窗按钮配置
request if ${url} ~= /^https?:\/\/open\.meituan\.com\/user\/v1\/info\/(?:block-)?popup/i then reject_dict(200)

# === 开屏/信息流配套事件 (逆向实证接口, 长连接数据的 HTTP 侧增量) ===
request if ${url} ~= /^https?:\/\/contents\.meituan\.com\/commerce\/launch\/ad\/track/i then reject_dict(200)

[Script]
# horn 远程配置清洗: 广告/弹窗开关键反转
# 覆盖 horn_ios 全量(?id=) + 增量(/mergeRequest) 两种形态 — 2026-10-29 HAR 实证两者并存
response if ${url} ~= /^https?:\/\/(?:portal-portm|h)\.meituan\.com\/horn_ios/i then script("https://raw.githubusercontent.com/Savues/loon-plugin-patches/main/plugins/Meituan-AdBlock/src/horn_clean.js") with tag="horn配置清洗", requires_body=true

# 会员页营销数据清洗 (响应侧: 保留 code/message 结构, 只清空营销内容)
# dailyMagicalCoupon → data={}  featuredActivity → marketingResourceList=[]
# 覆盖 5 个下发会员等级的接口 + 2 个营销接口 (同一响应只跑首个命中的 Script, 故合并为一个脚本)
response if ${url} ~= /^https?:\/\/(?:market\.waimai|member)\.meituan\.com\/member\/(?:homepage\/(?:query|products\/recommend\/v3\/query|marketing\/(?:featuredActivity|SLevelBanner)|dailyMagicalCoupon)|activity\/api\/expose)/i then script("https://raw.githubusercontent.com/Savues/loon-plugin-patches/main/plugins/Meituan-AdBlock/src/member_marketing_clean.js", {${memberLevel}, ${growthValue}}) with tag="会员页清洗+等级/成长值自定义", requires_body=true

[MitM]
hostname=market.waimai.meituan.com, contents.meituan.com, p0.meituan.net, w.meituan.net, flowplus.meituan.net, member.meituan.com, i.meituan.com, cem.meituan.com, mlive.dianping.com, mtmessage.meituan.com, apimobile.meituan.com, mapi.meituan.com, apihotel.meituan.com, open.meituan.com, portal-portm.meituan.com, h.meituan.com
