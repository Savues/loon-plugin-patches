#!name= 迅雷云盘·外部播放器 v1.2.1
#!desc=检测迅雷云盘视频页直链并弹出通知，一键跳转到第三方播放器（Infuse/VLC/nPlayer 等）播放。
#!author=@Savues <https://github.com/Savues>
#!homepage= https://github.com/Savues/loon-plugin-patches
#!icon= https://raw.githubusercontent.com/luongz/loon-plugins/main/icons/xunlei.png
#!date= 2026-10-12 23:15:00

[Argument]
player = select,"Safari","SenPlayer","Forward","Filebar","Alook","nPlayer","Infuse","VLC","IINA","MPV","Custom",tag=播放器,desc=选择要跳转的播放器
custom_scheme = text,,tag=自定义Scheme,desc=选择 Custom 时填入，如 myplayer://play?url= (必须包含 ://)
notify_title = text,🎬 迅雷云盘视频,tag=通知标题
notify_body = text,点击在外部播放器打开,tag=通知内容
auto_copy = switch,false,true,tag=自动复制链接,desc=同时复制视频链接到剪贴板

[Script]
http-response ^https://vod.*-vip-lixian\.xunlei\.com/download/.*$ script-path=https://raw.githubusercontent.com/Savues/loon-plugin-patches/main/plugins/Xunlei-Player/src/xunlei-player.js?v=121, requires-body=0, timeout=10, tag=迅雷云盘_视频直链检测, argument=[{player},{custom_scheme},{notify_title},{notify_body},{auto_copy}]
http-request ^https://vod.*-vip-lixian\.xunlei\.com/download/.*$ script-path=https://raw.githubusercontent.com/Savues/loon-plugin-patches/main/plugins/Xunlei-Player/src/xunlei-player-probe.js?v=121, requires-body=0, timeout=5, tag=迅雷云盘_请求探针, argument=[{player},{custom_scheme},{notify_title},{notify_body},{auto_copy}]

[MitM]
hostname = vod*-vip-lixian.xunlei.com