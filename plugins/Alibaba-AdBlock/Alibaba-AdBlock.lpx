# TODO: 在 Rewrite 中添加

# TODO: 天猫/淘宝主版/淘宝直播/特价版特有接口待补充

[Rewrite]
# === 埋点/错误上报/APM/实验分流 —— 直接 Reject ===
^https?://gm\.mmstat\.com/ reject, enable={blockTracking}
^https?://log\.mmstat\.com/ reject, enable={blockTracking}
^https?://s-gm\.mmstat\.com/ reject, enable={blockTracking}
^https?://px\.effirst\.com/ reject, enable={blockTracking}
^https?://abtest\.alibaba\.com/ reject, enable={blockTracking}
^https?://tlog\.mmstat\.com/ reject, enable={blockTracking}

# === 广告投放/埋点域名 (kelee.one + 反编译) —— 直接 Reject ===
^https?://adashx\.m\.taobao\.com/ reject, enable={blockTracking}
^https?://h-adashx\.ut\.taobao\.com/ reject, enable={blockTracking}
^https?://ut\.taobao\.com/ reject, enable={blockTracking}
^https?://ossgw\.alicdn\.com/ reject, enable={blockTracking}
^https?://ems\.youku\.com/ reject, enable={blockTracking}
^https?://hudong\.alicdn\.com/ reject, enable={blockTracking}

# === 闲鱼专用开屏/启动广告上报 (反编译发现) —— 直接 Reject ===
^https?://acs\.m\.goofish\.com\/gw\/mtop\.idle\.ad\.click/ reject, enable={blockTracking}
^https?://acs\.m\.goofish\.com\/gw\/mtop\.idle\.ad\.expose/ reject, enable={blockTracking}
^https?://acs\.m\.goofish\.com\/gw\/mtop\.idle\.ad\.failed\.batch\.click/ reject, enable={blockTracking}
^https?://acs\.m\.goofish\.com\/gw\/mtop\.idle\.ad\.failed\.batch\.expose/ reject, enable={blockTracking}
^https?://acs\.m\.goofish\.com\/gw\/mtop\.idle\.idleadv\.app\.launch\.redirect/ reject, enable={blockTracking}
^https?://acs\.m\.goofish\.com\/gw\/mtop\.idle\.idleadv\.app\.launch\.report/ reject, enable={blockTracking}
^https?://acs\.m\.goofish\.com\/gw\/mtop\.idle\.idleadv\.code\.restore/ reject, enable={blockTracking}
^https?://acs\.m\.goofish\.com\/gw\/mtop\.idle\.idleadv\.scene\.restore/ reject, enable={blockTracking}
^https?://acs\.m\.goofish\.com\/gw\/mtop\.idle\.idleadv\.xyflowin\.upload/ reject, enable={blockTracking}

# 可选：保留阿里妈妈其他正常 API 不解密（如需可取消注释）
# DOMAIN-SUFFIX, afpapi.alimama.com, REJECT

[Task]
# 无定时任务