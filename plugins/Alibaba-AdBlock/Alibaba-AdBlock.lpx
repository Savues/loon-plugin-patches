# TODO: 天猫/淘宝主版/淘宝直播/特价版特有接口待补充

[Rewrite]
# === 热启动开屏广告图片 (kelee 实证规则: 1080/1125 全屏尺寸广告素材, 含双11促销开屏图) ===
request if ${url} ~= /^https?:\/\/(?:gw|heic)\.alicdn\.com\/imgextra\/i\d\/\d*\/?[\w!]+-\d-(?:octopus|tps)-(?:1080|1125)-\d{4}\.(?:jpg|png)_(?:1\d{3}|9\d{2})x(?:\d|1\d{3}|9\d{2})q[59]0/i then reject_dict(200)

# === 开屏数据/弹窗营销接口 (kelee reject, 返回空 JSON 200) ===
request if ${url} ~= /mtop\.xsd\.searchbar\.info\.get/i then reject_dict(200)
request if ${url} ~= /mtop\.relationrecommend\./i then reject_dict(200)
request if ${url} ~= /mtop\.taobao\.wsearch\.commonApi/i then reject_dict(200)
