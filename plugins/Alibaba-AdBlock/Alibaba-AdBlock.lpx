# TODO: 天猫/淘宝主版/淘宝直播/特价版特有接口待补充

[Rewrite]
# === 埋点/错误上报/APM/实验分流 —— 直接 Reject (简化正则，仅匹配域名) ===
request if ${url} ~= /gm\.mmstat\.com/i then reject, enable={blockTracking}
request if ${url} ~= /log\.mmstat\.com/i then reject, enable={blockTracking}
request if ${url} ~= /s-gm\.mmstat\.com/i then reject, enable={blockTracking}
request if ${url} ~= /px\.effirst\.com/i then reject, enable={blockTracking}
request if ${url} ~= /abtest\.alibaba\.com/i then reject, enable={blockTracking}
request if ${url} ~= /tlog\.mmstat\.com/i then reject, enable={blockTracking}

# === 广告投放/埋点域名 —— 直接 Reject ===
request if ${url} ~= /adashx\.m\.taobao\.com/i then reject, enable={blockTracking}
request if ${url} ~= /h-adashx\.ut\.taobao\.com/i then reject, enable={blockTracking}
request if ${url} ~= /ut\.taobao\.com/i then reject, enable={blockTracking}
request if ${url} ~= /ossgw\.alicdn\.com/i then reject, enable={blockTracking}
request if ${url} ~= /ems\.youku\.com/i then reject, enable={blockTracking}
request if ${url} ~= /hudong\.alicdn\.com/i then reject, enable={blockTracking}
request if ${url} ~= /hudong\.tbcdn\.cn/i then reject, enable={blockTracking}

# === 闲鱼专用开屏/启动广告上报 —— 直接 Reject ===
request if ${url} ~= /acs\.m\.goofish\.com\/gw\/mtop\.idle\.ad\./i then reject, enable={blockTracking}
request if ${url} ~= /acs\.m\.goofish\.com\/gw\/mtop\.idle\.idleadv\./i then reject, enable={blockTracking}

# === 兜底：DOMAIN-SUFFIX 风格 (Loon 原生支持，最高优先级) ===
DOMAIN-SUFFIX, gm.mmstat.com, REJECT, enable={blockTracking}
DOMAIN-SUFFIX, log.mmstat.com, REJECT, enable={blockTracking}
DOMAIN-SUFFIX, s-gm.mmstat.com, REJECT, enable={blockTracking}
DOMAIN-SUFFIX, px.effirst.com, REJECT, enable={blockTracking}
DOMAIN-SUFFIX, abtest.alibaba.com, REJECT, enable={blockTracking}
DOMAIN-SUFFIX, tlog.mmstat.com, REJECT, enable={blockTracking}
DOMAIN-SUFFIX, adashx.m.taobao.com, REJECT, enable={blockTracking}
DOMAIN-SUFFIX, h-adashx.ut.taobao.com, REJECT, enable={blockTracking}
DOMAIN-SUFFIX, ut.taobao.com, REJECT, enable={blockTracking}
DOMAIN-SUFFIX, ossgw.alicdn.com, REJECT, enable={blockTracking}
DOMAIN-SUFFIX, ems.youku.com, REJECT, enable={blockTracking}
DOMAIN-SUFFIX, hudong.alicdn.com, REJECT, enable={blockTracking}
DOMAIN-SUFFIX, hudong.tbcdn.cn, REJECT, enable={blockTracking}

# 可选：保留阿里妈妈其他正常 API 不解密（如需可取消注释）
# request if ${url} ~= /afpapi\.alimama\.com/i then reject, enable={blockTracking}

[Task]
# 无定时任务