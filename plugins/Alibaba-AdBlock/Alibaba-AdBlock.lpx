response if ${url} ~= /^https?:\/\/acs\.m\.goofish\.com\/gw\/mtop\.taobao\.idlehome\.home\.community/i then script("https://raw.githubusercontent.com/Savues/loon-plugin-patches/main/plugins/Alibaba-AdBlock/src/bundle.js", {${fishRemoveHomeAds}}) with enable=${fishRemoveHomeAds}, requires_body=true, tag="闲鱼-社区"
response if ${url} ~= /^https?:\/\/acs\.m\.goofish\.com\/gw\/mtop\.taobao\.idlehome\.home\.newitem\.page/i then script("https://raw.githubusercontent.com/Savues/loon-plugin-patches/main/plugins/Alibaba-AdBlock/src/bundle.js", {${fishRemoveHomeAds}}) with enable=${fishRemoveHomeAds}, requires_body=true, tag="闲鱼-新商品页"
response if ${url} ~= /^https?:\/\/acs\.m\.goofish\.com\/gw\/mtop\.taobao\.idle\.local\.flow\.plat\.section/i then script("https://raw.githubusercontent.com/Savues/loon-plugin-patches/main/plugins/Alibaba-AdBlock/src/bundle.js", {${fishRemoveHomeAds}}) with enable=${fishRemoveHomeAds}, requires_body=true, tag="闲鱼-本地流量"
response if ${url} ~= /^https?:\/\/acs\.m\.goofish\.com\/gw\/mtop\.taobao\.idle\.local\.home\.top/i then script("https://raw.githubusercontent.com/Savues/loon-plugin-patches/main/plugins/Alibaba-AdBlock/src/bundle.js", {${fishRemoveHomeAds}}) with enable=${fishRemoveHomeAds}, requires_body=true, tag="闲鱼-本地顶部"
response if ${url} ~= /^https?:\/\/acs\.m\.goofish\.com\/gw\/mtop\.taobao\.idle\.local\.home/i then script("https://raw.githubusercontent.com/Savues/loon-plugin-patches/main/plugins/Alibaba-AdBlock/src/bundle.js", {${fishRemoveHomeAds}}) with enable=${fishRemoveHomeAds}, requires_body=true, tag="闲鱼-本地首页"
response if ${url} ~= /^https?:\/\/acs\.m\.goofish\.com\/gw\/mtop\.idle\.user\.page\.my\.adapter/i then script("https://raw.githubusercontent.com/Savues/loon-plugin-patches/main/plugins/Alibaba-AdBlock/src/bundle.js", {${fishRemoveMyPage}}) with enable=${fishRemoveMyPage}, requires_body=true, tag="闲鱼-我的页面"
response if ${url} ~= /^https?:\/\/acs\.m\.goofish\.com\/gw\/mtop\.taobao\.idlehome\.home\.circle\.list/i then script("https://raw.githubusercontent.com/Savues/loon-plugin-patches/main/plugins/Alibaba-AdBlock/src/bundle.js", {${fishRemoveHomeAds}}) with enable=${fishRemoveHomeAds}, requires_body=true, tag="闲鱼-圈子列表"
response if ${url} ~= /^https?:\/\/acs\.m\.goofish\.com\/gw\/mtop\.taobao\.idlehome\.magic\.home\.page\.list/i then script("https://raw.githubusercontent.com/Savues/loon-plugin-patches/main/plugins/Alibaba-AdBlock/src/bundle.js", {${fishRemoveHomeAds}}) with enable=${fishRemoveHomeAds}, requires_body=true, tag="闲鱼-魔法首页"
response if ${url} ~= /^https?:\/\/g-acs\.m\.goofish\.com\/gw\/mtop\.taobao\.idlemtopsearch\.search/i then script("https://raw.githubusercontent.com/Savues/loon-plugin-patches/main/plugins/Alibaba-AdBlock/src/bundle.js", {${fishRemoveSearchAds}}) with enable=${fishRemoveSearchAds}, requires_body=true, tag="闲鱼-搜索去广告"
response if ${url} ~= /^https?:\/\/acs\.m\.goofish\.com\/gw\/mtop\.taobao\.idlemtopsearch\.search\.discover/i then script("https://raw.githubusercontent.com/Savues/loon-plugin-patches/main/plugins/Alibaba-AdBlock/src/bundle.js", {${fishRemoveSearchAds}}) with enable=${fishRemoveSearchAds}, requires_body=true, tag="闲鱼-搜索发现"
response if ${url} ~= /^https?:\/\/acs\.m\.goofish\.com\/gw\/mtop\.taobao\.idlemtopsearch\.item\.search\.activate/i then script("https://raw.githubusercontent.com/Savues/loon-plugin-patches/main/plugins/Alibaba-AdBlock/src/bundle.js", {${fishRemoveSearchAds}}) with enable=${fishRemoveSearchAds}, requires_body=true, tag="闲鱼-搜索激活"
response if ${url} ~= /^https?:\/\/acs\.m\.goofish\.com\/gw\/mtop\.taobao\.idle\.trade\.full\.info/i then script("https://raw.githubusercontent.com/Savues/loon-plugin-patches/main/plugins/Alibaba-AdBlock/src/bundle.js", {${fishRemoveMyPage}}) with enable=${fishRemoveMyPage}, requires_body=true, tag="闲鱼-交易详情"

# TODO: 天猫/淘宝主版/淘宝直播/特价版特有接口待补充


[Rewrite]
# 版本探针 v2 (version-probe.sh 用, 勿删)
request if ${url} ~= /^https?:\/\/(?:acs|guide-acs)\.m\.taobao\.com\/gw\/loon-sim\.probe\.alibaba-adblock/i then reject(200, "3.41.0")
# === 淘宝弹窗闸门与营销浮层 (v3.38.0 反编译发现) ===
# UCP 全局弹窗控制闸门: 客户端请求后按 checkResult 决定是否弹窗
#   拦掉 -> UCPCheckCodeInvalid -> checkResult:false -> 弹窗被抑制
#   (字符串证据: UCPCheckNotRequestEnd / UCPCheckFatigueFailed / homePopRemovePopWhenUCPCheckFailed)
request if ${url} ~= /mtop\.taobao\.auge\.delivery\.private\.popup\.control/i then reject_dict(200)
# 生活圈 LBS 推荐横幅 / 入口 (newhaven)
request if ${url} ~= /mtop\.taobao\.newhaven\.lbsgroup\.banner\./i then reject_dict(200)
request if ${url} ~= /mtop\.taobao\.newhaven\.life\.entrance\.show/i then reject_dict(200)
# 社交弹窗
request if ${url} ~= /mtop\.taobao\.social\.pop\.get/i then reject_dict(200)

# === 热启动开屏广告图片 (kelee 实证规则: 1080/1125 全屏尺寸广告素材, 含双11促销开屏图) ===
request if ${url} ~= /^https?:\/\/(?:gw|heic)\.alicdn\.com\/imgextra\/i\d\/\d*\/?[\w!]+-\d-(?:octopus|tps)-(?:1080|1125)-\d{4}\.(?:jpg|png)_(?:1\d{3}|9\d{2})x(?:\d|1\d{3}|9\d{2})q[59]0/i then reject_dict(200)

# === 启动页活动专用图 (反编译 TBBootImage 内置配置实证: tps-{宽}-1624 全屏高, APNG/PNG) ===
# 全屏启动图/开屏广告素材
#   高度 1600+ (淘宝 iPhone14=1624 / ProMax=2208-2244) 才是开屏图
# ★ 排除 1200-1599: 联盟首页背景图是 tps-750-1200.png (metax fields.backgroundImageUrl), 属正常业务
# ★ 域名只限 gw/heic: img.alicdn.com 上的 tps-1080-2872.png_q50.jpg 也是首页背景, 不能拦
request if ${url} ~= /^https?:\/\/(?:gw|heic)\.alicdn\.com\/imgextra\/.*-tps-\d+-(?:1[6-9]\d\d|[2-9]\d{3})\.(?:apng|png|jpg|jpeg|webp)/i then reject_dict(200)

# === 双11摇一摇启动页广告 (沙盒 bootImageDatas/biz=Launcher 实证, 800x800 素材, 活动期 10/19-11/9) ===
request if ${url} ~= /O1CN01xvtBxdhcjQF1chua|O1CN01YelGPQ24a0Mo9ODI6/i then reject_dict(200)

# === 开屏数据/弹窗营销接口 (kelee reject, 返回空 JSON 200) ===
request if ${url} ~= /mtop\.xsd\.searchbar\.info\.get/i then reject_dict(200)
request if ${url} ~= /mtop\.taobao\.clientpaas\.spotlightsearch\.get/i then reject_dict(200)
request if ${url} ~= /mtop\.relationrecommend\./i then reject_dict(200)
request if ${url} ~= /mtop\.taobao\.wsearch\.common(Api)?/i then reject_dict(200)
request if ${url} ~= /mtop\.taobao\.wireless\.home\.newface\.stream\./i then reject_dict(200)
# 用完整组件名做子串匹配 (覆盖三种资源形式: muise/main.v20.wlm / weex/home.v20.wlm / ms_xxx@ver.wlm 资源包)
# 安全: 三个完整组件名均不出现在 searchBoxUrl 等点击目标中 (已用 gateway 缓存验证, 不会误伤搜索栏)
request if ${url} ~= /search_door_trending_nine_square_gridList/i then reject_dict(200)
request if ${url} ~= /search_door_guess_discovery/i then reject_dict(200)
request if ${url} ~= /search_door_trending_hot_textList/i then reject_dict(200)

# === 搜索框轮播词: 拒绝容器模板 -> DX 容器失败 -> 原生搜索栏 fallback (空白+可点+无词) ===
request if ${url} ~= /m_h_v7_uone_second_pit_searchbar_slim_protocol_version/i then reject_dict(200)

# === 小时级分发 (hourly delivery) — 搜索框轮播词的定时下发源 (反编译: hourlyDeleviry ... request fail 容忍失败) ===
request if ${url} ~= /mtop\.taobao\.hourly\.delivery\.config\./i then reject_dict(200)
request if ${url} ~= /hourly_arrv\./i then reject_dict(200)
request if ${url} ~= /^https?:\/\/poplayer\.template\.alibaba\.com\/[0-9a-f]{32}\.json/i then reject_dict(200)
request if ${url} ~= /^https?:\/\/(?:acs|guide-acs)\.m\.taobao\.com\/gw\/mtop\.taobao\.tab\.two\.guang\.live\.status/i then reject_dict(200)
request if ${url} ~= /^https?:\/\/(?:acs|guide-acs)\.m\.taobao\.com\/gw\/mtop\.iliad\.usertask\.tasks\.liveroom\.entry/i then reject_dict(200)
request if ${url} ~= /^https?:\/\/dinamicx\.alibabausercontent\.com\/(?:l_pub|pub)\/(m_home_campaign_bottom_bar|m_home_2025_1111_campaign_animation_mvp_card)/i then reject_dict(200)
request if ${url} ~= /^https?:\/\/guide-acs\.m\.taobao\.com\/gw\/mtop\.taobao\.wireless\.home\.splash\.awesome\.get/i then reject_dict(200)
request if ${url} ~= /^https?:\/\/guide-acs\.m\.taobao\.com\/gw\/mtop\.taobao\.wireless\.home\.newface\.awesome\.(get|newget)/i then reject_dict(200)
request if ${url} ~= /^https?:\/\/guide-acs\.m\.taobao\.com\/gw\/mtop\.taobao\.volvo\.secondfloor\.getconfig/i then reject_dict(200)
request if ${url} ~= /^https?:\/\/(?:acs|guide-acs)\.m\.taobao\.com\/gw\/mtop\.fliggy\.crm\.screen\.(allresource|predict)/i then reject_dict(200)
request if ${url} ~= /^https?:\/\/(?:acs|guide-acs)\.m\.taobao\.com\/gw\/mtop\.alibaba\.advertisementservice\.getadv/i then reject_dict(200)
request if ${url} ~= /^https?:\/\/(?:acs|guide-acs)\.m\.taobao\.com\/gw\/mtop\.alimama\.etao\.config\.query\/.+?etao_advertise/i then reject_dict(200)
request if ${url} ~= /^https?:\/\/(?:acs|guide-acs)\.m\.taobao\.com\/gw\/mtop\.alimusic\.common\.mobileservice\.startinit/i then reject_dict(200)
request if ${url} ~= /^https?:\/\/(?:acs|guide-acs)\.m\.taobao\.com\/gw\/mtop\.etao\.noah\.query\/.+?tao_splash/i then reject_dict(200)
request if ${url} ~= /^https?:\/\/(?:acs|guide-acs)\.m\.taobao\.com\/gw\/mtop\.film\.mtopadvertiseapi\.queryadvertise/i then reject_dict(200)
request if ${url} ~= /^https?:\/\/(?:acs|guide-acs)\.m\.taobao\.com\/gw\/mtop\.o2o\.ad\.gateway\.get/i then reject_dict(200)
request if ${url} ~= /^https?:\/\/(?:acs|guide-acs)\.m\.taobao\.com\/gw\/mtop\.taobao\.idle\.home\.welcome/i then reject_dict(200)
request if ${url} ~= /^https?:\/\/(?:acs|guide-acs)\.m\.taobao\.com\/gw\/mtop\.trip\.activity\.querytmsresources/i then reject_dict(200)

# === 开屏图接口 acs 变体 (guide-acs 之外的同接口) + 特价版运营触达 ===
request if ${url} ~= /mtop\.taobao\.wireless\.home\.splash\.awesome\.get/i then reject_dict(200)
request if ${url} ~= /mtop\.taobao\.wireless\.home\.newface\.awesome\.(get|newget)/i then reject_dict(200)
request if ${url} ~= /mtop\.aplatform\.ltao\.get/i then reject
request if ${url} ~= /mtop\.taote\.useroperation\.(getubaplaninfo|outsidetouchmatch|touchmatch)/i then reject
request if ${url} ~= /mtop\.taote\.userflow\.peidecision/i then reject
request if ${url} ~= /mtop\.taote\.interaction\.conner\.application\.moveline\.jupipe/i then reject

# === 跨 App 广告/氛围/弹窗缺口补齐 (4 款 App 二进制覆盖审计) ===
# 闲鱼: 开屏广告体系 / 直播广告素材 / 鱼池弹窗
request if ${url} ~= /mtop\.taobao\.idlecommerce\.splash\./i then reject_dict(200)
request if ${url} ~= /mtop\.taobao\.idle\.live\.home\.ads\.material\.get/i then reject_dict(200)
request if ${url} ~= /mtop\.taobao\.idle\.fishpool\.poplayerinfo/i then reject_dict(200)
request if ${url} ~= /mtop\.taobao\.idlefish\.device\.log\.launch\.report/i then reject
# 天猫: 消息箱广告 / 开屏 / 首页氛围 / CPS 链接
request if ${url} ~= /mtop\.tmall\.messagebox\.(scr)?[Aa]dvert/i then reject_dict(200)
request if ${url} ~= /mtop\.tmall\.rpm\.splash\.query/i then reject_dict(200)
request if ${url} ~= /mtop\.tmall\.rpm\.homepage\.atmosphere\.query/i then reject_dict(200)
request if ${url} ~= /mtop\.tmall\.ad\.engine\.cps\.link\.convert/i then reject
# 淘宝直播: 弹窗投放系统 / 直播广告任务 / 启动屏 / 搜索氛围
# === 淘宝联盟/Moon 搜索域与营销位 ===
request if ${url} ~= /mtop\.taobao\.union\.marquee\.query/i then reject_dict(200)
request if ${url} ~= /mtop\.alimama\.union\.copilot\.api\./i then reject_dict(200)
request if ${url} ~= /mtop\.alimama\.union\.exp\.shunt/i then reject_dict(200)
request if ${url} ~= /mtop\.alimama\.moon\.adzone\.default\.get/i then reject_dict(200)
# === 第三方广告监测/投放平台 (云袭 yunxish + igrowth: CPC服务广场/广告上报/埋点追踪) ===
request if ${url} ~= /^https?:\/\/(?:[a-z0-9-]+\.)?(?:yunxish\.com|iggrowth\.cn)\//i then reject
# === 直播开屏 banner + 视频广告 + 第三方广告上报 ===
request if ${url} ~= /mtop\.taobao\.hector\.live\.openpage\.banner/i then reject_dict(200)
request if ${url} ~= /mtop\.taobao\.livex\.vcore\.recommend\.video\.ad\.query/i then reject_dict(200)
request if ${url} ~= /mtop\.taobao\.livex\.business\.third\.ad\./i then reject_dict(200)
# === 直播浮层/弹窗体系 (skylar_hummer_* = 直播间营销浮层: 召回弹窗/催单/福利/活动) ===
request if ${url} ~= /\/skylar_hummer_/i then reject_dict(200)
# === 直播增长广告位 (grow.task.feed / grow.playlet.task / grow.traffic) ===
request if ${url} ~= /mtop\.taobao\.livex\.grow\.(task|playlet|traffic)\./i then reject_dict(200)
# === 直播广告位配置/投放 (反编译 livex.business.ad.* + vcore 视频广告) ===
request if ${url} ~= /mtop\.taobao\.livex\.business\.(ad\.|complex\.ad\.|item\.supply\.ad\.|live\.ad\.)/i then reject_dict(200)
request if ${url} ~= /mtop\.taobao\.livex\.vcore\.recommend\..*\.video\.ad\.query/i then reject_dict(200)
# === 直播间弹窗推荐 (popview) + 增长弹窗 (pop) ===
request if ${url} ~= /mtop\.tblive\.recommend\.popview\./i then reject_dict(200)
request if ${url} ~= /mtop\.tblive\.growth\.api\.(benefit\.strategy\.issue|pop\.)/i then reject_dict(200)
request if ${url} ~= /mtop\.tblive\.live\.growth\.query/i then reject_dict(200)
# === 直播投放资源查询 + 礼物浮层 + o2o 广告网关 ===
request if ${url} ~= /mtop\.livex\.delivery\.resource\./i then reject_dict(200)
request if ${url} ~= /mtop\.iliad\.interact\.reward\.gift\.float\.layer/i then reject_dict(200)
request if ${url} ~= /mtop\.o2o\.ad\.gateway\./i then reject_dict(200)
request if ${url} ~= /mtop\.livex\.delivery\.poplayer\./i then reject_dict(200)
request if ${url} ~= /mtop\.taobao\.livex\.grow\.advertise\./i then reject_dict(200)
request if ${url} ~= /mtop\.taobao\.livexshow\.launchscreen\.pullResource/i then reject_dict(200)
request if ${url} ~= /mtop\.taobao\.livex\.vcore\.search\.searchAtmosphere/i then reject_dict(200)
# 跨 App 通用: 氛围资源 (节日皮肤) / 追踪队列 / 登录启动
request if ${url} ~= /mtop\.taobao\.wireless\.homepage\.loadAtmosphere/i then reject_dict(200)
request if ${url} ~= /mtop\.tblive\.live\.atmosphere\.resource\.list/i then reject_dict(200)
request if ${url} ~= /mtop\.tblive\.live\.detail\.sendUserAtmosphere/i then reject_dict(200)
request if ${url} ~= /mtop\.trace\.queue/i then reject
# 特价版: 淘特/淘宝特价运营上报
request if ${url} ~= /mtop\.gaia\.tjb\.growth\.union\.telattr/i then reject
request if ${url} ~= /mtop\.ltao\.growth\.report/i then reject
request if ${url} ~= /mtop\.taote\.useroperation\.reportloginresource/i then reject
request if ${url} ~= /mtop\.taote\.interaction\.ifgateway\.sharerewards/i then reject
# === 特价版: awesome/morning 闪屏全族 (2026-10-24 二进制预研 docs/Tmall-LTao-preliminary.md) ===
request if ${url} ~= /mtop\.taobao\.wireless\.home\.awesome\./i then reject_dict(200)
request if ${url} ~= /mtop\.taobao\.wireless\.home\.morning\./i then reject_dict(200)
request if ${url} ~= /mtop\.taobao\.wireless\.home\.newface\.morning\./i then reject_dict(200)
request if ${url} ~= /mtop\.taobao\.wireless\.home\.newface\.bottombar\.get/i then reject_dict(200)
# === 特价版: 推荐广告族 (Atlas) ===
request if ${url} ~= /mtop\.relationrecommend\.newfacerecommend\./i then reject_dict(200)
# === 天猫: RPM 浮层/购物车秀/猜你喜欢弹卡 (预置, 待实测) ===
request if ${url} ~= /mtop\.tmall\.rpm\.homepage\.bottom\.floatbar\./i then reject_dict(200)
request if ${url} ~= /mtop\.tmall\.rpm\.rate\.buyshow\./i then reject_dict(200)
request if ${url} ~= /mtop\.tmall\.rpm\.taste\./i then reject_dict(200)
# === 天猫: 开屏/热启动素材直拦 (15TUA=天猫投放素材库标识, 9/9 开屏素材命中, 84 张正常商品图 0 命中) ===
request if ${url} ~= /^https?:\/\/(?:gw|img)\.alicdn\.com\/imgextra\/.*15TUA/ then reject
# === 天猫搜索域 (2026-10-24 HAR 实证, 与打字联想 search.suggest 不同源, 可安全 reject) ===
# 搜索框滚动词 (result[0].showQuery 3词轮播)
