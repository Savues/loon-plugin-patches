#!name=Alibaba-AdBlock v2.5.0
#!desc=阿里系去广告 · 支持 Moon/淘宝/天猫/闲鱼/盒马/飞猪等 · 开屏/弹窗/小卡片/Feed/搜索推荐/跑马灯/TAC/NOAH/私域/埋点全拦截
#!system=ios
#!version=2.5.0
#!author=Savues <https://github.com/Savues>
#!homepage=https://github.com/Savues/loon-plugin-patches/tree/main/plugins/Alibaba-AdBlock

[MITM]
hostname = acs.m.taobao.com, guide-acs.m.taobao.com, cn-acs.m.taobao.com, acs.m.goofish.com, g-acs.m.goofish.com, acs.m.tmall.com, acs.m.alibaba.com, acs.m.hema.com, acs.m.fliggy.com, poplayer.template.alibaba.com, gm.mmstat.com, log.mmstat.com, s-gm.mmstat.com, px.effirst.com, abtest.alibaba.com, tlog.mmstat.com
h2 = true

[Argument]
# === 全局开关 ===
blockTracking = switch, true, false, tag=🔒埋点/APM/实验分流, desc=拦截 gm.mmstat.com / log.mmstat.com / px.effirst.com / abtest.alibaba.com / tlog.mmstat.com

# === 分类开关 (所有 App 生效) ===
removeSplashAd = switch, true, false, tag=🚫开屏广告, desc=拦截 open_screen_site (开屏图/跳转/倒计时)
removePopWindow = switch, true, false, tag=🚫弹窗广告, desc=拦截 pop_window_site (弹窗/浮层)
removeSmallCards = switch, true, false, tag=🚫小卡片/公告/推荐词, desc=拦截 small_handler_* / bulletin_board_* / marquee / TAC / NOAH / metax热词
removeNoahOps = switch, true, false, tag=🚫NOAH运营位, desc=拦截 noah.query 运营位 (moon_search_activation_dx_banner 等)
removeTAC = switch, true, false, tag=🚫TAC搜索推荐, desc=拦截 tac.service.call / smart.call 搜索框推荐词

# === Moon App 专属开关 ===
removeFeedKeywords = switch, false, true, tag=🌙Moon-清空首页Feed, desc=清空 Moon 首页推荐流所有商品 (metax homepage bodyList)
removePrivateDomain = switch, true, false, tag=🌙Moon-私域动态, desc=拦截 Moon 关注会员/私域动态 (union.pub.entry followMembers)

# === 淘宝/天猫专属开关 (预留) ===
# taobaoRemoveLiveAds = switch, true, false, tag=🛒淘宝-直播间广告, desc=拦截淘宝直播间广告
# taobaoRemoveGuessLike = switch, false, true, tag=🛒淘宝-猜你喜欢, desc=拦截淘宝首页猜你喜欢

[Script]
# === 批量广告分发 (Moon/淘宝/天猫/闲鱼通用) ===
response if ${url} ~= /acs\.m\.taobao\.com\/gw\/mtop\.alimama\.union\.skyleap\.distribution\.batchsite/i then script("https://raw.githubusercontent.com/Savues/loon-plugin-patches/main/plugins/Alibaba-AdBlock/src/bundle.js", {${removeSplashAd}, ${removePopWindow}, ${removeSmallCards}}) with tag="批量广告分发", requires_body=true

# === NOAH 运营位 (Moon/淘宝/天猫通用) ===
response if ${url} ~= /acs\.m\.taobao\.com\/gw\/mtop\.etao\.noah\.query/i then script("https://raw.githubusercontent.com/Savues/loon-plugin-patches/main/plugins/Alibaba-AdBlock/src/bundle.js", {${removeNoahOps}}) with tag="NOAH运营位", requires_body=true

# === TAC 搜索推荐 (通用) ===
response if ${url} ~= /acs\.m\.taobao\.com\/gw\/mtop\.alimama\.moon\.provider\.tac\.service\.call/i then script("https://raw.githubusercontent.com/Savues/loon-plugin-patches/main/plugins/Alibaba-AdBlock/src/bundle.js", {${removeTAC}}) with tag="搜索框推荐词-TAC基础", requires_body=true
response if ${url} ~= /acs\.m\.taobao\.com\/gw\/mtop\.alimama\.moon\.provider\.tac\.service\.smart\.call/i then script("https://raw.githubusercontent.com/Savues/loon-plugin-patches/main/plugins/Alibaba-AdBlock/src/bundle.js", {${removeTAC}}) with tag="搜索框推荐词-TAC智能", requires_body=true

# === 跨马灯热词 (通用) ===
response if ${url} ~= /acs\.m\.taobao\.com\/gw\/mtop\.taobao\.union\.marquee\.query/i then script("https://raw.githubusercontent.com/Savues/loon-plugin-patches/main/plugins/Alibaba-AdBlock/src/bundle.js", {${removeSmallCards}}) with tag="搜索框跑马灯热词", requires_body=true

# === MetaX 首页/Feed (Moon) ===
response if ${url} ~= /acs\.m\.taobao\.com\/gw\/mtop\.alimama\.moon\.provider\.metax\.homepage\.query/i then script("https://raw.githubusercontent.com/Savues/loon-plugin-patches/main/plugins/Alibaba-AdBlock/src/bundle.js", {${removeSmallCards}, ${removeFeedKeywords}}) with tag="首页搜索栏热词+清空Feed", requires_body=true

# === 私域动态/关注会员 (Moon) ===
response if ${url} ~= /acs\.m\.taobao\.com\/gw\/mtop\.alimama\.union\.pub\.entry/i then script("https://raw.githubusercontent.com/Savues/loon-plugin-patches/main/plugins/Alibaba-AdBlock/src/bundle.js", {${removePrivateDomain}}) with tag="私域动态/关注会员", requires_body=true

# === 淘宝开屏/弹窗 (kelee.one + 反编译) ===
response if ${url} ~= /poplayer\.template\.alibaba\.com/i then script("https://raw.githubusercontent.com/Savues/loon-plugin-patches/main/plugins/Alibaba-AdBlock/src/bundle.js", {${removeSplashAd}}) with tag="淘宝-开屏活动", requires_body=true
response if ${url} ~= /guide-acs\.m\.taobao\.com\/gw\/mtop\.taobao\.cloudvideo\.video\.query/i then script("https://raw.githubusercontent.com/Savues/loon-plugin-patches/main/plugins/Alibaba-AdBlock/src/bundle.js", {${removeSplashAd}}) with tag="淘宝-开屏视频", requires_body=true
response if ${url} ~= /guide-acs\.m\.taobao\.com\/gw\/mtop\.taobao\.wireless\.home\.splash\.awesome\.get/i then script("https://raw.githubusercontent.com/Savues/loon-plugin-patches/main/plugins/Alibaba-AdBlock/src/bundle.js", {${removeSplashAd}}) with tag="淘宝-开屏图片", requires_body=true

# === 淘宝弹窗/运营位 (Body Rewrite 兜底) ===
response if ${url} ~= /acs\.m\.taobao\.com\/gw\/mtop\.alibaba\.advertisementservice\.getadv/i then script("https://raw.githubusercontent.com/Savues/loon-plugin-patches/main/plugins/Alibaba-AdBlock/src/bundle.js", {${removePopWindow}}) with tag="淘宝-广告服务", requires_body=true
response if ${url} ~= /acs\.m\.taobao\.com\/gw\/mtop\.alimama\.etao\.config\.query/i then script("https://raw.githubusercontent.com/Savues/loon-plugin-patches/main/plugins/Alibaba-AdBlock/src/bundle.js", {${removePopWindow}}) with tag="淘宝-营销配置", requires_body=true
response if ${url} ~= /acs\.m\.taobao\.com\/gw\/mtop\.alimusic\.common\.mobileservice\.startinit/i then script("https://raw.githubusercontent.com/Savues/loon-plugin-patches/main/plugins/Alibaba-AdBlock/src/bundle.js", {${removePopWindow}}) with tag="淘宝-音乐初始化", requires_body=true
response if ${url} ~= /acs\.m\.taobao\.com\/gw\/mtop\.etao\.noah\.query/i then script("https://raw.githubusercontent.com/Savues/loon-plugin-patches/main/plugins/Alibaba-AdBlock/src/bundle.js", {${removeNoahOps}, ${removePopWindow}}) with tag="淘宝-NOAH开屏", requires_body=true
response if ${url} ~= /acs\.m\.taobao\.com\/gw\/mtop\.film\.mtopadvertiseapi\.queryadvertise/i then script("https://raw.githubusercontent.com/Savues/loon-plugin-patches/main/plugins/Alibaba-AdBlock/src/bundle.js", {${removePopWindow}}) with tag="淘宝-影视广告", requires_body=true
response if ${url} ~= /acs\.m\.taobao\.com\/gw\/mtop\.o2o\.ad\.gateway\.get/i then script("https://raw.githubusercontent.com/Savues/loon-plugin-patches/main/plugins/Alibaba-AdBlock/src/bundle.js", {${removePopWindow}}) with tag="淘宝-O2O广告", requires_body=true
response if ${url} ~= /acs\.m\.taobao\.com\/gw\/mtop\.taobao\.idle\.home\.welcome/i then script("https://raw.githubusercontent.com/Savues/loon-plugin-patches/main/plugins/Alibaba-AdBlock/src/bundle.js", {${removePopWindow}}) with tag="淘宝-欢迎页", requires_body=true
response if ${url} ~= /acs\.m\.taobao\.com\/gw\/mtop\.trip\.activity\.querytmsresources/i then script("https://raw.githubusercontent.com/Savues/loon-plugin-patches/main/plugins/Alibaba-AdBlock/src/bundle.js", {${removePopWindow}}) with tag="淘宝-旅行活动", requires_body=true
response if ${url} ~= /guide-acs\.m\.taobao\.com\/gw\/mtop\.taobao\.volvo\.secondfloor\.getconfig/i then script("https://raw.githubusercontent.com/Savues/loon-plugin-patches/main/plugins/Alibaba-AdBlock/src/bundle.js", {${removePopWindow}}) with tag="淘宝-二楼配置", requires_body=true
response if ${url} ~= /guide-acs\.m\.taobao\.com\/gw\/mtop\.taobao\.wireless\.home\.newface\.awesome\.get/i then script("https://raw.githubusercontent.com/Savues/loon-plugin-patches/main/plugins/Alibaba-AdBlock/src/bundle.js", {${removePopWindow}}) with tag="淘宝-新面孔", requires_body=true

# === 闲鱼开屏/弹窗 (kelee.one + 反编译) ===
response if ${url} ~= /acs\.m\.goofish\.com\/gw\/mtop\.taobao\.idlecommerce\.splash\.ads/i then script("https://raw.githubusercontent.com/Savues/loon-plugin-patches/main/plugins/Alibaba-AdBlock/src/bundle.js", {${removeSplashAd}}) with tag="闲鱼-开屏广告", requires_body=true
response if ${url} ~= /acs\.m\.goofish\.com\/gw\/mtop\.taobao\.idle\.user\.strategy\.list/i then script("https://raw.githubusercontent.com/Savues/loon-plugin-patches/main/plugins/Alibaba-AdBlock/src/bundle.js", {${removePopWindow}}) with tag="闲鱼-用户策略", requires_body=true
response if ${url} ~= /acs\.m\.goofish\.com\/gw\/mtop\.taobao\.idle\.item\.recommend\.list/i then script("https://raw.githubusercontent.com/Savues/loon-plugin-patches/main/plugins/Alibaba-AdBlock/src/bundle.js", {${removePopWindow}}) with tag="闲鱼-商品推荐", requires_body=true
response if ${url} ~= /acs\.m\.goofish\.com\/gw\/mtop\.taobao\.idle\.local\.near\.by\.corner\.info/i then script("https://raw.githubusercontent.com/Savues/loon-plugin-patches/main/plugins/Alibaba-AdBlock/src/bundle.js", {${removePopWindow}}) with tag="闲鱼-附近角落", requires_body=true
response if ${url} ~= /acs\.m\.goofish\.com\/gw\/mtop\.taobao\.idle\.item\.buy\.feeds/i then script("https://raw.githubusercontent.com/Savues/loon-plugin-patches/main/plugins/Alibaba-AdBlock/src/bundle.js", {${removePopWindow}}) with tag="闲鱼-购买Feed", requires_body=true
response if ${url} ~= /acs\.m\.goofish\.com\/gw\/mtop\.taobao\.idlemtopsearch\.search\.shade/i then script("https://raw.githubusercontent.com/Savues/loon-plugin-patches/main/plugins/Alibaba-AdBlock/src/bundle.js", {${removePopWindow}}) with tag="闲鱼-搜索遮罩", requires_body=true
response if ${url} ~= /acs\.m\.goofish\.com\/gw\/mtop\.taobao\.idle\.playboy\.recommend/i then script("https://raw.githubusercontent.com/Savues/loon-plugin-patches/main/plugins/Alibaba-AdBlock/src/bundle.js", {${removePopWindow}}) with tag="闲鱼-玩家推荐", requires_body=true

# === 闲鱼首页/内容过滤 (kelee.one jq 规则移植为 JS) ===
response if ${url} ~= /acs\.m\.goofish\.com\/gw\/mtop\.taobao\.idlehome\.home\.nextfresh/i then script("https://raw.githubusercontent.com/Savues/loon-plugin-patches/main/plugins/Alibaba-AdBlock/src/bundle.js", {${removeSmallCards}}) with tag="闲鱼-首页刷新", requires_body=true
response if ${url} ~= /acs\.m\.goofish\.com\/gw\/mtop\.taobao\.idlehome\.widget\.refresh\.get/i then script("https://raw.githubusercontent.com/Savues/loon-plugin-patches/main/plugins/Alibaba-AdBlock/src/bundle.js", {${removeSmallCards}}) with tag="闲鱼-Widget刷新", requires_body=true
response if ${url} ~= /acs\.m\.goofish\.com\/gw\/mtop\.taobao\.idle\.home\.whale\.modulet/i then script("https://raw.githubusercontent.com/Savues/loon-plugin-patches/main/plugins/Alibaba-AdBlock/src/bundle.js", {${removeSmallCards}}) with tag="闲鱼-鲸鱼模块", requires_body=true
response if ${url} ~= /acs\.m\.goofish\.com\/gw\/mtop\.taobao\.idlehome\.home\.community/i then script("https://raw.githubusercontent.com/Savues/loon-plugin-patches/main/plugins/Alibaba-AdBlock/src/bundle.js", {${removeSmallCards}}) with tag="闲鱼-社区", requires_body=true
response if ${url} ~= /acs\.m\.goofish\.com\/gw\/mtop\.taobao\.idlehome\.home\.newitem\.page/i then script("https://raw.githubusercontent.com/Savues/loon-plugin-patches/main/plugins/Alibaba-AdBlock/src/bundle.js", {${removeSmallCards}}) with tag="闲鱼-新商品页", requires_body=true
response if ${url} ~= /acs\.m\.goofish\.com\/gw\/mtop\.taobao\.idle\.local\.flow\.plat\.section/i then script("https://raw.githubusercontent.com/Savues/loon-plugin-patches/main/plugins/Alibaba-AdBlock/src/bundle.js", {${removeSmallCards}}) with tag="闲鱼-本地流量", requires_body=true
response if ${url} ~= /acs\.m\.goofish\.com\/gw\/mtop\.taobao\.idle\.local\.home\.top/i then script("https://raw.githubusercontent.com/Savues/loon-plugin-patches/main/plugins/Alibaba-AdBlock/src/bundle.js", {${removeSmallCards}}) with tag="闲鱼-本地顶部", requires_body=true
response if ${url} ~= /acs\.m\.goofish\.com\/gw\/mtop\.taobao\.idle\.local\.home/i then script("https://raw.githubusercontent.com/Savues/loon-plugin-patches/main/plugins/Alibaba-AdBlock/src/bundle.js", {${removeSmallCards}}) with tag="闲鱼-本地首页", requires_body=true
response if ${url} ~= /acs\.m\.goofish\.com\/gw\/mtop\.idle\.user\.page\.my\.adapter/i then script("https://raw.githubusercontent.com/Savues/loon-plugin-patches/main/plugins/Alibaba-AdBlock/src/bundle.js", {${removeSmallCards}}) with tag="闲鱼-我的页面", requires_body=true
response if ${url} ~= /acs\.m\.goofish\.com\/gw\/mtop\.taobao\.idlehome\.home\.circle\.list/i then script("https://raw.githubusercontent.com/Savues/loon-plugin-patches/main/plugins/Alibaba-AdBlock/src/bundle.js", {${removeSmallCards}}) with tag="闲鱼-圈子列表", requires_body=true
response if ${url} ~= /acs\.m\.goofish\.com\/gw\/mtop\.taobao\.idlehome\.magic\.home\.page\.list/i then script("https://raw.githubusercontent.com/Savues/loon-plugin-patches/main/plugins/Alibaba-AdBlock/src/bundle.js", {${removeSmallCards}}) with tag="闲鱼-魔法首页", requires_body=true
response if ${url} ~= /g-acs\.m\.goofish\.com\/gw\/mtop\.taobao\.idlemtopsearch\.search/i then script("https://raw.githubusercontent.com/Savues/loon-plugin-patches/main/plugins/Alibaba-AdBlock/src/bundle.js", {${removeSmallCards}}) with tag="闲鱼-搜索去广告", requires_body=true
response if ${url} ~= /acs\.m\.goofish\.com\/gw\/mtop\.taobao\.idlemtopsearch\.search\.discover/i then script("https://raw.githubusercontent.com/Savues/loon-plugin-patches/main/plugins/Alibaba-AdBlock/src/bundle.js", {${removeSmallCards}}) with tag="闲鱼-搜索发现", requires_body=true
