#!name=Alibaba-AdBlock v3.41.0
#!desc=阿里系去广告 · 支持 Moon/淘宝/天猫/闲鱼/盒马/飞猪等 · 开屏/热启动广告/弹窗/双11氛围/小卡片/Feed/搜索推荐/TAC/NOAH/私域/埋点全拦截
#!system=iOS, iPadOS
#!version=3.41.0
#!author=Savues <https://github.com/Savues>
#!homepage=https://github.com/Savues/loon-plugin-patches/tree/main/plugins/Alibaba-AdBlock

[Argument]
# === 全局开关 ===
blockTracking = switch, true, false, tag=🔒埋点/APM/实验分流⚠️无效(域名规则), desc=拦截 gm.mmstat.com / log.mmstat.com / px.effirst.com / abtest.alibaba.com / tlog.mmstat.com ｜ ⚠️本插件中相关域名规则位于 [Rule] 段, Loon 该段不支持开关 → 规则无条件生效, 此开关无实际作用

# === 分类开关 (所有 App 生效) ===
removeSplashAd = switch, true, false, tag=🚫开屏广告, desc=拦截 open_screen_site (开屏图/跳转/倒计时)
removePopWindow = switch, true, false, tag=🚫弹窗广告, desc=拦截 pop_window_site (弹窗/浮层)
removeSmallCards = switch, true, false, tag=🚫小卡片/公告/推荐词, desc=拦截 small_handler_* / bulletin_board_* / marquee / TAC / NOAH / metax热词
removeNoahOps = switch, true, false, tag=🚫NOAH运营位, desc=拦截 noah.query 运营位 (moon_search_activation_dx_banner 等)
removeTAC = switch, true, false, tag=🚫TAC搜索推荐, desc=拦截 tac.service.call / smart.call 搜索框推荐词
removeSearchWords = switch, false, true, tag=🚫搜索框轮播词, desc=v3.9.10 起由容器模板 reject 实现原生 fallback (无条件生效, 此开关仅历史标记)

# === Moon App 专属开关 ===
removeFeedKeywords = switch, false, true, tag=🌙Moon-清空首页Feed, desc=清空 Moon 首页推荐流所有商品 (metax homepage bodyList)
removePrivateDomain = switch, true, false, tag=🌙Moon-私域动态, desc=拦截 Moon 关注会员/私域动态 (union.pub.entry followMembers) + metax bannerList 私域动态横幅 (23项) [v3.37.3 后所有 Script 规则才真正生效]
# === 闲鱼专用开关 (分组, 便于实测定位) ===
fishRemoveSplash = switch, true, false, tag=🐟闲鱼-开屏广告, desc=拦截 idlecommerce.splash.*(开屏/异步开屏/开屏配置) + adx.bid(ADX竞价) + game.iaa(游戏IAA)
fishRemovePopup = switch, true, false, tag=🐟闲鱼-弹窗浮层, desc=拦截 idle.user.strategy.* + idle.item.recommend.list + idle.local.near.by.corner.info + idle.item.buy.feeds + idle.playboy.recommend
fishRemoveHomeAds = switch, true, false, tag=🐟闲鱼-首页广告位, desc=拦截 idlehome.*(nextfresh/widget/community/newitem/circle/magic) + idle.local.*(home/flow) + idle.home.whale.modulet
fishRemoveSearchAds = switch, true, false, tag=🐟闲鱼-搜索广告, desc=拦截 idlemtopsearch.search(广告位) + .search.shade + .search.discover(MarketHotSpot) + .item.search.activate(热词)
fishRemoveMyPage = switch, true, false, tag=🐟闲鱼-我的页面, desc=拦截 idle.user.page.my.adapter(我的页精简) + idle.trade.full.info(订单状态组件)
liveRemoveAds = switch, true, false, tag=📺直播-广告浮层/信息流, desc=淘宝直播广告: skylar_hummer_* 浮层弹窗 + livex.grow.* 增长位 + vcore.feeds.market.query 信息流AdFeed项 + livex.business.ad.* 广告位配置
removeUcpPopup = switch, true, false, tag=🚫淘宝-UCP弹窗闸门⚠️无效(无条件), desc=拦截 auge.delivery.private.popup.control (UCP全局弹窗控制); 拦掉后弹窗因 checkResult=false 被抑制; ⚠️同时影响 tabbar 角标, 若首页/角标异常请关闭此开关 ｜ ⚠️对应规则在 [Rewrite]

# === 淘宝/天猫专属开关 (预留) ===
# taobaoRemoveLiveAds = switch, true, false, tag=🛒淘宝-直播间广告, desc=拦截淘宝直播间广告
# taobaoRemoveGuessLike = switch, false, true, tag=🛒淘宝-猜你喜欢, desc=拦截淘宝首页猜你喜欢


[Rule]
# 埋点/追踪/AB/互动 域名 — 原为 [Rewrite] 开关规则, 实测「enable={} / && ${sw} == true」在 Rewrite 中均不生效,
# 且部分域名未在 MITM (路径不可见) → 下沉到 [Rule]: 域名级匹配, 无需 MITM, 无条件可靠生效
DOMAIN-SUFFIX, yunxish.com, REJECT
DOMAIN-SUFFIX, iggrowth.cn, REJECT
DOMAIN-SUFFIX, gm.mmstat.com, REJECT
DOMAIN-SUFFIX, log.mmstat.com, REJECT
DOMAIN-SUFFIX, s-gm.mmstat.com, REJECT
DOMAIN-SUFFIX, px.effirst.com, REJECT
DOMAIN-SUFFIX, abtest.alibaba.com, REJECT
DOMAIN-SUFFIX, tlog.mmstat.com, REJECT
DOMAIN-SUFFIX, yixiu-abtest.alicdn.com, REJECT
DOMAIN-SUFFIX, adashx.m.taobao.com, REJECT
DOMAIN-SUFFIX, h-adashx.ut.taobao.com, REJECT
DOMAIN-SUFFIX, ut.taobao.com, REJECT
DOMAIN-SUFFIX, ossgw.alicdn.com, REJECT
DOMAIN-SUFFIX, ems.youku.com, REJECT
DOMAIN-SUFFIX, hudong.alicdn.com, REJECT
DOMAIN-SUFFIX, hudong.tbcdn.cn, REJECT

[MITM]
hostname = acs.m.taobao.com, g.alicdn.com, img.alicdn.com, guide-acs.m.taobao.com, orange.tbcdn.cn, dorangesource.alicdn.com, cn-acs.m.taobao.com, acs.m.goofish.com, g-acs.m.goofish.com, acs.m.tmall.com, acs.m.alibaba.com, acs.m.hema.com, acs.m.fliggy.com, poplayer.template.alibaba.com, heic.alicdn.com, gw.alicdn.com, dinamicx.alibabausercontent.com
h2 = true

[Script]
# === 批量广告分发 (Moon/淘宝/天猫/闲鱼通用) ===

response if ${url} ~= /^https?:\/\/(?:acs|guide-acs)\.m\.taobao\.com\/gw\/mtop\.taobao\.livex\.vcore\.search\.(?:discover|guidehotlist|shadingwords)/i then script("https://raw.githubusercontent.com/Savues/loon-plugin-patches/main/plugins/Alibaba-AdBlock/src/bundle.js", {${liveRemoveAds}}) with enable=${liveRemoveAds}, requires_body=true, tag="直播-搜索发现/热卖榜/遮罩词"
response if ${url} ~= /^https?:\/\/(?:acs|guide-acs)\.m\.taobao\.com\/gw\/mtop\.taobao\.livexshow\.(?:homepage|recommend)\./i then script("https://raw.githubusercontent.com/Savues/loon-plugin-patches/main/plugins/Alibaba-AdBlock/src/bundle.js", {${liveRemoveAds}}) with enable=${liveRemoveAds}, requires_body=true, tag="直播-首页视频流广告"
response if ${url} ~= /^https?:\/\/(?:acs|guide-acs)\.m\.taobao\.com\/gw\/mtop\.taobao\.livex\.vcore\.feeds\.market\.query/i then script("https://raw.githubusercontent.com/Savues/loon-plugin-patches/main/plugins/Alibaba-AdBlock/src/bundle.js", {${liveRemoveAds}}) with enable=${liveRemoveAds}, requires_body=true, tag="直播-信息流广告"
response if ${url} ~= /^https?:\/\/(?:acs|guide-acs)\.m\.taobao\.com\/gw\/mtop\.alimama\.union\.skyleap\.distribution\.batchsite/i then script("https://raw.githubusercontent.com/Savues/loon-plugin-patches/main/plugins/Alibaba-AdBlock/src/bundle.js", {${removeSplashAd}, ${removePopWindow}, ${removeSmallCards}}) with enable=${removeSplashAd}, requires_body=true, tag="批量广告分发"

# === NOAH 运营位 (Moon/淘宝/天猫通用) ===
response if ${url} ~= /^https?:\/\/(?:acs|guide-acs)\.m\.taobao\.com\/gw\/mtop\.etao\.noah\.query/i then script("https://raw.githubusercontent.com/Savues/loon-plugin-patches/main/plugins/Alibaba-AdBlock/src/bundle.js", {${removeNoahOps}}) with enable=${removeNoahOps}, requires_body=true, tag="NOAH运营位"

# === TAC 搜索推荐 (通用) ===
response if ${url} ~= /^https?:\/\/(?:acs|guide-acs)\.m\.taobao\.com\/gw\/mtop\.alimama\.moon\.provider\.tac\.service\.call/i then script("https://raw.githubusercontent.com/Savues/loon-plugin-patches/main/plugins/Alibaba-AdBlock/src/bundle.js", {${removeTAC}}) with enable=${removeTAC}, requires_body=true, tag="搜索框推荐词-TAC基础"
response if ${url} ~= /^https?:\/\/(?:acs|guide-acs)\.m\.taobao\.com\/gw\/mtop\.alimama\.moon\.provider\.tac\.service\.smart\.call/i then script("https://raw.githubusercontent.com/Savues/loon-plugin-patches/main/plugins/Alibaba-AdBlock/src/bundle.js", {${removeTAC}}) with enable=${removeTAC}, requires_body=true, tag="搜索框推荐词-TAC智能"

# === 跨马灯热词 (通用) ===
response if ${url} ~= /^https?:\/\/(?:acs|guide-acs)\.m\.taobao\.com\/gw\/mtop\.taobao\.union\.marquee\.query/i then script("https://raw.githubusercontent.com/Savues/loon-plugin-patches/main/plugins/Alibaba-AdBlock/src/bundle.js", {${removeSmallCards}}) with enable=${removeSmallCards}, requires_body=true, tag="搜索框跑马灯热词"

# === MetaX 首页/Feed (Moon) ===
response if ${url} ~= /^https?:\/\/(?:acs|guide-acs)\.m\.taobao\.com\/gw\/mtop\.alimama\.moon\.provider\.metax\.homepage\.query/i then script("https://raw.githubusercontent.com/Savues/loon-plugin-patches/main/plugins/Alibaba-AdBlock/src/bundle.js", {${removeSmallCards}, ${removePrivateDomain}, ${removeFeedKeywords}}) with enable=${removeSmallCards}, requires_body=true, tag="首页搜索栏热词+私域动态横幅"

# === 私域动态/关注会员 (Moon) ===
response if ${url} ~= /^https?:\/\/(?:acs|guide-acs)\.m\.taobao\.com\/gw\/mtop\.alimama\.union\.pub\.entry/i then script("https://raw.githubusercontent.com/Savues/loon-plugin-patches/main/plugins/Alibaba-AdBlock/src/bundle.js", {${removePrivateDomain}}) with enable=${removePrivateDomain}, requires_body=true, tag="私域动态/关注会员"

# === 弹窗调度器: 清空 ac (拦截所有弹窗, 含未来新增广告) ===
response if ${url} ~= /^https?:\/\/poplayer\.template\.alibaba\.com\/popcdn/i then script("https://raw.githubusercontent.com/Savues/loon-plugin-patches/main/plugins/Alibaba-AdBlock/src/bundle.js", {${removePopWindow}}) with enable=${removePopWindow}, requires_body=true, tag="阿里弹窗-调度器清空"

# === 橙色配置营销清洗 (orange.tbcdn.cn, protobuf 内嵌 JSON, 字节级等长替换) ===
response if ${url} ~= /^https?:\/\/(?:orange|dorangesource)\.tbcdn\.cn|^https?:\/\/dorangesource\.alicdn\.com/i then script("https://raw.githubusercontent.com/Savues/loon-plugin-patches/main/plugins/Alibaba-AdBlock/src/bundle.js", {${removeSplashAd}}) with enable=${removeSplashAd}, requires_body=true, binary_body_mode=true, tag="阿里橙配-营销清洗"


# === 淘宝开屏/弹窗 (kelee.one + 反编译) ===
response if ${url} ~= /^https?:\/\/poplayer\.template\.alibaba\.com/i then script("https://raw.githubusercontent.com/Savues/loon-plugin-patches/main/plugins/Alibaba-AdBlock/src/bundle.js", {${removeSplashAd}}) with enable=${removeSplashAd}, requires_body=true, tag="淘宝-开屏活动"



# === 双11氛围皮肤 (enable=true 时替换开屏/tabbar/我的页皮肤为促销素材) ===
response if ${url} ~= /^https?:\/\/(?:acs|guide-acs)\.m\.taobao\.com\/gw\/mtop\.wireless\.skin\.atmosphere\.info/i then script("https://raw.githubusercontent.com/Savues/loon-plugin-patches/main/plugins/Alibaba-AdBlock/src/bundle.js", {${removePopWindow}}) with enable=${removePopWindow}, requires_body=true, tag="淘宝-双11氛围皮肤"
response if ${url} ~= /^https?:\/\/guide-acs\.m\.taobao\.com\/gw\/mtop\.taobao\.cloudvideo\.video\.query/i then script("https://raw.githubusercontent.com/Savues/loon-plugin-patches/main/plugins/Alibaba-AdBlock/src/bundle.js", {${removeSplashAd}}) with enable=${removeSplashAd}, requires_body=true, tag="淘宝-开屏视频"
response if ${url} ~= /^https?:\/\/guide-acs\.m\.taobao\.com\/gw\/mtop\.taobao\.wireless\.home\.splash\.awesome\.get/i then script("https://raw.githubusercontent.com/Savues/loon-plugin-patches/main/plugins/Alibaba-AdBlock/src/bundle.js", {${removeSplashAd}}) with enable=${removeSplashAd}, requires_body=true, tag="淘宝-开屏图片"

# === 新版开屏/新面孔 (反编译发现) ===
response if ${url} ~= /^https?:\/\/guide-acs\.m\.taobao\.com\/gw\/mtop\.taobao\.wireless\.home\.newface\.awesome\.newget/i then script("https://raw.githubusercontent.com/Savues/loon-plugin-patches/main/plugins/Alibaba-AdBlock/src/bundle.js", {${removePopWindow}}) with enable=${removePopWindow}, requires_body=true, tag="淘宝-新版新面孔"
response if ${url} ~= /^https?:\/\/guide-acs\.m\.taobao\.com\/gw\/mtop\.taobao\.wireless\.home\.newface\.awesome\.get/i then script("https://raw.githubusercontent.com/Savues/loon-plugin-patches/main/plugins/Alibaba-AdBlock/src/bundle.js", {${removePopWindow}}) with enable=${removePopWindow}, requires_body=true, tag="淘宝-新面孔"

# === TAC 搜索 (反编译发现: 不同 App 不同接口) ===
response if ${url} ~= /^https?:\/\/(?:acs|guide-acs)\.m\.taobao\.com\/gw\/mtop\.taobao\.aihome\.tac\.execute/i then script("https://raw.githubusercontent.com/Savues/loon-plugin-patches/main/plugins/Alibaba-AdBlock/src/bundle.js", {${removeTAC}}) with enable=${removeTAC}, requires_body=true, tag="TAC-AIHome搜索"
response if ${url} ~= /^https?:\/\/(?:acs|guide-acs)\.m\.taobao\.com\/gw\/mtop\.tmall\.tac\.gateway\.execute/i then script("https://raw.githubusercontent.com/Savues/loon-plugin-patches/main/plugins/Alibaba-AdBlock/src/bundle.js", {${removeTAC}}) with enable=${removeTAC}, requires_body=true, tag="TAC-天猫网关搜索"

# === 淘宝弹窗/运营位 (Body Rewrite 兜底) ===
response if ${url} ~= /^https?:\/\/(?:acs|guide-acs)\.m\.taobao\.com\/gw\/mtop\.alibaba\.advertisementservice\.getadv/i then script("https://raw.githubusercontent.com/Savues/loon-plugin-patches/main/plugins/Alibaba-AdBlock/src/bundle.js", {${removePopWindow}}) with enable=${removePopWindow}, requires_body=true, tag="淘宝-广告服务"
response if ${url} ~= /^https?:\/\/(?:acs|guide-acs)\.m\.taobao\.com\/gw\/mtop\.alimama\.etao\.config\.query/i then script("https://raw.githubusercontent.com/Savues/loon-plugin-patches/main/plugins/Alibaba-AdBlock/src/bundle.js", {${removePopWindow}}) with enable=${removePopWindow}, requires_body=true, tag="淘宝-营销配置"
response if ${url} ~= /^https?:\/\/(?:acs|guide-acs)\.m\.taobao\.com\/gw\/mtop\.alimusic\.common\.mobileservice\.startinit/i then script("https://raw.githubusercontent.com/Savues/loon-plugin-patches/main/plugins/Alibaba-AdBlock/src/bundle.js", {${removePopWindow}}) with enable=${removePopWindow}, requires_body=true, tag="淘宝-音乐初始化"
response if ${url} ~= /^https?:\/\/(?:acs|guide-acs)\.m\.taobao\.com\/gw\/mtop\.etao\.noah\.query/i then script("https://raw.githubusercontent.com/Savues/loon-plugin-patches/main/plugins/Alibaba-AdBlock/src/bundle.js", {${removeNoahOps}, ${removePopWindow}}) with enable=${removePopWindow}, requires_body=true, tag="淘宝-NOAH开屏"
response if ${url} ~= /^https?:\/\/(?:acs|guide-acs)\.m\.taobao\.com\/gw\/mtop\.film\.mtopadvertiseapi\.queryadvertise/i then script("https://raw.githubusercontent.com/Savues/loon-plugin-patches/main/plugins/Alibaba-AdBlock/src/bundle.js", {${removePopWindow}}) with enable=${removePopWindow}, requires_body=true, tag="淘宝-影视广告"
response if ${url} ~= /^https?:\/\/(?:acs|guide-acs)\.m\.taobao\.com\/gw\/mtop\.o2o\.ad\.gateway\.get/i then script("https://raw.githubusercontent.com/Savues/loon-plugin-patches/main/plugins/Alibaba-AdBlock/src/bundle.js", {${removePopWindow}}) with enable=${removePopWindow}, requires_body=true, tag="淘宝-O2O广告"
response if ${url} ~= /^https?:\/\/(?:acs|guide-acs)\.m\.taobao\.com\/gw\/mtop\.taobao\.idle\.home\.welcome/i then script("https://raw.githubusercontent.com/Savues/loon-plugin-patches/main/plugins/Alibaba-AdBlock/src/bundle.js", {${removePopWindow}}) with enable=${removePopWindow}, requires_body=true, tag="淘宝-欢迎页"
response if ${url} ~= /^https?:\/\/(?:acs|guide-acs)\.m\.taobao\.com\/gw\/mtop\.trip\.activity\.querytmsresources/i then script("https://raw.githubusercontent.com/Savues/loon-plugin-patches/main/plugins/Alibaba-AdBlock/src/bundle.js", {${removePopWindow}}) with enable=${removePopWindow}, requires_body=true, tag="淘宝-旅行活动"
response if ${url} ~= /^https?:\/\/guide-acs\.m\.taobao\.com\/gw\/mtop\.taobao\.volvo\.secondfloor\.getconfig/i then script("https://raw.githubusercontent.com/Savues/loon-plugin-patches/main/plugins/Alibaba-AdBlock/src/bundle.js", {${removePopWindow}}) with enable=${removePopWindow}, requires_body=true, tag="淘宝-二楼配置"

# === 闲鱼开屏/弹窗 (kelee.one + 反编译) ===
response if ${url} ~= /^https?:\/\/acs\.m\.goofish\.com\/gw\/mtop\.taobao\.idlecommerce\.splash\.ads/i then script("https://raw.githubusercontent.com/Savues/loon-plugin-patches/main/plugins/Alibaba-AdBlock/src/bundle.js", {${fishRemoveSplash}}) with enable=${fishRemoveSplash}, requires_body=true, tag="闲鱼-开屏广告"
response if ${url} ~= /^https?:\/\/acs\.m\.goofish\.com\/gw\/mtop\.taobao\.idlecommerce\.splash\.async\.ads/i then script("https://raw.githubusercontent.com/Savues/loon-plugin-patches/main/plugins/Alibaba-AdBlock/src/bundle.js", {${fishRemoveSplash}}) with enable=${fishRemoveSplash}, requires_body=true, tag="闲鱼-异步开屏广告"
response if ${url} ~= /^https?:\/\/acs\.m\.goofish\.com\/gw\/mtop\.taobao\.idlecommerce\.splash\.config/i then script("https://raw.githubusercontent.com/Savues/loon-plugin-patches/main/plugins/Alibaba-AdBlock/src/bundle.js", {${fishRemoveSplash}}) with enable=${fishRemoveSplash}, requires_body=true, tag="闲鱼-开屏配置"
response if ${url} ~= /^https?:\/\/acs\.m\.goofish\.com\/gw\/mtop\.taobao\.idlecommerce\.adx\.bid/i then script("https://raw.githubusercontent.com/Savues/loon-plugin-patches/main/plugins/Alibaba-AdBlock/src/bundle.js", {${fishRemoveSplash}}) with enable=${fishRemoveSplash}, requires_body=true, tag="闲鱼-ADX竞价广告"
response if ${url} ~= /^https?:\/\/acs\.m\.goofish\.com\/gw\/mtop\.taobao\.idlecommerce\.game\.iaa\.ads/i then script("https://raw.githubusercontent.com/Savues/loon-plugin-patches/main/plugins/Alibaba-AdBlock/src/bundle.js", {${fishRemoveSplash}}) with enable=${fishRemoveSplash}, requires_body=true, tag="闲鱼-游戏IAA广告"
response if ${url} ~= /^https?:\/\/acs\.m\.goofish\.com\/gw\/mtop\.taobao\.idle\.user\.strategy\.list/i then script("https://raw.githubusercontent.com/Savues/loon-plugin-patches/main/plugins/Alibaba-AdBlock/src/bundle.js", {${fishRemovePopup}}) with enable=${fishRemovePopup}, requires_body=true, tag="闲鱼-用户策略"
response if ${url} ~= /^https?:\/\/acs\.m\.goofish\.com\/gw\/mtop\.taobao\.idle\.user\.strategy\.get/i then script("https://raw.githubusercontent.com/Savues/loon-plugin-patches/main/plugins/Alibaba-AdBlock/src/bundle.js", {${fishRemovePopup}}) with enable=${fishRemovePopup}, requires_body=true, tag="闲鱼-策略获取"
response if ${url} ~= /^https?:\/\/acs\.m\.goofish\.com\/gw\/mtop\.taobao\.idle\.item\.recommend\.list/i then script("https://raw.githubusercontent.com/Savues/loon-plugin-patches/main/plugins/Alibaba-AdBlock/src/bundle.js", {${fishRemovePopup}}) with enable=${fishRemovePopup}, requires_body=true, tag="闲鱼-商品推荐"
response if ${url} ~= /^https?:\/\/acs\.m\.goofish\.com\/gw\/mtop\.taobao\.idle\.local\.near\.by\.corner\.info/i then script("https://raw.githubusercontent.com/Savues/loon-plugin-patches/main/plugins/Alibaba-AdBlock/src/bundle.js", {${fishRemovePopup}}) with enable=${fishRemovePopup}, requires_body=true, tag="闲鱼-附近角落"
response if ${url} ~= /^https?:\/\/acs\.m\.goofish\.com\/gw\/mtop\.taobao\.idle\.item\.buy\.feeds/i then script("https://raw.githubusercontent.com/Savues/loon-plugin-patches/main/plugins/Alibaba-AdBlock/src/bundle.js", {${fishRemovePopup}}) with enable=${fishRemovePopup}, requires_body=true, tag="闲鱼-购买Feed"
# === 闲鱼搜索词族 (优先于 search 规则, 避免被前缀抢匹配) ===
# 搜索框滚动词/热搜榜/猜你可能在找: shade(singleShadeWords+multiWords) / suggest / tbsearch / hotRankList
response if ${url} ~= /^https?:\/\/(?:acs|g-acs)\.m\.goofish\.com\/gw\/mtop\.taobao\.(?:idle\.search\.|idleitem\.tbsearch|idlemtopsearch\.(?:idleitem\.tbsearch|item\.search\.|search\.(?:suggest|shade|activate)|main\.|fishpool\.|detailpage\.search\.shade|market\.tab\.list)|idle\.trend\.search\.(?:suggest|shade|activate)|idle\.oliver\.(?:async\.)?batch\.issue)/i then script("https://raw.githubusercontent.com/Savues/loon-plugin-patches/main/plugins/Alibaba-AdBlock/src/bundle.js", {${fishRemoveSearchAds}}) with enable=${fishRemoveSearchAds}, requires_body=true, tag="闲鱼-搜索词/热搜/猜你可能在找"

response if ${url} ~= /^https?:\/\/acs\.m\.goofish\.com\/gw\/mtop\.taobao\.idlemtopsearch\.search\.shade\/[0-9.]+\?/i then script("https://raw.githubusercontent.com/Savues/loon-plugin-patches/main/plugins/Alibaba-AdBlock/src/bundle.js", {${fishRemoveSearchAds}}) with enable=${fishRemoveSearchAds}, requires_body=true, tag="闲鱼-搜索遮罩"
response if ${url} ~= /^https?:\/\/acs\.m\.goofish\.com\/gw\/mtop\.taobao\.idle\.playboy\.recommend/i then script("https://raw.githubusercontent.com/Savues/loon-plugin-patches/main/plugins/Alibaba-AdBlock/src/bundle.js", {${fishRemovePopup}}) with enable=${fishRemovePopup}, requires_body=true, tag="闲鱼-玩家推荐"

# === 闲鱼首页/内容过滤 (kelee.one jq 规则移植为 JS) ===
response if ${url} ~= /^https?:\/\/acs\.m\.goofish\.com\/gw\/mtop\.taobao\.idle\.fun\.follow\.feed\.list/i then script("https://raw.githubusercontent.com/Savues/loon-plugin-patches/main/plugins/Alibaba-AdBlock/src/bundle.js", {${fishRemoveHomeAds}}) with enable=${fishRemoveHomeAds}, requires_body=true, tag="闲鱼-关注Feed流"
