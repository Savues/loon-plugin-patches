#!name=豆瓣去广告
#!desc=以 honue 原版为基线，仅追加「搜索页预制广告词」剥离脚本。开屏规则做了两处等价修正（见下）。真机验证：开屏照常去除，搜索框与「发现」标签不再出现广告词，真实热搜完整保留。
#!author=honue, Savues
#!homepage=https://github.com/Savues/loon-plugin-patches/tree/main/plugins/Douban-Dedup
#!date=2026-10-01
#!version=2.0
#!icon=https://raw.githubusercontent.com/honue/rules/master/img/douban.png
#!tag=去广告

[Argument]
block_search_ad = switch,true,tag=去搜索页预制广告词,desc=剥掉搜索框滚动广告与「发现」横滚标签里的广告条目；真实热搜不受影响

[Rule]

# ── 开屏规则：相对 honue 原版只有这一条，做了两处修正 ──────────
# 原版： ^https?:\/\/api\.douban\.com\/v2\/app_ads.+ reject
# 修正 1：v2 → v\d+         豆瓣升到 v3 即失效（跨版本）
# 修正 2：reject → reject-dict  JSON 接口该返回 {}；原版返回空响应体，
#         真机抓包看到 App 5 秒后原样重试（02:41:20 → 02:41:25 两次 splash_preload）
# 其余信息流/横幅/腾讯 HTTPDNS 等规则一律不加 ——
# 真机实测它们在个人主页/小组页高并发时引发连接池排队，
# 而 honue 原版（只有 1 条 Rewrite + 1 个域名）无此问题。
[URL Rewrite]
^https?:\/\/api\.douban\.com\/v\d+\/app_ads\/(?:splash_)?(?:show|preload)(?:[\/?].*)?$ reject-dict

[Script]
# 搜索页预制广告词。这是相对原版的唯一新增功能。
#
# 抓包实测（豆瓣 7.135.0 / iPadOS 18.7.3，8 份 HAR）：
#   /api/v2/search/found_words → { words:[...], top_word, cache_timeout }
#   /api/v2/search/hots        → { roofs:[...], ..., ad_info:{...} }
# 广告与真实热搜混在同一数组里：
#   words[1] { layout:"ad", search_type:"ad_link", title:"看视频抽立减金",
#              uri:"https://m.douban.com/cps-spu-page/3/daily-incentive-lottery?source=ad" }
#   roofs[0] { layout:"ad", title:"抽10元支付宝立减金" }
#   ad_info  { ad_type:"fake", unit_name:"dale_app_search_hots_page" }
# 正常条目 layout 是 "default"，不能删。
#
# ⚠️ 不能直接 reject 这两个端点 —— 真实热搜（真实词条）在里面，拦掉等于搜索联想报废。
# ⚠️ top_word（搜索框滚动词）标的是 layout:"default"，与真实热搜无任何差别。
#    跨 8 份抓包 12 个样本无一带广告标记，其中《沙丘3》确认引进、
#    女生独闯肯尼亚safari 被用户确认为广告，而《Girls》主创Lena Dunham代孕
#    明显是真热搜 ⇒ 协议层无法区分，只能整字段删除。
#    代价：搜索框不再显示滚动词，搜索功能不受影响。
#
# 语法依据 Loon 官方手册 docs/cn/script.md：响应体改写只能走 [Script] 的
# http-response，requires-body=true 是必需的（否则 $response.body 恒为 undefined）。
# [URL Rewrite] 没有 script-response-body 这个语法（见 docs/cn/rewrite.md）。
http-response ^https?:\/\/frodo\.douban\.com\/api\/v2\/search\/(?:found_words|hots)(?:[\/?].*)?$ script-path=https://raw.githubusercontent.com/Savues/loon-plugin-patches/main/plugins/Douban-Dedup/src/douban-search-ad.js, tag=搜索页广告词, requires-body=true, timeout=10, enable={block_search_ad}

[MITM]
# api.douban.com 来自 honue 原版。frodo.douban.com 是脚本生效的前提：
# 响应体改写必须解密该域名，缺了它 script 一行都不会跑。
hostname = api.douban.com, frodo.douban.com
