#!name=拼多多去广告(修复版) v1.73
#!desc=移除开屏广告、会场入口，精简首页和个人中心；底栏按钮可自定义；百亿补贴页搜索框推广词。【修复】屏蔽聊天/埋点/phantom 三项改为默认关闭。
#!openUrl=https://apps.apple.com/app/id1044283059
#!author=ZenmoFeiShi[https://github.com/ZenmoFeiShi], 可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
#!tag=去广告
#!system=
#!system_version=
#!loon_version=3.5.0(969)
#!homepage=https://hub.kelee.one
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/PinDuoDuo.png
#!date=2026-09-29 20:20:00

[Argument]
# ===== 高危：接口响应体改写 =====
api_stub = switch,true,false,tag=[高危] 屏蔽会场/推荐类接口(13 条),desc=关闭后这些端点返回真实数据;首页去广告与底栏裁剪同时失效
chat_stub = switch,false,false,tag=[高危] 屏蔽聊天相关接口(4 条),desc=默认关闭；打开后屏蔽 new_chat_group / get_list_data 等，聊天可正常刷新
telemetry_stub = switch,false,false,tag=[高危] 屏蔽埋点/遥测/配置下发域名(8 个),desc=默认关闭；打开后拦 apm(性能监控)/meta(AB实验+配置下发,实测返回28KB)/th+ta(埋点上报)
phantom_stub = switch,false,false,tag=[高危] 屏蔽 phantom 风控模块,desc=默认关闭；与消息推送 WebSocket 同模块(xg.pinduoduo.com/api/phantom/_stm)，怀疑被风控时可尝试打开
order_stub = switch,true,false,tag=[高危] 屏蔽订单列表,desc=关掉后订单页会显示真实订单;若不想在订单页看到列表可关
search_stub = switch,true,false,tag=[高危] 屏蔽搜索框轮播推荐词,desc=拦 /search_hotquery 并删 /search 的 expansion 字段;搜索框仍显示「酷态科cp12」这类词时检查本项
# ===== 底栏自定义 =====
bottom_custom = switch,true,tag=[底栏] 启用自定义底栏
Bot_index = switch,true,tag=[底栏] 首页
Bot_chat = switch,true,tag=[底栏] 聊天
Bot_personal = switch,true,tag=[底栏] 我的
Bot_live = switch,false,tag=[底栏] 多多视频
Bot_class = switch,false,tag=[底栏] 分类
Bot_attendance = switch,false,tag=[底栏] 签到
Bot_custom = input,"",tag=[底栏] 自定义项(逗号分隔),desc=按 link 包含匹配,逗号分隔;一个都不选时回落首页/聊天/我的

[Rule]
# [已移除-高风险] AND, ((DOMAIN, api.pinduoduo.com), (PROTOCOL, QUIC)), REJECT
DOMAIN, titan.pinduoduo.com, REJECT
# [已移除] DOMAIN, xg.pinduoduo.com, REJECT  <- 实测 xg.pinduoduo.com/ngrtt/zqog 是 WebSocket(101) 长连接，聊天消息推送通道
DOMAIN, cdl-1.pddpic.com, REJECT
DOMAIN, cdl-p2.pddpic.com, REJECT
DOMAIN, cd-1.pddpic.com, REJECT
DOMAIN, apm.pinduoduo.com, REJECT, enable={telemetry_stub}
DOMAIN, th-b.pinduoduo.com, REJECT, enable={telemetry_stub}
DOMAIN, ta.pinduoduo.com, REJECT, enable={telemetry_stub}
DOMAIN, th.pinduoduo.com, REJECT, enable={telemetry_stub}
DOMAIN, th-a.pinduoduo.com, REJECT, enable={telemetry_stub}
DOMAIN, ta-a.pinduoduo.com, REJECT, enable={telemetry_stub}
DOMAIN, meta.pinduoduo.com, REJECT, enable={telemetry_stub}
DOMAIN, apm-a.pinduoduo.com, REJECT, enable={telemetry_stub}

[Rewrite]


# [已由脚本接管] ^https:\/\/api\.pinduoduo\.com\/api\/alexa\/homepage\/hub\? response-b …

# [已由脚本接管] ^https:\/\/api\.pinduoduo\.com\/api\/alexa\/homepage\/hub\? response-b …


^https:\/\/api\.pinduoduo\.com\/api\/philo\/personal\/hub\? response-body-json-del monthly_card_entrance personal_center_style_v2_vo icon_set.icons icon_set.top_personal_icons personal_banner

^https:\/\/api\.pinduoduo\.com\/api\/oak\/integration\/render\? response-body-json-del bottom_section_list ui.bottom_section ui.live_section.float_info

^https:\/\/api\.pinduoduo\.com\/api\/caterham\/v3\/query\/order_detail_group\? response-body-json-del data.goods_list

^https:\/\/api\.pinduoduo\.com\/order\/ response-body-json-del marketing_banner_vo shipping.banner_above_recommend

^https:\/\/api\.pinduoduo\.com\/api\/aristotle\/order_list_v4\? response-body-json-jq '.orders |= map(.order_buttons |= map(del(.order_growth_tip)))'

[Script]
http-response ^https:\/\/api\.pinduoduo\.com\/(search_hotquery|search|api\/aristotle\/(unrated_order_for_unreceived_tab|query_order_list_tabs_element)|api\/aquarius\/hungary\/global\/homepage|api\/caterham\/(v2\/query\/goods_detail_with_tags|v3\/query\/(order_express_group|likes|my_order_group|new_chat_group|personal))|api\/alexa\/goods\/back_up|api\/brand-olay\/goods_detail\/bybt_guide|api\/engels\/(reviews\/require\/append|wait\/receive\/review)|api\/buffon\/nasus\/recommend|api\/phantom\/gbdbpdv\/extra|api\/manufacturer\/cross\/shortcut\/list|api\/dunkirk\/liveactivity\/push\/create\/url\/report|api\/growth\/nagato\/app\/index\/gather|api\/zaire_biz\/chat\/resource\/get_list_data)\? script-path=https://raw.githubusercontent.com/Savues/loon-plugin-patches/main/plugins/PinDuoDuo/src/stub.response.js, requires-body=true, argument=[{api_stub},{chat_stub},{search_stub},{phantom_stub},{order_stub}], timeout=5, tag=接口拦截与搜索词屏蔽
http-response ^https:\/\/m\.pinduoduo\.net\/mdkd\/package\?from_app_scan script-path=https://raw.githubusercontent.com/Savues/loon-plugin-patches/main/plugins/PinDuoDuo/src/PinDuoDuo_remove_ads.js, requires-body=true, tag=移除扫码取件页面商品推荐及弹窗
http-response ^https:\/\/api\.pinduoduo\.com\/api\/alexa\/homepage\/hub\? script-path=https://raw.githubusercontent.com/Savues/loon-plugin-patches/main/plugins/PinDuoDuo/src/homepage.response.js, requires-body=true, argument=[{api_stub},{search_stub},{bottom_custom},{Bot_index},{Bot_chat},{Bot_personal},{Bot_live},{Bot_class},{Bot_attendance},{Bot_custom}], timeout=5, tag=首页去广告与底栏自定义
http-response ^https:\/\/m\.pinduoduo\.net\/brand_activity_subsidy\.html\? script-path=https://raw.githubusercontent.com/Savues/loon-plugin-patches/main/plugins/PinDuoDuo/src/subsidy.response.js, requires-body=true, argument=[{search_stub}], timeout=5, tag=百亿补贴搜索框去推广词

[MitM]
hostname=api.pinduoduo.com, m.pinduoduo.net

# ─────────────────────────────────────────────
# 修复说明（上游脚本仅改了 1 行远程依赖 URL；homepage.response.js 为本仓库自研）
#  1. 新增 [Argument] 开关：chat_stub / telemetry_stub
#  2. 4 条聊天与推荐端点改挂 enable={chat_stub}，可在插件参数页直接关闭以恢复聊天刷新
#  3. homepage/hub 的 jq 有空值崩溃缺陷（? 不保护 map 迭代）——
#     该表达式已在第 10 条随底栏自定义一并由自研脚本取代
#  4. 移除 1 条 QUIC REJECT（实测 api 的 ALPN 只协商 h2，本就无 h3，该规则不触发）
#  5. 移除 DOMAIN, xg.pinduoduo.com, REJECT —— 基线抓包实测该域名承载 WebSocket
#     (xg.pinduoduo.com/ngrtt/zqog 返回 101 Switching Protocols)，是消息推送通道
#  6. 移除上游 2 条裸 IP REJECT（IPv4 与 IPv6 各一，路径 /d ~ /d9，仅 pinduoduo App）
#     这两条在本仓库不再保留，也不建议恢复，三个理由：
#     ① 拦不到。真实路径是 /v3/d?type=addrs&ttl=1&dn=…&id=1 —— IP 之后是 /v3 再 /d?，
#        而上游正则要求紧接 /d(\d)? ，中间多出一段，根本对不上。
#        2026-09-29 两台设备真机抓包实测：该形态流量稳定存在，上游正则一条都命中不了。
#     ② 职责重复。这类请求已由 HTTPDNS拦截器 统一处理，其正则含 (\/v?[0-9]+)?
#        可正确命中 /v3/d，实测两台设备共 65 条全部由它拦下。
#     ③ v1.1~v1.71 的注释是错的：「真实形态无 query」与抓包相反（实际带 query），
#        且原文那句让读者自行去掉注释行首的引导，会把后来人引向写出一条
#        仍然匹配不了的正则。故整段规则连同误导性注释一并删除，不再留作可恢复项。
#     历史正则见 git：39e6ed5（v1.1 首次收录时注释掉的原始两行）
#  7. script-path 改为本仓库托管的副本（原为 kelee.one 远程 URL）
#  8. 脚本内 newChunk 常量改指本仓库（上游脚本硬编码了 kelee.one 的 chunk 地址，
#     那是页面运行时再去第三方域名取代码；现已一并收进 src/chunks/ 托管）
#  9. 新增 [Argument] api_stub，管住 16 条 reject-dict（其中 2 条后拆出，见 #11）
# 12. 【重要】20 条 [Rewrite] reject-dict 全部改为自研脚本 src/stub.response.js
#     原因：Loon 手册 rewrite.md 没有 enable= 参数（script.md 才有），
#     v1.3/v1.4 挂上去的 enable={api_stub} 真机实测全部失效
#     （/search_hotquery 等从「拦截」变「放行」，而脚本里读到的开关却是开的）
# 13. 新增 search_stub：搜索框轮播推荐词单独可控
# 11. 从 api_stub 拆出 phantom_stub / order_stub 两条单独控制
#     （phantom 与推送同模块、my_order_group 会清空订单列表，
#      这两条不该和「搜索框热词」等广告项捆绑在一起）
# 10. 新增底栏自定义：[Argument] 7 个开关 + homepage.response.js（自研）
#     两条 homepage/hub 的 json-del / json-jq 已由脚本取代
#     顺带解决了「同一 URL 挂两条 [Rewrite] 谁先谁后」这个一直悬着的问题
# 14. 新增 subsidy.response.js：清掉百亿补贴页搜索框的推广轮播词
#     依据 2026-09-29 真机抓包：m.pinduoduo.net/brand_activity_subsidy.html
#     是服务端渲染 HTML，轮播词内联在 window.rawData 的 store.searchStore，
#     不经任何 API —— 所以首页那套 [Script] 碰不到它，必须单独挂一条。
#     实测 10 个词里 5 个是推广（百事可乐 ×3、可口可乐、特价饮料）。
#     沿用 search_stub 开关、不新增 [Argument]：这是同一批推广词的第三个来源。
# 上游脚本与署名：ZenmoFeiShi / 可莉
# ─────────────────────────────────────────────
