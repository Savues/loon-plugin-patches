#!name=JavDB 调试-6 备用域名(高风险)
#!desc=拦截 btyjscl/aliycloud/ffaoa 的 startup/ads - 可能导致无网络
#!author=Savues
#!tag=去广告,JavDB,调试
#!system=iOS, iPadOS
#!system_version=15
#!loon_version=3.4.0(962)
#!homepage=https://github.com/Savues/loon-plugin-patches
#!date=2026-10-12

[Rule]
URL-REGEX,^https://apidd\.btyjscl\.com/api/v1/ads,REJECT
URL-REGEX,^https://api\.(aliycloud|ffaoa)\.com/api/v1/startup,REJECT

[MITM]
hostname = apidd.btyjscl.com, api.aliycloud.com, api.ffaoa.com
