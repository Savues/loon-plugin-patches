#!name=iTunes 收据校验转发 v1.02
#!desc=把 App 的 iOS 收据校验请求转发到注入服务，回包替换为伪造的高级版凭证。【上游 Jsforbaby 原版，脚本逐字节未改】
#!author=原作者: Jsforbaby | 托管与修复: Savues[https://github.com/Savues/loon-plugin-patches]
#!homepage=https://github.com/Savues/loon-plugin-patches
#!icon=https://raw.githubusercontent.com/fishdown/Icon/refs/heads/master/app/RevenueCat.png
#!tag=会员,MITM
#!system=iOS, iPadOS
#!loon_version=3.2.0
#!date=2026-10-01 00:10:00
# ==== PLUGIN_VERSION: 1.02 | v1.02 删除壳层 —— 真机证明它才是失效的唯一原因 ====
#   v1.0/v1.01 我以为上游「参数接错」，加壳层去修。真机诊断证明上游接得完全正确：
#   Loon 传的 $argument 是对象 {Enabled:"true",Expires:"2099-09-09",Country:"HK"}，
#   键名与上游读取的 $argument.Enabled 完全一致，参数从未丢失。
#   反倒是壳层把对象判成「非字符串 → 强制置空 → 判为关」，导致真机完全失效。
#   本版删掉壳层，纯上游逐字节运行。

[Argument]
# Enabled 原本是 input，值写 "true"/"false"。壳层只认小写 true，其余一律当关。
Enabled = input, "true", tag=启用转发, desc=填 true 转发到注入服务；填任何其它值（含 FALSE/1/空）即直接放行不转发。⚠️ 关闭后 Loon 仍会解密该域名
Expires = input, "2099-09-09", tag=凭证到期日, desc=格式 YYYY-MM-DD。注入的凭证会写上这个到期日
Country = input, "HK", tag=App Store 国家, desc=两位大写 ISO 3166-1。查询内购商品用的区，填错可能导致注入的商品在该区不存在

[Script]
http-request ^https:\/\/buy\.itunes\.apple\.com\/verifyReceipt requires-body=1,script-path=https://raw.githubusercontent.com/Savues/loon-plugin-patches/main/plugins/iTunes-Spoof/src/loon-itunes.js,tag=iTunes收据转发,argument=[{Enabled},{Expires},{Country}]

[Mitm]
hostname = buy.itunes.apple.com
