#!name=JavDB 调试-3 仅启动公告
#!desc=仅将 startup API 的 settings.NOTICE 设为空字符串
#!author=@Savues <https://github.com/Savues>
#!tag=去广告,JavDB,调试
#!system=iOS, iPadOS
#!system_version=15
#!loon_version=3.4.0(962)
#!homepage=https://github.com/Savues/loon-plugin-patches
#!date=2026-10-12

[Rewrite]
^https://apidd\.(czssdgz|spthgb|btyjscl)\.com/api/v1/startup.*$ response-body-json-jq '.data.settings.NOTICE = ""'
^https://api\.(aliycloud|ffaoa)\.com/api/v1/startup.*$ response-body-json-jq '.data.settings.NOTICE = ""'

[MITM]
hostname = apidd.spthgb.com, apidd.czssdgz.com, apidd.btyjscl.com, api.aliycloud.com, api.ffaoa.com
