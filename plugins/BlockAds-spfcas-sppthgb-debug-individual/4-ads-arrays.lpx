#!name=JavDB 调试-4 仅清空广告数组
#!desc=仅清空 /api/v1/ads 的三个广告数组，不修改 enabled 字段
#!author=Savues
#!tag=去广告,JavDB,调试
#!system=iOS, iPadOS
#!system_version=15
#!loon_version=3.4.0(962)
#!homepage=https://github.com/Savues/loon-plugin-patches
#!date=2026-10-12

[Rewrite]
^https://apidd\.(czssdgz|spthgb|btyjscl)\.com/api/v1/ads.*$ response-body-json-jq '.data.ads.index_top = [] | .data.ads.web_magnets_top = [] | .data.ads.magnets_top = []'
^https://api\.(aliycloud|ffaoa)\.com/api/v1/ads.*$ response-body-json-jq '.data.ads.index_top = [] | .data.ads.web_magnets_top = [] | .data.ads.magnets_top = []'

[MITM]
hostname = apidd.spthgb.com, apidd.czssdgz.com, apidd.btyjscl.com, api.aliycloud.com, api.ffaoa.com
