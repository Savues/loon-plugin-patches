#!name=JavDB 广告调试版 v1.0.0
#!desc=调试版：每个功能独立开关，用于定位"未找到查询信息"的原因。请逐个开启测试。需开启 MITM 并信任证书。
#!author=Savues <https://github.com/Savues/loon-plugin-patches>
#!tag=去广告,JavDB,调试
#!system=iOS, iPadOS
#!system_version=15
#!loon_version=3.4.0(962)
#!homepage=https://github.com/Savues/loon-plugin-patches
#!date=2026-10-12

[General]
description = Debug version with individual switches for each blocking feature
author = Savues
homepage = https://github.com/Savues/loon-plugin-patches
license = MIT

[Argument]
# ===== 核心广告拦截 =====
BlockAdImages = switch,true,tag=1. 广告图片拦截,desc=拦截 tp.spfcas.com/.../ads/ 路径下的广告图片（保留封面/头像）
BlockAdConfig = switch,true,tag=2. 广告配置拦截,desc=拦截 /api/v1/ads 广告列表配置接口

# ===== 启动接口重写 (逐项开关) =====
RewriteSplashAd = switch,true,tag=3. 移除开屏广告,desc=将 startup API 中的 splash_ad 设为空对象 {}
RewriteNotice = switch,true,tag=4. 移除启动公告,desc=将 startup API 中的 settings.NOTICE 设为空字符串

# ===== 备用域名拦截 (可能影响可用性) =====
BlockBackupDomains = switch,false,tag=5. 拦截备用启动域名,desc=拦截 btyjscl/aliycloud/ffaoa 等备用域名的 startup/ads（默认关，开启可能导致无网络）

# ===== 追踪/点击域名 =====
BlockClickTracking = switch,true,tag=6. 广告点击追踪域名,desc=拦截 afengy/win1823/jopeki/zenaruk/tkock/kac 等跳转域名

# ===== 旧版计划接口 =====
RewritePlanMessage = switch,false,tag=7. 移除旧版计划公告,desc=处理 /api/v4/plans 的 plan_message（默认关，已由 startup 覆盖）

# ===== 液链配置 =====
BlockLiquidLink = switch,true,tag=8. 拦截 liquidlink 配置,desc=拦截 api.liquidlink.cn（返回空响应）

[Rule]
# 1. 广告图片 - 仅拦截 /ads/ 路径
URL-REGEX,^https://tp\.spfcas\.com/.*/ads/,REJECT,enable={BlockAdImages}

# 2. 广告配置 /api/v1/ads - 主域名
URL-REGEX,^https://apidd\.(spthgb|czssdgz)\.com/api/v1/ads,REJECT,enable={BlockAdConfig}
URL-REGEX,^https://api\.(aliycloud|ffaoa)\.com/api/v1/ads,REJECT,enable={BlockAdConfig}

# 3. 备用域名广告配置 (慎用)
URL-REGEX,^https://apidd\.btyjscl\.com/api/v1/ads,REJECT,enable={BlockBackupDomains}
URL-REGEX,^https://api\.(aliycloud|ffaoa)\.com/api/v1/startup,REJECT,enable={BlockBackupDomains}

# 4. Liquidlink
DOMAIN-SUFFIX,api.liquidlink.cn,REJECT,enable={BlockLiquidLink}

# 5. 点击追踪域名
DOMAIN-SUFFIX,afengy.com,REJECT,enable={BlockClickTracking}
DOMAIN-SUFFIX,win1823.com,REJECT,enable={BlockClickTracking}
DOMAIN-SUFFIX,jopeki.com,REJECT,enable={BlockClickTracking}
DOMAIN-SUFFIX,zenaruk.com,REJECT,enable={BlockClickTracking}
DOMAIN-SUFFIX,tkock.com,REJECT,enable={BlockClickTracking}
DOMAIN-SUFFIX,kac.2vtt7a4.xyz,REJECT,enable={BlockClickTracking}

[Rewrite]
# 3. 移除 splash_ad
^https://apidd\.(czssdgz|spthgb|btyjscl)\.com/api/v1/startup.*$ response-body-json-jq '.data.splash_ad = {}',enable={RewriteSplashAd}
^https://api\.(aliycloud|ffaoa)\.com/api/v1/startup.*$ response-body-json-jq '.data.splash_ad = {}',enable={RewriteSplashAd}

# 4. 移除 NOTICE
^https://apidd\.(czssdgz|spthgb|btyjscl)\.com/api/v1/startup.*$ response-body-json-jq '.data.settings.NOTICE = ""',enable={RewriteNotice}
^https://api\.(aliycloud|ffaoa)\.com/api/v1/startup.*$ response-body-json-jq '.data.settings.NOTICE = ""',enable={RewriteNotice}

# 7. 旧版 plans 接口
^https://apidd\.(czssdgz|spthgb|btyjscl)\.com/api/v4/plans.*$ response-body-json-jq '.data.plan_message = ""',enable={RewritePlanMessage}
^https://api\.(aliycloud|ffaoa)\.com/api/v4/plans.*$ response-body-json-jq '.data.plan_message = ""',enable={RewritePlanMessage}

[MITM]
hostname = tp.spfcas.com, apidd.spthgb.com, apidd.czssdgz.com, apidd.btyjscl.com, api.aliycloud.com, api.ffaoa.com, api.liquidlink.cn

[Script]
# No additional scripts needed
