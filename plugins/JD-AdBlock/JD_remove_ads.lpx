#!name=京东去广告 v1.2.0
#!version=1.2.0
#!desc=拦截开屏/搜索组件/滚词典/弹窗/悬浮窗/气泡体系 + xview 图层清洗；部分数据走密文为已知边界。
#!openUrl=https://apps.apple.com/app/id414245413
#!author=RuCu6[https://github.com/RuCu6], Maasea[https://github.com/Maasea]
#!tag=去广告
#!system=
#!system_version=
#!loon_version=3.5.1(998)
#!homepage=https://github.com/Savues/loon-plugin-patches/tree/main/plugins/JD-AdBlock
#!icon=https://raw.githubusercontent.com/Savues/loon-plugin-patches/main/plugins/JD-AdBlock/icon.png
#!date=2026-10-24 20:10:00

[Rule]
URL-REGEX, "^http:\/\/\w{32}\.jddebug\.com\/diagnose\?", REJECT

[Rewrite]
# 版本探针 v2 (version-probe.sh 用, 勿删)
request if ${url} ~= /^https?:\/\/acs\.m\.taobao\.com\/gw\/loon-sim\.probe\.jd_remove_ads/i then reject(200, "1.2.0")
request if ${url} ~= /^https:\/\/api\.m\.jd\.com\/client\.action\?functionId=(searchBoxWord|stationPullService|uniformRecommend\d?)/i then reject_dict(200)

# === 悬浮窗/气泡/轮播体系 (2026-10-24 二进制+HAR 审计) ===
# 首页搜索框角标轮播 (营销轮播 13.7KB)
request if ${url} ~= /^https:\/\/api\.m\.jd\.com\/client\.action\?functionId=cornerCarousel/i then reject_dict(200)
# 用户关怀弹窗 (3.8KB)
request if ${url} ~= /^https:\/\/api\.m\.jd\.com\/client\.action\?functionId=userCaringPattern/i then reject_dict(200)
# 小时达入口气泡
request if ${url} ~= /^https:\/\/api\.m\.jd\.com\/client\.action\?functionId=hourOrder_entrance_bubble/i then reject_dict(200)
# 我的页悬浮样式 readCustomSurfaceList 的营销头图 (清洗保留功能头) — 保守先不动

response if ${url} ~= /^https:\/\/api\.m\.jd\.com\/client\.action\?functionId=basicConfig/i then response.json.replace(["data.JDMessage.socketmonitor.isSocketEstablishedAhead", "data.JDMessage.socketmonitor.isSocketReport", "data.JDHttpToolKit.httpdns.httpdns"], [0, 0, 0])

[Script]
response if ${url} ~= /^https:\/\/api\.m\.jd\.com\/client\.action/i then script("https://raw.githubusercontent.com/Savues/loon-plugin-patches/main/plugins/JD-AdBlock/src/xview2_config.js") with tag="xview弹窗图层清洗", requires_body=true

response if ${url} ~= /^https:\/\/api\.m\.jd\.com\/client\.action\?functionId=(deliverLayer|getTabHomeInfo|myOrderInfo|orderTrackBusiness|personinfoBusiness|start|welcomeHome)/i then script("https://raw.githubusercontent.com/Savues/loon-plugin-patches/main/plugins/JD-AdBlock/src/JD_remove_ads.js") with tag="移除京东广告", requires_body=true

[MitM]
hostname=api.m.jd.com, acs.m.taobao.com