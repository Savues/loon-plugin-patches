#!name=开屏节日定制(Splash Festival) TEST
#!desc=【测试版】只注入固定 show（中秋 id=38），无视所有节日逻辑。纯测试拦截是否生效。
#!author=Savues
#!tag=开屏,Splash,Bilibili
#!system=iOS, iPadOS
#!system_version=15
#!loon_version=3.4.0(962)
#!homepage=https://github.com/Savues/loon-plugin-patches
#!icon=https://raw.githubusercontent.com/Savues/loon-plugin-patches/main/plugins/Bilibili-Dedup/icon.png
#!date=2026-10-19

[Argument]
enabled = switch,true,tag=启用测试拦截,desc=测试拦截是否生效

[Rule]

[Script]
http-response ^https?:\/\/app\.bilibili\.com\/x\/v2\/splash\/brand\/list\? requires-body=1, script-path=https://raw.githubusercontent.com/Savues/loon-plugin-patches/main/plugins/Splash-Festival/splash-test.js, argument=[{enabled}], tag=测试拦截, enable={enabled}

[Mitm]
hostname=app.bilibili.com
h2 = true