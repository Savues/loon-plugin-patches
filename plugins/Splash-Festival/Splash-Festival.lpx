#!name=开屏节日定制(Splash Festival)
#!desc=强制展示指定节日品牌皮肤（中秋/重阳）。测试插件：拦截 splash/show 注入节日条目。
#!author=Savues
#!tag=开屏,Splash,Bilibili
#!system=iOS, iPadOS
#!system_version=15
#!loon_version=3.4.0(962)
#!homepage=https://github.com/Savues/loon-plugin-patches
#!icon=https://raw.githubusercontent.com/Savues/loon-plugin-patches/main/plugins/Bilibili-Dedup/icon.png
#!date=2026-10-18 02:00:00

[Argument]
festival = select,"midautumn","chongyang",tag=节日皮肤,desc=选择展示的节日品牌皮肤
enabled = switch,true,tag=启用,desc=拦截 splash/show 并注入节日条目

[Rule]
# 占位：本插件全部逻辑在 [Script]，无需 Rule

[Script]
# 拦截 splash/show，把 show 数组替换为选中节日条目
# 脚本字段取自 brand/list 抓包（2026-10）。若客户端 splash/show 为空时只走本地
# 节日表、忽略 show 里的品牌条目 → 注入无效，表现为开屏无变化（预期大概率如此）。
# 同时处理 200（show=[]）与 -304（data=null）两种输入。
http-response ^https?:\/\/app\.bilibili\.com\/x\/v2\/splash\/show\? requires-body=1, script-path=https://raw.githubusercontent.com/Savues/loon-plugin-patches/main/plugins/Splash-Festival/splash-poc.js, argument=[{festival}], tag=节日开屏注入, enable={enabled}

[Mitm]
# 不变量：每个域名都要有规则作用于它。
hostname=app.bilibili.com
h2 = true
