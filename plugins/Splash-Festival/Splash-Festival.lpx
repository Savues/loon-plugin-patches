#!name=开屏节日定制(Splash Festival) v2
#!desc=强制展示指定节日品牌皮肤（10个节日可选）。拦截 splash/brand/list 的 show 数组注入排期条目。
#!author=Savues
#!tag=开屏,Splash,Bilibili
#!system=iOS, iPadOS
#!system_version=15
#!loon_version=3.4.0(962)
#!homepage=https://github.com/Savues/loon-plugin-patches
#!icon=https://raw.githubusercontent.com/Savues/loon-plugin-patches/main/plugins/Bilibili-Dedup/icon.png
#!date=2026-10-18 02:36:00

[Argument]
festival = select,"midautumn","chongyang","yuandan","duanwu","qixi","halloween","xmas1","xmas2","women","labor",tag=节日皮肤,desc=选择展示的节日品牌皮肤
enabled = switch,true,tag=启用,desc=拦截 splash/brand/list 并注入节日排期

[Rule]
# 占位：本插件全部逻辑在 [Script]，无需 Rule

[Script]
# 拦截 splash/brand/list，把 data.show 数组替换为选中节日条目（带 begin_time/end_time 排期）
# v2: 支持 10 个节日（中秋/重阳/元旦/端午/七夕/万圣节/圣诞1.0/圣诞2.0/妇女节/劳动节）
http-response ^https?:\/\/app\.bilibili\.com\/x\/v2\/splash\/brand\/list\? requires-body=1, script-path=https://raw.githubusercontent.com/Savues/loon-plugin-patches/main/plugins/Splash-Festival/splash-poc.js, argument=[{festival}], tag=节日开屏注入, enable={enabled}

[Mitm]
# 不变量：每个域名都要有规则作用于它。
hostname=app.bilibili.com
h2 = true
