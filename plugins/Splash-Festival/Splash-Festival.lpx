#!name=开屏节日定制(Splash Festival) v6
#!desc=强制展示指定节日/活动品牌皮肤（53个官方皮肤可选），或屏蔽节日开屏。双端点注入：splash/brand/list + splash/show。
#!author=Savues
#!tag=开屏,Splash,Bilibili
#!system=iOS, iPadOS
#!system_version=15
#!loon_version=3.4.0(962)
#!homepage=https://github.com/Savues/loon-plugin-patches
#!icon=https://raw.githubusercontent.com/Savues/loon-plugin-patches/main/plugins/Bilibili-Dedup/icon.png
#!date=2026-10-18 02:57:00

[Argument]
festival = select,"midautumn","chongyang","yuandan","duanwu","qixi","halloween","xmas1","xmas2","women","labor","bili10","bili11","bili12","bili13","bml2021","bw2020","bw2021","2233a","2233b","2233c","2233d","slogan","gaokao24","duanwu24","summer24","qixi24","chongyang24","teacher24","midautumn24","cj25a","cj25b","cj25c","cj25d","cj25e","cj25f","yx25","women25","qm25","labor25","labor25b","duanwu25","gaokao25","summer25","qixi25","teacher25","midautumn25","cj26a","cj26b","cj26c","labor26","gaokao26","duanwu26","midautumn26","block",tag=节日皮肤,desc=选择展示的节日/活动品牌皮肤，或选择 block 屏蔽节日开屏
enabled = switch,true,tag=启用,desc=双端点注入 splash/brand/list + splash/show

[Rule]
# 占位：本插件全部逻辑在 [Script]，无需 Rule

[Script]
# 双端点注入：splash/brand/list (list条目+show排期) + splash/show (完整字段)
# v6: 历史皮肤需要两个端点都注入才能生效
http-response ^https?:\/\/app\.bilibili\.com\/x\/v2\/splash\/brand\/list\? requires-body=1, script-path=https://raw.githubusercontent.com/Savues/loon-plugin-patches/main/plugins/Splash-Festival/splash-poc.js, argument=[{festival}], tag=节日开屏brand注入, enable={enabled}
http-response ^https?:\/\/app\.bilibili\.com\/x\/v2\/splash\/show\? requires-body=1, script-path=https://raw.githubusercontent.com/Savues/loon-plugin-patches/main/plugins/Splash-Festival/splash-poc.js, argument=[{festival}], tag=节日开屏show注入, enable={enabled}

[Mitm]
# 不变量：每个域名都要有规则作用于它。
hostname=app.bilibili.com
h2 = true
