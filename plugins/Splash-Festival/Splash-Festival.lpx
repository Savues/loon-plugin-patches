#!name=开屏节日定制(Splash Festival) v40.2
#!desc=强制展示指定节日/活动品牌皮肤（22官方+53历史共75个），或屏蔽节日开屏。补齐 forcibly/select_show_list/selectList 门控字段，非节日也能生效。新增自动节日（含农历）/轮换/随机。
#!author=Savues
#!tag=开屏,Splash,Bilibili
#!system=iOS, iPadOS
#!system_version=15
#!loon_version=3.4.0(962)
#!homepage=https://github.com/Savues/loon-plugin-patches
#!icon=https://raw.githubusercontent.com/Savues/loon-plugin-patches/main/plugins/Bilibili-Dedup/icon.png
#!date=2026-10-20 00:40:00

[Argument]
festival = select,"中秋节","重阳节","元旦","端午节","七夕节","万圣节","圣诞节1.0","圣诞节2.0","妇女节","劳动节","10周年","11周年","12周年","13周年","BML 2021","BW 2020","BW 2021","2233款式一","2233款式二","2233款式三","2233款式四","Slogan","自动节日","随机","随机·全部","随机·半透明","轮换","轮换·全部","轮换·半透明","屏蔽开屏","2022春节-除夕","2022春节-初一","2022春节-初二","2022春节-初三","2022春节-初四","2022春节-初五","2022春节-初六","2022春节-初七","2022劳动节","2022端午节","2023春节-除夕","2023春节-初一","2023春节-初三","2023春节-初四","2023春节-初五","2023春节-初六","2023春节-初七","2023跨年","2024春节-款式一","2024春节-款式二","2024春节-款式三","2024春节-款式四","2024春节-款式五","2024春节-款式六","2025春节-打铁花","2025春节-放御灯","2025春节-滚灯球","2025春节-聚天宫","2025春节-跨火盆","2025春节-舞龙狮","2026春节-马灯笼","2026春节-马头琴","2026春节-马球","2024元宵节","2025元宵节","2024妇女节","2025妇女节","2024清明","2025清明","2024劳动节","2025劳动节","2023端午节","2024端午节","2025端午节","2026端午节","2023暑假过半","2024暑假快乐","2025暑假过半","2023七夕节","2023七夕款式二","2023七夕款式三","2023七夕款式四","2023七夕款式五","2023七夕款式六","2024七夕节","2025七夕节","2023中秋节","2024中秋节","2025中秋节","2026中秋节","2024重阳节","2024教师节","2025教师节","2023万圣节款式一","2023万圣节款式二","2024高考","2025高考","2026高考","2026五一","2023开学季","生日快乐","注册五周年","2024新年","2233-初","2233-小电视","十二周年",tag=节日皮肤,desc=自动节日=按当天日期自动选皮肤（含农历，优先用今年的历史皮肤）；随机/轮换=每次冷启动换一个皮肤（默认官方22个，·全部=98个，·半透明=8张透明角色图）；也可选「屏蔽开屏」彻底屏蔽开屏（清 show/select_show_list/selectList/preload 并归零 forcibly，客户端不创建开屏视图）
enabled = switch,true,tag=启用,desc=开启后冷启动 B 站生效
splashMode = select,"official","full","half",tag=显示模式,desc=官方=按官方设定（full铺满/half缩放，默认）；full=强制铺满全屏；half=强制缩放完整不裁切
imgMode = select,"auto","landscape","portrait",tag=图片方向,desc=auto=按设备自动（iPad用横图/手机用竖图，默认）；landscape=强制横图；portrait=强制竖图
logo = select,"官方","隐藏",tag=B站logo,desc=官方=保留官方Bilibili角标（默认）；隐藏=不叠加logo角标（历史满版插画上更干净）
duration = select,"官方","1毫秒","10毫秒","50毫秒","0.1秒","0.2秒","0.5秒","1秒","2秒","3秒","5秒",tag=显示时长,desc=官方=按服务器设定（默认）；数值越小越接近跳过开屏（0 会被客户端当成未设置，故不提供）。注意：必须有「特殊开屏图」时客户端才读该参数——用「屏蔽开屏」会让它回落默认图+默认时长

[Rule]
# 占位：本插件全部逻辑在 [Script]，无需 Rule

[Script]
# 拦截 splash/brand/list：替换 data.show 为选中节日条目，并补齐 forcibly / select_show_list / selectList 门控字段
# v16: 22 官方皮肤 + 31 历史皮肤（thumb 替换）+ block 屏蔽模式
http-response ^https?:\/\/app\.bilibili\.com\/x\/v2\/splash\/brand\/list\? requires-body=1, script-path=https://raw.githubusercontent.com/Savues/loon-plugin-patches/main/plugins/Splash-Festival/splash-poc.js?v=41, argument=[{festival},{splashMode},{imgMode},{logo},{duration}], tag=节日开屏注入, enable={enabled}

[Mitm]
# 不变量：每个域名都要有规则作用于它。
hostname=app.bilibili.com
h2 = true
