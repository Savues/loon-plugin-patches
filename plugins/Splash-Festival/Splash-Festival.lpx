#!name=开屏节日定制(Splash Festival) v30
#!desc=强制展示指定节日/活动品牌皮肤（22官方+31历史共53个），或屏蔽节日开屏。历史皮肤通过官方URL替换实现。
#!author=Savues
#!tag=开屏,Splash,Bilibili
#!system=iOS, iPadOS
#!system_version=15
#!loon_version=3.4.0(962)
#!homepage=https://github.com/Savues/loon-plugin-patches
#!icon=https://raw.githubusercontent.com/Savues/loon-plugin-patches/main/plugins/Bilibili-Dedup/icon.png
#!date=2026-10-18 17:28:00

[Argument]
festival = select,"官方-中秋节=midautumn","官方-重阳节=chongyang","官方-元旦=yuandan","官方-端午节=duanwu","官方-七夕节=qixi","官方-万圣节=halloween","官方-圣诞节1.0=xmas1","官方-圣诞节2.0=xmas2","官方-妇女节=women","官方-劳动节=labor","官方-10周年=bili10","官方-11周年=bili11","官方-12周年=bili12","官方-13周年=bili13","官方-BML 2021=bml2021","官方-BW 2020=bw2020","官方-BW 2021=bw2021","官方-2233款式一=2233a","官方-2233款式二=2233b","官方-2233款式三=2233c","官方-2233款式四=2233d","官方-Slogan=slogan","屏蔽开屏=block","2024高考=gaokao24","2024端午节=duanwu24","2024暑假快乐=summer24","2024七夕节=qixi24","2024重阳节=chongyang24","2024教师节=teacher24","2024中秋节=midautumn24","2025春节-打铁花=cj25a","2025春节-放御灯=cj25b","2025春节-滚灯球=cj25c","2025春节-聚天宫=cj25d","2025春节-跨火盆=cj25e","2025春节-舞龙狮=cj25f","2025元宵节=yx25","2025妇女节=women25","2025清明=qm25","2025劳动节=labor25","2025国际劳动节=labor25b","2025端午节=duanwu25","2025高考=gaokao25","2025暑假过半=summer25","2025七夕节=qixi25","2025教师节=teacher25","2025中秋节=midautumn25","2026春节-马灯笼=cj26a","2026春节-马头琴=cj26b","2026春节-马球=cj26c","2026五一=labor26","2026高考=gaokao26","2026端午节=duanwu26","2026中秋节=midautumn26",tag=节日皮肤,desc=选择展示的节日/活动品牌皮肤（22官方+31历史），或选择 block 屏蔽节日开屏
enabled = switch,true,tag=启用,desc=开启后冷启动 B 站生效
splashMode = select,"official","full","half",tag=显示模式,desc=官方=按官方设定（full铺满/half缩放，默认）；full=强制铺满全屏；half=强制缩放完整不裁切
imgMode = select,"auto","landscape","portrait",tag=图片方向,desc=auto=按设备自动（iPad用横图/手机用竖图，默认）；landscape=强制横图；portrait=强制竖图

[Rule]
# 占位：本插件全部逻辑在 [Script]，无需 Rule

[Script]
# 拦截 splash/brand/list，把 data.show 数组替换为选中节日条目（带 begin_time/end_time 排期）
# v16: 22 官方皮肤 + 31 历史皮肤（thumb 替换）+ block 屏蔽模式
http-response ^https?:\/\/app\.bilibili\.com\/x\/v2\/splash\/brand\/list\? requires-body=1, script-path=https://raw.githubusercontent.com/Savues/loon-plugin-patches/main/plugins/Splash-Festival/splash-poc.js, argument=[{festival},{splashMode},{imgMode}], tag=节日开屏注入, enable={enabled}

[Mitm]
# 不变量：每个域名都要有规则作用于它。
hostname=app.bilibili.com
h2 = true
