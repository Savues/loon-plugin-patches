[Script]
http-response ^https?:\/\/app\.bilibili\.com\/x\/v2\/account\/mine\/ipad requires-body=1, script-path=https://raw.githubusercontent.com/Savues/loon-plugin-patches/main/plugins/Bilibili-UI/Enhanced-mine-body-debug.response.js?v=3, tag=我的页字段测试-BodyDebug
[Mitm]
hostname=app.bilibili.com
h2 = true