#!name=哔哩哔哩界面增强 v2
#!desc=首页标签页、顶栏、标签栏按钮、底部导航、分区页、我的页 全部支持真开关点选。已彻底移除 BoxJS 与 PersistentStore。需启用 MitM over HTTP/2。「我的」页与 Bilibili-Dedup 的会员伪装同端点，默认关闭。
#!author=原作者: VirgilClyne, app2smile, Maasea (Biliverse) | 真开关改造+去BoxJS: Savues
#!homepage=https://github.com/Savues/loon-plugin-patches
#!icon=https://github.com/Biliverse/Enhanced/raw/main/src/assets/icon_rounded.png
#!tag=界面增强,Bilibili
#!system=iOS, iPadOS
#!system_version=15
#!loon_version=3.4.0(962)
#!date=2026-09-28 02:10:00
# ==== PLUGIN_VERSION: 2.0.2 | BUILD_BY: Savues | 参数按规则拆分 ====

[Argument]

# ===== 首页 · 标签页（多选）=====
Home.Tab_2036 = switch,false,tag=[首页] 标签页 直播
Home.Tab_2037 = switch,true,tag=[首页] 标签页 推荐
Home.Tab_780 = switch,true,tag=[首页] 标签页 热门
Home.Tab_545 = switch,true,tag=[首页] 标签页 番剧
Home.Tab_774 = switch,false,tag=[首页] 标签页 动画（港澳台）
Home.Tab_151 = switch,true,tag=[首页] 标签页 影视
Home.Tab_801 = switch,false,tag=[首页] 标签页 韩综（港澳台）
Home.Tab_2280 = switch,false,tag=[首页] 标签页 校园
Home.Tab_default = select,"2037","2036","780","545","774","151","801","2280",tag=[首页] 默认标签页,desc=需先在上方勾选该项
# ===== 顶栏 · 左侧头像（单选）=====
Home.Top_left = select,"mine","videoshortcut",tag=[顶栏] 左侧头像作用,desc=mine=我的 / videoshortcut=视频快捷方式；粉色版不可改
# ===== 顶栏 · 右侧按钮（多选）=====
Home.Top_messages = switch,true,tag=[顶栏] 消息
Home.Top_game_center = switch,false,tag=[顶栏] 游戏中心,desc=⚠️部分版本可能已下线
Home.Top_mall = switch,false,tag=[顶栏] 会员购
# ===== 标签栏 · 右侧按钮（多选）=====
Home.TopMore_categories = switch,true,tag=[标签栏] 更多分区
Home.TopMore_search = switch,true,tag=[标签栏] 搜索
# ===== 底部 · 导航栏（多选，最多 6 个）=====
Home.Bot_home = switch,true,tag=[底部] 首页
Home.Bot_channel = switch,false,tag=[底部] 频道,desc=⚠️部分版本可能已下线
Home.Bot_dynamic = switch,true,tag=[底部] 动态
Home.Bot_publish = switch,false,tag=[底部] 发布,desc=⚠️部分版本可能已下线
Home.Bot_ogv = switch,true,tag=[底部] 番剧
Home.Bot_mall = switch,true,tag=[底部] 会员购
Home.Bot_messages = switch,true,tag=[底部] 消息
Home.Bot_mine = switch,true,tag=[底部] 我的
# ===== 其他 =====
Home.Switch = switch,true,tag=[首页] 启用自定义
Home.Tab = input,"",tag=[首页] 备用输入框,desc=仅当上方标签页开关一个都没开时生效。逗号分隔，可填接口下发的其他 id
Region.Switch = switch,true,tag=[分区] 启用自定义
Mine.Switch = switch,false,tag=[我的] 启用自定义,desc=⚠️默认关。与 Bilibili-Dedup 的会员伪装同端点
Mine.iPad.Switch = switch,false,tag=[我的iPad] 启用自定义,desc=⚠️同上
LogLevel = select,"WARN","OFF","ERROR","INFO","DEBUG","ALL",tag=[调试] 日志等级

[Script]
http-response ^https?:\/\/app\.bili(bili\.com|api\.net)\/x\/resource\/show\/tab\/v2\? script-path=https://raw.githubusercontent.com/Savues/loon-plugin-patches/main/plugins/Bilibili-UI/Enhanced.response.js, requires-body=1, argument=[{Home.Switch},{Home.Tab_2036},{Home.Tab_2037},{Home.Tab_780},{Home.Tab_545},{Home.Tab_774},{Home.Tab_151},{Home.Tab_801},{Home.Tab_2280},{Home.Tab_default},{Home.Tab},{Home.Top_left},{Home.Top_messages},{Home.Top_game_center},{Home.Top_mall},{Home.TopMore_categories},{Home.TopMore_search},{Home.Bot_home},{Home.Bot_channel},{Home.Bot_dynamic},{Home.Bot_publish},{Home.Bot_ogv},{Home.Bot_mall},{Home.Bot_messages},{Home.Bot_mine},{LogLevel}], tag=顶栏标签底部
http-response ^https?:\/\/app\.bili(bili\.com|api\.net)\/x\/v2\/region\/index\? script-path=https://raw.githubusercontent.com/Savues/loon-plugin-patches/main/plugins/Bilibili-UI/Enhanced.response.js, requires-body=1, argument=[{Region.Switch},{LogLevel}], tag=分区页
http-response ^https?:\/\/app\.bili(bili\.com|api\.net)\/x\/v2\/channel\/region\/list\? script-path=https://raw.githubusercontent.com/Savues/loon-plugin-patches/main/plugins/Bilibili-UI/Enhanced.response.js, requires-body=1, argument=[{Region.Switch},{LogLevel}], tag=分区列表
http-response ^https?:\/\/(grpc|app)\.bili(bili\.com|api\.net)\/bilibili\.app\.show\.v1\.Mixture\/Region(List|Shortcut)$ script-path=https://raw.githubusercontent.com/Savues/loon-plugin-patches/main/plugins/Bilibili-UI/Enhanced.response.js, requires-body=1, binary-body-mode=1, argument=[{Region.Switch},{LogLevel}], tag=分区grpc
http-response ^https?:\/\/app\.bili(bili\.com|api\.net)\/x\/v2\/account\/mine(\/ipad)?\? script-path=https://raw.githubusercontent.com/Savues/loon-plugin-patches/main/plugins/Bilibili-UI/Enhanced.response.js, requires-body=1, argument=[{Mine.Switch},{Mine.iPad.Switch},{LogLevel}], tag=我的页

[Mitm]
hostname=app.bilibili.com, app.biliapi.net, grpc.biliapi.net
h2 = true
