[Script]
http-response ^https?:\/\/app\.bilibili\.com\/x\/v2\/account\/mine\/ipad\? script-path=https://raw.githubusercontent.com/Savues/loon-plugin-patches/main/plugins/Bilibili-UI/Enhanced-mine-debug.response.js, requires-body=1, argument=[{Mine.Enable},{Mine.HideIds},{Mine.HideTitles},{Mine.Order},{Mine.BlockUpper},{Mine.BlockRecommend},{Mine.BlockMore},{Mine.SectionStyle},{LogLevel}], tag=我的页字段测试-Debug
[Mitm]
hostname=app.bilibili.com
h2 = true