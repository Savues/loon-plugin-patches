#!name=哔哩哔哩界面增强 诊断版
#!desc=首页标签页、顶栏、标签栏按钮、底部导航、分区页、我的页 全部支持真开关点选。已彻底移除 BoxJS 与 PersistentStore。需启用 MitM over HTTP/2。「我的」页与 Bilibili-Dedup 的会员伪装同端点，默认关闭。
#!author=原作者: VirgilClyne, app2smile, Maasea (Biliverse) | 真开关改造+去BoxJS: Savues
#!homepage=https://github.com/Savues/loon-plugin-patches
#!icon=https://github.com/Biliverse/Enhanced/raw/main/src/assets/icon_rounded.png
#!tag=界面增强,Bilibili
#!system=iOS, iPadOS
#!system_version=15
#!loon_version=3.4.0(962)
#!date=2026-09-28 03:05:00
# ==== v2.1.0 | 真值判断已放宽（兼容 1/"1"/on/ON）====

[Argument]
# 只保留标签页相关参数（其余开关本版暂不启用）
Home.Tab_2036 = switch,false,tag=[首页] 标签页 直播
Home.Tab_2037 = switch,true,tag=[首页] 标签页 推荐
Home.Tab_780 = switch,true,tag=[首页] 标签页 热门
Home.Tab_545 = switch,true,tag=[首页] 标签页 番剧
Home.Tab_774 = switch,false,tag=[首页] 标签页 动画（港澳台）
Home.Tab_151 = switch,true,tag=[首页] 标签页 影视
Home.Tab_801 = switch,false,tag=[首页] 标签页 韩综（港澳台）
Home.Tab_2280 = switch,false,tag=[首页] 标签页 校园
Home.Tab_default = select,"2037","2036","780","545","774","151","801","2280",tag=[首页] 默认标签页,desc=需先在上方勾选该项
Home.Switch = switch,true,tag=[首页] 启用自定义
Home.Tab = input,"",tag=[首页] 备用输入框,desc=仅当上方标签页开关一个都没开时生效。逗号分隔，可填接口下发的其他 id
LogLevel = select,"WARN","OFF","ERROR","INFO","DEBUG","ALL",tag=[调试] 日志等级
[Script]
http-response ^https?:\/\/app\.bili(bili\.com|api\.net)\/x\/resource\/show\/tab\/v2\? script-path=https://raw.githubusercontent.com/Savues/loon-plugin-patches/main/plugins/Bilibili-UI/Enhanced.response.js, requires-body=1, argument=[{Home.Switch},{Home.Tab_2036},{Home.Tab_2037},{Home.Tab_780},{Home.Tab_545},{Home.Tab_774},{Home.Tab_151},{Home.Tab_801},{Home.Tab_2280},{Home.Tab_default},{Home.Tab},{LogLevel}], tag=顶栏标签底部

[Mitm]
hostname=app.bilibili.com, app.biliapi.net, grpc.biliapi.net
h2 = true