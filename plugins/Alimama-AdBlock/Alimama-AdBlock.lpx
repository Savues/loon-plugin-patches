#!name=Alimama-AdBlock v1.5.0
#!desc=阿里妈妈 Moon App 去广告 · 开屏/弹窗/小卡片/公告栏/埋点全拦截
#!system=ios
#!version=1.0.1

[MITM]
hostname = acs.m.taobao.com, gm.mmstat.com, log.mmstat.com, px.effirst.com, abtest.alibaba.com
h2 = true

[Argument]
removeSplashAd = switch, true, false, tag=开屏广告, desc=拦截 open_screen_site (开屏图/跳转/倒计时)
removePopWindow = switch, true, false, tag=弹窗广告, desc=拦截 pop_window_site (弹窗/浮层)
removeSmallCards = switch, true, false, tag=小卡片/公告栏/推荐词, desc=拦截 small_handler_* / bulletin_board_* / marquee / TAC / metax热词
removeFeedKeywords = switch, false, true, tag=Feed关键词过滤, desc=拦截首页推荐流中含指定关键词的商品 (霸王何首乌等)
removePrivateDomain = switch, true, false, tag=私域动态, desc=拦截关注会员/私域动态 (union.pub.entry followMembers)
blockTracking = switch, true, false, tag=埋点上报, desc=拦截 gm.mmstat.com / log.mmstat.com / px.effirst.com / abtest.alibaba.com

[Script]
http-response ^https?:\/\/acs\.m\.taobao\.com\/gw\/mtop\.alimama\.union\.skyleap\.distribution\.batchsite\/.* script-path=https://raw.githubusercontent.com/Savues/loon-plugin-patches/main/plugins/Alimama-AdBlock/src/remove_ads.js, requires-body=true, timeout=30, argument={removeSplashAd, removePopWindow, removeSmallCards}, tag=阿里妈妈批量广告分发
http-response ^https?:\/\/acs\.m\.taobao\.com\/gw\/mtop\.taobao\.union\.marquee\.query script-path=https://raw.githubusercontent.com/Savues/loon-plugin-patches/main/plugins/Alimama-AdBlock/src/remove_ads.js, requires-body=true, timeout=30, argument={removeSmallCards}, tag=搜索框跑马灯热词
http-response ^https?:\/\/acs\.m\.taobao\.com\/gw\/mtop\.alimama\.moon\.provider\.tac\.service\.call script-path=https://raw.githubusercontent.com/Savues/loon-plugin-patches/main/plugins/Alimama-AdBlock/src/remove_ads.js, requires-body=true, timeout=30, argument={removeSmallCards}, tag=搜索框推荐词-TAC基础
http-response ^https?:\/\/acs\.m\.taobao\.com\/gw\/mtop\.alimama\.moon\.provider\.tac\.service\.smart\.call script-path=https://raw.githubusercontent.com/Savues/loon-plugin-patches/main/plugins/Alimama-AdBlock/src/remove_ads.js, requires-body=true, timeout=30, argument={removeSmallCards}, tag=搜索框推荐词-TAC智能
http-response ^https?:\/\/acs\.m\.taobao\.com\/gw\/mtop\.alimama\.moon\.provider\.metax\.homepage\.query script-path=https://raw.githubusercontent.com/Savues/loon-plugin-patches/main/plugins/Alimama-AdBlock/src/remove_ads.js, requires-body=true, timeout=30, argument={removeSmallCards}, tag=首页搜索栏热词
http-response ^https?:\/\/acs\.m\.taobao\.com\/gw\/mtop\.alimama\.union\.pub\.entry script-path=https://raw.githubusercontent.com/Savues/loon-plugin-patches/main/plugins/Alimama-AdBlock/src/remove_ads.js, requires-body=true, timeout=30, argument={removePrivateDomain}, tag=私域动态/关注会员

[Rewrite]
# 埋点/错误上报/APM/实验分流 —— 直接 Reject
^https?://gm\.mmstat\.com/ reject
^https?://log\.mmstat\.com/ reject
^https?://px\.effirst\.com/ reject
^https?://abtest\.alibaba\.com/ reject
^https?://s-gm\.mmstat\.com/ reject

# 可选：保留阿里妈妈其他正常 API 不解密（如需可取消注释）
# DOMAIN-SUFFIX, afpapi.alimama.com, REJECT

[Task]
# 无定时任务