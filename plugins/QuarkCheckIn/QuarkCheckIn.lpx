#!name=夸克网盘签到
#!desc=每天自动签到领网盘空间：7 天一轮（普通会员 20-100MB/天，SVIP 最高 1024MB/天），自动签到默认开启，附带奖励与余额查询。
#!author=@Savues <https://github.com/Savues>
#!homepage=https://github.com/Savues/loon-plugin-patches/tree/main/plugins/QuarkCheckIn
#!date=2026-09-29
#!icon=https://raw.githubusercontent.com/MaYIHEI/paperclip/refs/heads/main/app/agentrouter/icon.png
#!tag=签到

[Argument]
auto = switch,false,tag=每日自动签到,desc=多设备只需一台打开；关着时仍可在插件页手动触发这条 cron

[Script]
cron "0 9 * * *" script-path=https://raw.githubusercontent.com/Savues/loon-plugin-patches/main/plugins/QuarkCheckIn/quark_checkin.js, tag=自动签到, img-url=calendar.badge.clock, timeout=60, enable={auto}
