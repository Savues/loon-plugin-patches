#!name=IT之家去广告（增强版）
#!desc=过滤 IT之家信息流广告与文末广告：带货文识别（联盟链接特征 ≥2 命中）、事件日历卡片、置顶轮播可配置移除。
#!openUrl=https://apps.apple.com/app/id570610859
#!author=@Savues <https://github.com/Savues>
#!tag=去广告
#!system=
#!system_version=
#!loon_version=3.5.1(998)
#!homepage=https://github.com/Savues/loon-plugin-patches/tree/main/plugins/IThome-AdBlock
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/IThome.png
#!date=2026-10-20 18:00:00

[Argument]
removeWebViewCards = switch, true, false, tag=移除活动卡片（双11红包等）, desc=移除 feedType 10004 以及指向广告/活动域名的 WebView 卡片
removeFeedAds = switch, true, false, tag=移除信息流广告, desc=移除 flag=2 或标记为「广告」的信息流条目
removeBannerAds = switch, true, false, tag=移除轮播图内广告位, desc=移除轮播图 focusNewsData 中 isAd=true 的条目
removeEcommerceArticles = switch, true, false, tag=移除电商带货文章, desc=移除正文含京东/淘宝联盟链接或带货商品卡的文章（含数码促销文，误杀可关）
removeEventCalendar = switch, true, false, tag=移除事件日历卡片, desc=移除信息流中的「事件日历」卡片（feedType 10029）
removeAllBanners = switch, true, false, tag=移除整个轮播图, desc=启用后将移除顶部轮播图（feedType 10002）
removePinnedArticles = switch, true, false, tag=移除置顶文章, desc=启用后将移除置顶文章（feedType 10003）
hideTopbarCompletely = switch, false, true, tag=完全隐藏顶栏, desc=启用后完全隐藏顶部标签栏，内容默认加载"最新"标签页（gethomefeeds）

[Rewrite]
request if ${url} ~= /^https?:\/\/dat\.ruanmei\.com\/ithome\/money\/acd\.json$/i then reject(404)

[Script]
response if ${url} ~= /^https:\/\/napi\.ithome\.com\/api\/(news\/(indexv2\/iphone\/\d+|gethotbang\/\d+)|topmenu\/(getall|getfeeds\?|gethomefeeds\?|getmenufeeds\/\d+\/\d+\/iphone\/\d+)|newsevent\/geteventfeed\?|appsplash\/get)/i then script("https://raw.githubusercontent.com/Savues/loon-plugin-patches/main/plugins/IThome-AdBlock/src/IThome_remove_ads.js?v=15", {${removeWebViewCards}, ${removeFeedAds}, ${removeBannerAds}, ${removeAllBanners}, ${removePinnedArticles}, ${removeEcommerceArticles}, ${removeEventCalendar}, ${hideTopbarCompletely}}) with tag="IT之家去广告", requires_body=true

[Rule]
DOMAIN,knicks.jd.com,REJECT

[MitM]
hostname=napi.ithome.com, api.zuihuimai.com, dat.ruanmei.com
