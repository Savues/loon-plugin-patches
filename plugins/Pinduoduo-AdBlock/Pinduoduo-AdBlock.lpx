#!name=拼多多去广告 v2.0.0
#!desc=基于 PinDuoDuo v1.75 重构：移除开屏广告、会场入口，精简首页和个人中心；底栏按钮可自定义；百亿补贴页搜索框推广词。修复埋点拦截失效问题。
#!openUrl=https://apps.apple.com/app/id1044283059
#!author=Savues
#!tag=去广告
#!system=ios
#!system_version=15.0
#!loon_version=3.5.0
#!homepage=https://github.com/Savues/loon-plugin-patches
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/PinDuoDuo.png
#!date=2026-10-21

[Argument]
# ===== 高危：接口响应体改写 =====
api_stub = switch,true,false,tag=[高危] 屏蔽会场/推荐类接口(13 条),desc=关闭后这些端点返回真实数据;首页去广告与底栏裁剪同时失效
chat_stub = switch,false,false,tag=[高危] 屏蔽聊天相关接口(4 条),desc=默认关闭；打开后屏蔽 new_chat_group / get_list_data 等，聊天可正常刷新
phantom_stub = switch,false,false,tag=[高危] 屏蔽 phantom 风控模块,desc=默认关闭；与消息推送 WebSocket 同模块(xg.pinduoduo.com/api/phantom/_stm)，怀疑被风控时可尝试打开
order_stub = switch,true,false,tag=[高危] 屏蔽订单列表,desc=关掉后订单页会显示真实订单;若不想在订单页看到列表可关
search_stub = switch,true,false,tag=[高危] 屏蔽搜索框轮播推荐词,desc=拦 /search_hotquery /search_suggest 并删 /search 的 expansion 字段;搜索框仍显示「酷态科cp12」这类词时检查本项
# ===== 底栏自定义 =====
bottom_custom = switch,true,tag=[底栏] 启用自定义底栏
Bot_index = switch,true,tag=[底栏] 首页
Bot_chat = switch,true,tag=[底栏] 聊天
Bot_personal = switch,true,tag=[底栏] 我的
Bot_live = switch,false,tag=[底栏] 多多视频
Bot_class = switch,false,tag=[底栏] 分类
Bot_attendance = switch,false,tag=[底栏] 签到
Bot_custom = input,"",tag=[底栏] 自定义项(逗号分隔),desc=按 link 包含匹配,逗号分隔;一个都不选时回落首页/聊天/我的

[Rule]
DOMAIN, titan.pinduoduo.com, REJECT
DOMAIN, cdl-1.pddpic.com, REJECT
DOMAIN, cdl-p2.pddpic.com, REJECT
DOMAIN, cd-1.pddpic.com, REJECT

[Rewrite]
^https:\/\/api\.pinduoduo\.com\/api\/philo\/personal\/hub\? response-body-json-del monthly_card_entrance personal_center_style_v2_vo icon_set.icons icon_set.top_personal_icons personal_banner
^https:\/\/api\.pinduoduo\.com\/api\/oak\/integration\/render\? response-body-json-del bottom_section_list ui.bottom_section ui.live_section.float_info
^https:\/\/api\.pinduoduo\.com\/api\/caterham\/v3\/query\/order_detail_group\? response-body-json-del data.goods_list
^https:\/\/api\.pinduoduo\.com\/order\/ response-body-json-del marketing_banner_vo shipping.banner_above_recommend
^https:\/\/api\.pinduoduo\.com\/api\/aristotle\/order_list_v4\? response-body-json-jq '.orders |= map(.order_buttons |= map(del(.order_growth_tip)))'

[Script]
http-response ^https:\/\/api\.pinduoduo\.com\/(search_hotquery|search_suggest|search|api\/aristotle\/(unrated_order_for_unreceived_tab|query_order_list_tabs_element)|api\/aquarius\/hungary\/global\/homepage|api\/caterham\/(v2\/query\/goods_detail_with_tags|v3\/query\/(order_express_group|likes|my_order_group|new_chat_group|personal))|api\/alexa\/goods\/back_up|api\/brand-olay\/goods_detail\/bybt_guide|api\/engels\/(reviews\/require\/append|wait\/receive\/review)|api\/buffon\/nasus\/recommend|api\/phantom\/gbdbpdv\/extra|api\/manufacturer\/cross\/shortcut\/list|api\/dunkirk\/liveactivity\/push\/create\/url\/report|api\/growth\/nagato\/app\/index\/gather|api\/zaire_biz\/chat\/resource\/get_list_data)\? script-path=https://raw.githubusercontent.com/Savues/loon-plugin-patches/main/plugins/Pinduoduo-AdBlock/src/stub.response.js, requires-body=true, argument=[{api_stub},{chat_stub},{search_stub},{phantom_stub},{order_stub}], timeout=5, tag=接口拦截与搜索词屏蔽
http-response ^https:\/\/m\.pinduoduo\.net\/mdkd\/package\?from_app_scan script-path=https://raw.githubusercontent.com/Savues/loon-plugin-patches/main/plugins/Pinduoduo-AdBlock/src/PinDuoDuo_remove_ads.js, requires-body=true, tag=移除扫码取件页面商品推荐及弹窗
http-response ^https:\/\/api\.pinduoduo\.com\/api\/alexa\/homepage\/hub\? script-path=https://raw.githubusercontent.com/Savues/loon-plugin-patches/main/plugins/Pinduoduo-AdBlock/src/homepage.response.js, requires-body=true, argument=[{api_stub},{search_stub},{bottom_custom},{Bot_index},{Bot_chat},{Bot_personal},{Bot_live},{Bot_class},{Bot_attendance},{Bot_custom}], timeout=5, tag=首页去广告与底栏自定义
http-response ^https:\/\/m\.pinduoduo\.net\/brand_activity_subsidy\.html\? script-path=https://raw.githubusercontent.com/Savues/loon-plugin-patches/main/plugins/Pinduoduo-AdBlock/src/subsidy.response.js, requires-body=true, argument=[{search_stub}], timeout=5, tag=百亿补贴搜索框去推广词

[MitM]
hostname = api.pinduoduo.com, m.pinduoduo.net, th-a.pinduoduo.com, th.pinduoduo.com, th-b.pinduoduo.com, ta.pinduoduo.com, ta-a.pinduoduo.com, apm.pinduoduo.com, apm-a.pinduoduo.com, abtk.pinduoduo.com, meta.pinduoduo.com, xg.pinduoduo.com, cdl-1.pddpic.com, cdl-p2.pddpic.com, cd-1.pddpic.com, promotion-1.pddpic.com, commimg-1.pddpic.com, static.pddpic.com, static-1.pddpic.com, img-1.pddpic.com, funimg-1.pddpic.com, pinduoduoimg.yangkeduo.com, cdn.pinduoduo.com, pfile-2.pddpic.com

# ─────────────────────────────────────────────
# 基于 PinDuoDuo v1.75 重构，保持原有可用架构
# 关键修复：search_stub 新增 search_suggest 端点
# 所有脚本托管在本仓库，避免第三方依赖
# ─────────────────────────────────────────────